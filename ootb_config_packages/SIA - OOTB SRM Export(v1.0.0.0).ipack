          "$id": "2493",
          "Id": "7a582c30-220f-4279-97a3-4ee3125a840f",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar><ix:SaveEditActionLink Override=\"true\" DisplayMode=\"Create\" Caption=\"Continue\"/><ix:SaveExitActionLink Override=\"true\" visible=\"false\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/><ix:SaveActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/><ix:DeleteActionLink Override=\"true\" Visible=\"false\"/><ix:CancelActionLink Override=\"true\" Visible=\"false\"/><ix:SaveExitActionLink Visible=\"true\"/><ix:CancelActionLink Visible=\"true\"/><ix:SecurityActionLink Override=\"true\" Visible=\"true\" runat=\"server\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Assigned,Review,Archive\" ID=\"StageContainer_Workflow\"><ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\"/></ix:FieldArea><div class=\"wfDiagram\"><div><div stage=\"Draft\">\r\nDraft\r\n</div></div><div><div stage=\"Assigned\">\r\nAssigned\r\n</div></div><div><div stage=\"Review\">\r\nReview\r\n</div></div><div><div stage=\"Archive\">\r\nArchive\r\n</div></div></div></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\"><ix:DetailSection Title=\"Certification Requirement Details\"><ix:FieldArea span=\"true\"><ix:Field DisplayMode=\"View,Edit\" Displayas=\"string\" For=\"Location\" Readonly=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" Displayas=\"string\" For=\"SupplierAbs\"/><ix:Field Caption=\"Certification\" For=\"Certificate\"/><ix:Field For=\"RequirementDesc\"/><ix:Field DisplayMode=\"View,Edit\" For=\"CertNotRequired\"/><ix:Field For=\"PusToFacilities\" Id=\"PusToFacilities_InCreate\" IsMandatory=\"True\"/><ix:Field For=\"SupplierAbs.SupplierType\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_Draft\"><ix:DetailSection Title=\"Certification Requirement Details\"><ix:FieldArea span=\"true\"><ix:Field DisplayMode=\"View,Edit\" Displayas=\"string\" For=\"Location\" Readonly=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" Displayas=\"string\" For=\"SupplierAbs\" Readonly=\"True\"/><ix:Field Caption=\"Certification\" For=\"Certificate\" Readonly=\"True\"/><ix:Field For=\"RequirementDesc\"/><ix:Field For=\"AuditDueDate\"/><ix:Field For=\"AssignedTo\"/><ix:Field For=\"Approver\"/><ix:Field For=\"PusToFacilities\" Id=\"PusToFacilities_InDraft\" IsMandatory=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"CertNotRequired\"/><ix:Field For=\"SupplierAbs.SupplierType\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Assigned\" ID=\"StageContainer_Assigned\"><ix:DetailSection Title=\"Instructions:\"><p>\r\n- Please provide latest audit details for this certification, attach a copy to the Related Certificates Attachment grid, and then click Submit for Review.\r\n</p><p>\r\n-  If this certification is not a requirement for you, please provide a reason in the Notes field of Supplier Remarks section and then click Submit for Cancellation.\r\n</p></ix:DetailSection><ix:DetailSection Title=\"Certification Requirement Details\"><ix:FieldArea Span=\"true\"><ix:Field Displayas=\"string\" For=\"Location\" Readonly=\"True\"/><ix:Field For=\"RecordNo\" Readonly=\"True\"/><ix:Field Caption=\"Supplier Name\" For=\"SupplierAbs\" Readonly=\"True\" displayas=\"string\"/><ix:Field Caption=\"Certification\" For=\"Certificate\" IsMandatory=\"true\" Readonly=\"True\"/><ix:Field For=\"RequirementDesc\" Readonly=\"True\"/><ix:Field For=\"AuditDueDate\" Readonly=\"True\"/><ix:Field For=\"NbOfApprovals\"/><ix:Field For=\"SupplierAbs.SupplierType\"/><ix:Field For=\"Approver\" IsMandatory=\"true\" Readonly=\"true\"/><ix:Field For=\"NbOfAudits\"/><ix:Field Caption=\"Last Audit Date\" For=\"LastAuditHist.AuditDate\" ID=\"AuditDateAssigned\" Readonly=\"true\"/><ix:Field Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\" ID=\"AuditResultAssigned\" Readonly=\"true\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection><ix:GridSection For=\"AuditHistories\" ID=\"AuditHistoriesGridSection_Assigned\" Title=\"Certification Audit History\"><Menu><ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" visible=\"true\"/><ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/></Menu><Sorting><ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/><ix:Sort By=\"AuditDate\" Direction=\"Descending\"/></Sorting><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/><ix:Column For=\"AuditDate\" format=\"d\"/><ix:Column For=\"CertifiedOn\" format=\"d\"/><ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\"><template><div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %>\r\n</div></template></ix:TemplateColumn><ix:Column For=\"Findings\"/><ix:Column For=\"Result\"/></Columns></ix:GridSection><ix:AttachmentSection ID=\"AttachmentFragmentGridSection_assigned\" IsCollapsed=\"true\" Title=\"Related Certificate Attachments\"/><ix:DetailSection Title=\"Supplier Remarks\" ID=\"SupplierRemarks_Assigned\"><ix:FieldArea span=\"true\"><ix:Field Caption=\"Notes\" For=\"SupComments\"/><ix:Field Caption=\"Date of Cancellation Request\" For=\"DateCancelled\" SpellCheck=\"false\"/><ix:Field For=\"SupCommHelper\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Assigned\" DisplayMode=\"Edit,View\"><ix:FieldArea span=\"true\"><ix:Field For=\"AccpCriteriamet\" Readonly=\"true\"/><ix:Field For=\"ApprovalDate\" ID=\"ApprovalDate_Assigned\" Readonly=\"true\"/><ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Assigned\" Readonly=\"true\"/><ix:Field Caption=\"Reviewed By\" DisplayMode=\"Edit,View\" For=\"Approver\" Readonly=\"true\" SpellCheck=\"false\"/><ix:Field Caption=\"Review Comments\" DisplayMode=\"View,Edit\" For=\"Comments\" Readonly=\"true\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Review\" ID=\"StageContainer_Review\"><ix:DetailSection Title=\"Instructions:\"><p>\r\n- If the Supplier has provided more recent audit details and attached the Certification, please review them, then Accept or Reject the renewal.\r\n</p><p>\r\n- If the Supplier has requested to cancel this requirement, please review the explanation in Notes, then Reject or Archive this requirement.\r\n</p></ix:DetailSection><ix:DetailSection Title=\"Certification Requirement Details\"><ix:FieldArea span=\"true\"><ix:Field For=\"Location\" Readonly=\"True\" displayas=\"string\"/><ix:Field For=\"RecordNo\" Readonly=\"True\"/><ix:Field Caption=\"Supplier Name\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\"/><ix:Field Caption=\"Certification\" For=\"Certificate\" Readonly=\"True\"/><ix:Field For=\"RequirementDesc\" Readonly=\"True\"/><ix:Field For=\"CertNotRequired\"/><ix:Field For=\"PusToFacilities\" Id=\"PusToFacilities_InReview\"/><ix:Field Caption=\"Last Audit Date\" For=\"LastAuditHist.AuditDate\" Readonly=\"true\"/><ix:Field Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\" Readonly=\"true\"/><ix:Field For=\"SupplierAbs.SupplierType\"/></ix:FieldArea></ix:DetailSection><ix:GridSection For=\"AuditHistories\" ID=\"AuditHistoriesGridSection_Review\" Title=\"Certification Audit History\"><Menu><ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" visible=\"true\"/><ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/></Menu><Sorting><ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/><ix:Sort By=\"AuditDate\" Direction=\"Descending\"/></Sorting><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/><ix:Column For=\"AuditDate\" format=\"d\"/><ix:Column For=\"CertifiedOn\" format=\"d\"/><ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\"><template><div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %>\r\n</div></template></ix:TemplateColumn><ix:Column For=\"Findings\"/><ix:Column For=\"Result\"/></Columns></ix:GridSection><ix:AttachmentSection ID=\"AttachmentFragmentGridSection_review\" IsCollapsed=\"true\" Title=\"Related Certificate Attachments\"/><ix:DetailSection Title=\"Supplier Remarks\" ID=\"SupplierRemarks_Review\"><ix:FieldArea span=\"true\"><ix:Field Caption=\"Notes\" For=\"SupComments\" Readonly=\"True\"/><ix:Field Caption=\"Date of Cancellation Request\" For=\"DateCancelled\" SpellCheck=\"false\"/><ix:Field For=\"SupCommHelper\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewSection\"><ix:FieldArea Span=\"true\"><ix:Field For=\"AccpCriteriamet\"/><ix:Field For=\"ApprovalDate\" ID=\"ApprovalDate_Review\" SpellCheck=\"false\"/><ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Review\" SpellCheck=\"false\"/><ix:Field Caption=\"Reviewed By\" DisplayMode=\"Edit,View\" For=\"Approver\" IsMandatory=\"true\" SpellCheck=\"false\"/><ix:Field Caption=\"Review Comments\" DisplayMode=\"View,Edit\" For=\"Comments\"/></ix:FieldArea></ix:DetailSection><ix:WorkflowFields/></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Archive\" ID=\"StageContainer_Archive\"><ix:DetailSection Title=\"Certification Requirement Details\"><ix:FieldArea span=\"true\"><ix:Field For=\"Location\" Readonly=\"True\" displayas=\"string\"/><ix:Field For=\"RecordNo\" Readonly=\"True\"/><ix:Field Caption=\"Supplier Name\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\"/><ix:Field Caption=\"Certification\" For=\"Certificate\" Readonly=\"True\"/><ix:Field For=\"RequirementDesc\" Readonly=\"True\"/><ix:Field For=\"CertNotRequired\"/><ix:Field For=\"PusToFacilities\" Id=\"PusToFacilities_InArchive\" Readonly=\"true\"/><ix:Field Caption=\"Last Audit Date\" For=\"LastAuditHist.AuditDate\" Readonly=\"true\"/><ix:Field Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\" Readonly=\"true\"/><ix:Field For=\"SupplierAbs.SupplierType\"/></ix:FieldArea></ix:DetailSection><ix:WorkflowFields/><ix:GridSection For=\"AuditHistories\" ID=\"AuditHistoriesGridSection_Archive\" Title=\"Certification Audit History\"><Menu><ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" visible=\"false\"/><ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/></Menu><Sorting><ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/><ix:Sort By=\"AuditDate\" Direction=\"Descending\"/></Sorting><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/><ix:Column For=\"AuditDate\" format=\"d\"/><ix:Column For=\"CertifiedOn\" format=\"d\"/><ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\"><template><div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %>\r\n</div></template></ix:TemplateColumn><ix:Column For=\"Findings\"/><ix:Column For=\"Result\"/></Columns></ix:GridSection><ix:AttachmentSection ID=\"AttachmentFragmentGridSection_archive\" IsCollapsed=\"true\" Title=\"Related Certificate Attachments\"/><ix:DetailSection Title=\"Supplier Remarks\" ID=\"SupplierRemarks_Archive\"><ix:FieldArea span=\"true\"><ix:Field Caption=\"Notes\" For=\"SupComments\" Readonly=\"True\"/><ix:Field Caption=\"Date of Cancellation Request\" For=\"DateCancelled\" SpellCheck=\"false\"/><ix:Field For=\"SupCommHelper\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:WorkflowTracking IsCollapsed=\"true\" DisplayMode=\"View,Edit\"/><style>\r\n.redDiv {\r\nbackground-color: #FA5555;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: #9FE1CA;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n\r\n.wfDiagram {\r\n                width:100%;\r\n                overflow:auto;\r\n                margin-bottom:10px;\r\n}\r\n\r\n.wfDiagram > div {\r\n                float: left;\r\n                margin-bottom: 5px;\r\n                padding-left: 24px;\r\n                background-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\r\n                background-repeat: no-repeat;\r\n                background-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n                padding-left: 0;\r\n                background-image: none;\r\n}\r\n\r\n.wfDiagram > div > div {\r\n                width: 180px;\r\n                text-align: center;\r\n                padding: 6px 2px;\r\n                font-weight: bold;\r\n                border-radius: 8px;\r\n                border: 2px solid #6CC0FF;\r\n                background-color: #FFFFFF;\r\n                color: #3F3F3F;\r\n}\r\n\r\n\r\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\r\n                border: 2px solid #0070C0;\r\n                background-color: #0070C0;\r\n                color: #FFFFFF;\r\n}\r\n</style></ix:DetailPage>",
