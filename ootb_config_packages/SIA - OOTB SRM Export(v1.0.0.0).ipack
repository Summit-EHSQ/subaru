                "Attachments": null,
                "HtmlMessage": "To: {#PersonResp.Employee}<br /><br />{#CompPP} is no longer listed as a supplier for item {#Item.PartNumber}. No further action is required at this time.<br /><br />Location: {#Location}<br />Item Part No: {#Item.PartNumber}<br />Item Name: {#SupplierItem.Item.CurrentRevision.Name}<br />Revision: {#SupplierItem.Item.CurrentRevision.RevisionNumber}<br />Supplier Part No: {#ParNumberHelper}<br />Supplier Item Revision: {#RevisionNumber}<br />Item Owner: {#SupplierItem.Item.CurrentRevision.Owner}<br /><p>______________________________________________</p><p><a href=\"{#System.Link}/DefaultView/ProductMgmt_SupItemRevisionObject/View/{#ID}\">Please login to view full details of the record.</a> </p><br />",
                "PlainTextMessage": null,
                "Priority": null,
                "ReplayTo": null,
                "SenderName": null,
                "Subject": "Supplier Item Revision {#SupplierItem.SuppPartNumber} {#RevisionNumber} is no longer listed as a supplier for this item {#Item.ItemNumber}.",
