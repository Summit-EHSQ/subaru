LinkTo=\"SupplierMgmt_SupConResponsib_SRM_Detail/View?entityid={#Id}\" Title=\"Responsibilities\">\r\n    <menu>\r\n<ix:GridAttachActionLink Override=\"true\" LinkTo=\"SupplierMgmt_SupConResponsib_Select/Index\" OpenIn=\"popup\"/>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n    </menu>\r\n    <Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"SupplierMgmt_SupConResponsib_SRM_Detail/View?entityid={#Id}\" /><ix:Column For=\"Responsibility\" /><ix:Column For=\"Description\" /></Columns></ix:GridSection>\r\n<ix:AttachmentSection DisplayMode=\"Edit,View\" ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\"/>\r\n</ix:DetailPage>",
