      {
        "$id": "2801",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "f8319d9c-1705-42df-90e0-b702e66a9a72",
        "ObjectName": "SysConfigurableViewProfileEntity",
        "FieldData": {
          "$id": "2802",
          "Id": "f8319d9c-1705-42df-90e0-b702e66a9a72",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage showeditreadonlylink=\"true\">\n  <div class=\"wfDiagram\">\n    <div>\n      <div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"0\") || ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"Draft\") ? \"blue\" : \"\" %>\">\n        <asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/>\n        </div>\n      </div>\n      <div>\n        <div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"CImplementation\") ? \"blue\" : \"\" %>\">\n          <asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Root Cause and Implementation%>\"/>\n          </div>\n        </div>\n        <div>\n          <div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"VerifEffective\") ? \"blue\" : \"\" %>\">\n            <asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Verification of Effectiveness%>\"/>\n            </div>\n          </div>\n          <div>\n            <div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\") ? \"Green\" : \"\" %>\">\n              <asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Closed%>\"/>\n              </div>\n            </div>\n          </div>\n          <ix:DetailPageMenuBar ID=\"DetailPageMenuBar\">\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\n          </ix:DetailPageMenuBar>\n          <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_395f38\">\n            <ix:DetailSection Title=\"SCAR Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note21.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\">\n              <ix:FieldArea Span=\"true\">\n<ix:Field DisplayMode=\"Edit, View\" For=\"RecordNo\" SpellCheck=\"false\"/>\n<ix:Field For=\"Location\" displayas=\"string\"/>\n<ix:Field For=\"IssuDescription\" isMandatory=\"true\"/>\n<ix:Field For=\"Supplier\"/>\n<ix:Field For=\"BusinessImpact\"/>\n<ix:Field For=\"Severity\" displayas=\"string\"/>\n<ix:Field For=\"Occurrence\" displayas=\"string\"/>\n<ix:Field For=\"Detection\" displayas=\"string\"/>\n<ix:Field DisplayMode=\"Edit,View\" For=\"RPN\"/>\n<ix:Field DisplayMode=\"Edit,View\" For=\"Criticality\"/>\n<ix:Field Span=\"true\"/>\n<ix:Field For=\"HelperAssignee\" Caption=\"Assignee\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/>\n<ix:Field For=\"ImplemenDueDate\"/>\n<ix:Field For=\"DateCreate\"/>\n<ix:Field For=\"CreateBy\"/>\n<ix:Field For=\"Workflow.workflowstatus\" visible=\"false\"/>\n<ix:Field For=\"Workflow.CurrentStage.SystemName\" visible=\"false\"/>\n              </ix:FieldArea>\n            </ix:DetailSection>\n            <ix:GridSection DisplayMode=\"Edit,View\" For=\"RelatedEvents\">\n              <Menu>\n<ix:GridAttachActionLink Override=\"true\" visible=\"true\" linkto=\"EventFwk_Event_Select/Index\" OpenIn=\"popup\"/>\n              </Menu>\n              <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column For=\"Location\" displayas=\"string\" /><ix:Column For=\"TypeOfEvent\" /><ix:Column For=\"Description\" /><ix:Column For=\"DateCreated\" /><ix:Column For=\"Workflow.Status\" /></Columns></ix:GridSection>\n          </ix:StageContainer>\n          <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"CImplementation\" ID=\"StageContainer_f5e814\">\n            <ix:DetailSection Title=\"SCAR Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note21.png\" meta:resourcekey=\"DetailSection1\" ResourceKey=\"DetailSection1\">\n              <ix:FieldArea Span=\"true\">\n<ix:Field DisplayMode=\"Edit, View\" For=\"RecordNo\" SpellCheck=\"false\"/>\n<ix:Field For=\"Location\" displayas=\"string\" readonly=\"true\"/>\n<ix:Field For=\"IssuDescription\" editreadonly=\"true\" isMandatory=\"true\" readonly=\"true\"/>\n<ix:Field For=\"Supplier\" readonly=\"true\"/>\n<ix:Field For=\"BusinessImpact\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"Severity\" displayas=\"string\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"Occurrence\" displayas=\"string\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"Detection\" displayas=\"string\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field DisplayMode=\"Edit,View\" For=\"RPN\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"Criticality\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"TotalCoPQ\" readonly=\"true\"/>\n<ix:Field For=\"HelperAssignee\" Caption=\"Assignee\" meta:resourcekey=\"Field1\" ResourceKey=\"Field1\"/>\n<ix:Field For=\"ImplemenDueDate\" editreadonly=\"true\" readonly=\"true\"/>\n<ix:Field For=\"DateCreate\" readonly=\"true\"/>\n<ix:Field For=\"CreateBy\" caption=\"Reported By\" readonly=\"true\"/>\n<ix:Field For=\"CloseAPhelper\" caption=\"Reported By\" editreadonly=\"true\" readonly=\"true\" visible=\"false\"/>\n<ix:Field For=\"Workflow.workflowstatus\" visible=\"false\"/>\n<ix:Field For=\"Workflow.CurrentStage.SystemName\" visible=\"false\"/>\n              </ix:FieldArea>\n            </ix:DetailSection>\n            <ix:GridSection DisplayMode=\"Edit,View\" For=\"TeamMembers\" ID=\"TeamMembersGridSection1\" ModernIcon=\"Raven/Icons/BrightBlue_48/group8.png\" ResourceKey=\"GridSection0\" Title=\"Team Members\" meta:resourcekey=\"GridSection0\">\n              <menu>\n<ix:GridAttachActionLink Override=\"true\" visible=\"true\" linkto=\"ComplyFramework_TeamMember_Select/Index\" OpenIn=\"popup\"/>\n              </menu>\n              <Columns><ix:Column For=\"F