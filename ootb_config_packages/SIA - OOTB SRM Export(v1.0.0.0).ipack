          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"SupplierMgmt_DocRequirement_Inventory\">\r\n    <ix:InventoryView ID=\"SupplierMgmt_DocRequirement_InventoryView\" Caption=\"Documentation Requirement List\" HideGroupAddButton=\"true\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n      </Menu>\r\n      <Grouping>\r\n<ix:Group by=\"SupplierAbs.Name\"/>\r\n      </Grouping>\r\n      <Sorting>\r\n<ix:Sort By=\"ExpirationDate\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\" Width=\"1%\"/>\r\n<ix:Column DisplayAs=\"string\" For=\"Location\"/>\r\n<ix:Column Caption=\"Supplier\" For=\"SupplierAbs.Name\"/>\r\n<ix:Column Caption=\"Document Name\" For=\"Document.Name\"/>\r\n<ix:Column For=\"PriorityOder\"/>\r\n<ix:Column For=\"EffectiveDate\" Format=\"d\"/>\r\n        <ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\">\r\n          <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %>\r\n          </div>\r\n        </template>\r\n      </ix:TemplateColumn>\r\n<ix:Column DisplayAs=\"label\" For=\"Workflow.PersonResponsible\"/>\r\n<ix:Column For=\"Workflow.Status\"/>\r\n<ix:Column For=\"Workflow.WorkflowStatus\"/>\r\n    </Columns>\r\n  </ix:InventoryView>\r\n</ix:Inventory>\r\n</ix:InventoryPage>\r\n<style>\r\n.redDiv {\r\nbackground-color: red;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: black;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: lightgreen;\r\ncolor: black;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n</style>",
