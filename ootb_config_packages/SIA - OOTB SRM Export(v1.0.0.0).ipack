yas=\"string\"/><ix:Column For=\"Description\" displayas=\"string\"/><ix:Column For=\"DateCreated\" displayas=\"string\"/><ix:Column For=\"Workflow.Status\" displayas=\"string\"/></Columns></ix:GridSection></ix:StageContainer><ix:TabsSection Title=\"Private Document Attachment\" modernIcon=\"Raven/Icons/BrightBlue_24/DefaultAttachmentIcon_BrightBlue2_24.png\" DisplayMode=\"View,Edit,Create\" meta:resourcekey=\"TabsSection1\" ResourceKey=\"TabsSection1\"><ix:Tab Caption=\"Image Preview\" DisplayMode=\"View,Edit\" meta:resourcekey=\"Tab4\" ResourceKey=\"Tab4\"><ix:GridPanel Entity=\"DocDocumentAttachmentsEntity\" ShowColumnCaptions=\"false\" AllowPaging=\"false\" AllowFiltering=\"false\" AllowSorting=\"false\" RowSelectionMode=\"None\" Readonly=\"True\" DisplayEditColumn=\"false\" CssClass=\"HideBorders\"><Filters><ix:Filter><ix:CommonPredicate For=\"ObjectRecordId\" Type=\"Equal\"><ix:Value Parse=\"True\"><%= Model.Id %></ix:Value></ix:CommonPredicate></ix:Filter><ix:Filter PredicateOperator=\"or\"><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>.png</ix:Value></ix:LikePredicate><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>.jpg</ix:Value></ix:LikePredicate><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>.gif</ix:Value></ix:LikePredicate></ix:Filter></Filters><aliases><ix:Alias For=\"Id\"/><ix:Alias For=\"AttachmentName\"/></aliases><columns><ix:TemplateColumn><template><div class=\"imagepreview\" title=\"<%# Container.ViewData.Eval(\"AttachmentName\") %>\" style=\"background-image:url('<%= HttpEnvironment.SystemApplicationPath %>/intelexforms/attachmentsection/downloadfile?recordid=<%# Container.ViewData.Eval(\"Id\") %>')\"/></template></ix:TemplateColumn></columns></ix:GridPanel></ix:Tab><ix:Tab Caption=\"Upload\" meta:resourcekey=\"Tab5\" ResourceKey=\"Tab5\"><ix:AttachmentSection CssClass=\"HideBorders\" ID=\"AttachmentFragmentGridSection1\" Title=\"Upload images\" meta:resourcekey=\"AttachmentSection0\" ResourceKey=\"AttachmentSection0\"/></ix:Tab></ix:TabsSection></ix:DetailPage><style>.wfDiagram {\r\n\twidth:100%;\r\n\ttext-align:center;\r\n}\r\n\r\n.wfDiagram > div {\r\n\tdisplay: inline-block;\r\n\tmargin-bottom: 5px;\r\n\tpadding-left: 24px;\r\n\tbackground-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\r\n\tbackground-repeat: no-repeat;\r\n\tbackground-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n\tpadding-left: 0;\r\n\tbackground-image: none;\r\n\tposition: relative;\r\n        top: 25%;\r\n         transform: translateY(-25%);\r\n}\r\n.wfDiagram > div:last-child {\r\n\t\tmargin-bottom: 5px;\r\n\tpadding-left: 24px;\r\n\tbackground-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\r\n\tposition: relative;\r\n        top: 25%;\r\n         transform: translateY(-25%);\r\n         \tbackground-repeat: no-repeat;\r\n\tbackground-position: left center;\r\n\r\n}\r\n\r\n\r\n.wfDiagram > div > div {\r\n\twidth: 180px;\r\n\ttext-align: center;\r\n\tpadding: 6px 2px;\r\n\tfont-weight: bold;\r\n\tborder-radius: 8px;\r\n\tborder: 2px solid #6CC0FF;\r\n\tbackground-color: #FFFFFF;\r\n\tcolor: #3F3F3F;\r\n}\r\n\r\n.wfDiagram > div > div[selected='blue'] {\r\n\tborder: 2px solid #0070C0;\r\n\tbackground-color: #0070C0;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n.wfDiagram > div > div[selected='red'] {\r\n\tborder: 2px solid red;\r\n\tbackground-color: red;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n.wfDiagram > div > div[selected='green'] {\r\n\tborder: 2px solid green;\r\n\tbackground-color: green;\r\n\tcolor: #FFFFFF;\r\n}</style>",
