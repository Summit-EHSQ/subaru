          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar1\">\r\n<ix:EditActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:EditReadOnlyActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:HardDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:SaveExitActionLink Visible=\"true\" Override=\"true\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:DetailSection Title=\"Contact Details\" ID=\"Create\" DisplayMode=\"Create\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"AllowAccess\" IsMandatory=\"true\"/>\r\n<ix:Field For=\"Employee\" Span=\"true\"/>\r\n<ix:Field For=\"Number\" Span=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"FirstName\"/>\r\n<ix:Field For=\"MiddleName\"/>\r\n<ix:Field For=\"LastName\" Span=\"true\"/>\r\n<ix:Field For=\"Position\"/>\r\n<ix:Field For=\"Email\" Span=\"true\"/>\r\n<ix:Field For=\"Phone\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:DetailSection Title=\"Contact Details\" ID=\"ViewEdit\" DisplayMode=\"view,edit\">\r\n    <ix:FieldArea>\r\n<ix:Field For=\"RecordNo\" Span=\"true\"/>\r\n<ix:Field For=\"AllowAccess\" IsMandatory=\"true\"/>\r\n<ix:Field For=\"Employee\" Span=\"true\"/>\r\n<ix:Field For=\"Number\" ID=\"EditNumber\" Span=\"true\"/>\r\n<ix:Field For=\"FirstName\" ID=\"EditFirstName\"/>\r\n<ix:Field For=\"MiddleName\" ID=\"EditMiddleName\"/>\r\n<ix:Field For=\"LastName\" ID=\"EditLastName\" Span=\"true\"/>\r\n<ix:Field For=\"Email\" ID=\"EditEmail\" Span=\"true\"/>\r\n<ix:Field For=\"Phone\" ID=\"EditPhone\"/>\r\n<ix:Field For=\"Position\" ID=\"EditPosition\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayMode=\"view,edit\" EditLinkTarget=\"popup\" For=\"ResponsibleFor\" ID=\"ResponsibleForGridSection\">\r\n    <menu>\r\n<ix:GridAttachActionLink Override=\"true\" LinkTo=\"SupplierMgmt_SupConResponsib_Select/Index\" OpenIn=\"popup\"/>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n    </menu>\r\n    <Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\" /><ix:Column For=\"Responsibility\" /><ix:Column For=\"Description\" /></Columns></ix:GridSection><ix:GridSection DisplayMode=\"view,edit\" EditLinkTarget=\"popup\" For=\"Suppliers\" Id=\"Suppliers\" Title=\"Suppliers\">\r\n    <menu>\r\n<ix:GridAttachActionLink Override=\"true\" LinkTo=\"SupplierMgmt_SupAbstract_Select/Index\" OpenIn=\"popup\"/>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n    </menu>\r\n    <Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\" /><ix:Column For=\"Name\" /><ix:Column FilterAs=\"dropdown\" For=\"SupplierStatus\" /><ix:Column DisplayAs=\"string\" For=\"Workflow.PersonResponsible\" /><ix:Column For=\"Workflow.Status\" /></Columns></ix:GridSection></ix:DetailPage>",
