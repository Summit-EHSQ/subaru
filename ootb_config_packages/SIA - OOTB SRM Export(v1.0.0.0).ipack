      {
        "$id": "2197",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "6186255f-99e0-4096-a416-05f61bff26f8",
        "ObjectName": "MetObjectActionEntity",
        "FieldData": {
          "$id": "2198",
          "Id": "6186255f-99e0-4096-a416-05f61bff26f8",
          "ActionType": 1,
          "Description": "If a Supplier Item Revision is created from an Approval it uses some helper fields and creates the supplier item",
          "Flow": "[{\"__type\":\"if\",\"name\":null,\"condition\":\"FETCHVALUE(\\\"ProductMgmt_SupplierItemObject\\\",\\\"ID\\\",\\\"ID Descending\\\", \\\"CompPPID\\\",\\\"=\\\",CompPPID,\\\"ItemID\\\",\\\"=\\\",ItemID)<>NULL\",\"else\":[],\"then\":[{\"__type\":\"if\",\"name\":null,\"condition\":\"SupplierItem=NULL\",\"else\":[],\"then\":[{\"__type\":\"setvalue\",\"name\":null,\"field\":\"SupplierItem\",\"value\":\"GETRELATED(\\\"ProductMgmt_SupplierItemObject\\\",\\\"CompPP\\\",CompPP,\\\"Item\\\",Item)\"}]},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"RevisionNumber\",\"value\":\"IF(SupplierItem.SuppCurrentRev = NULL, 0, MAX(SupplierItem.SuppCurrentRev.RevisionNumber) +1)\"},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"ParNumberHelper\",\"value\":\"SupplierItem.SuppPartNumber\"},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"DisplayField\",\"value\":\"CONCATENATE(ParNumberHelper, \\\" v.\\\", RevisionNumber)\"}]},{\"__type\":\"if\",\"name\":null,\"condition\":\"SupplierItem<>NULL\",\"else\":[],\"then\":[{\"__type\":\"if\",\"name\":null,\"condition\":\"AND(ItemRevisions<>NULL, SupplierItem.SupItemStatus.Name=\\\"OBS\\\")  \",\"else\":[],\"then\":[{\"__type\":\"error\",\"name\":null,\"message\":\"{#SupplierItem.CompPP}, ID: {#SupplierItem.CompPP.SupplierAbs.SupplierID} supplier's item is currently Obsolete. Please request the Supplier to re-activate it before provisioning.\"}]},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"ItemRevisionsId\",\"value\":\"SupplierItem.Item.CurrentRevisionId\"},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"PublicProfiles\",\"value\":\"SupplierItem.SuppCurrentRev.PublicProfiles\"},{\"__type\":\"if\",\"name\":null,\"condition\":\"PersonResp<>NULL\",\"else\":[{\"__type\":\"setvalue\",\"name\":null,\"field\":\"StartWorkflow\",\"value\":\"FALSE\"}],\"then\":[{\"__type\":\"setvalue\",\"name\":null,\"field\":\"StartWorkflow\",\"value\":\"TRUE\"}]}]}]",
          "IsEnabled": true,
          "Name": "Revision 1 and Later"
        },
        "LocalizationData": null,
        "Id": "6da50f0c-c176-4e09-b18a-974a949fc405",
        "Caption": "Revision 1 and Later",
        "Type": "Object Action Handler",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
