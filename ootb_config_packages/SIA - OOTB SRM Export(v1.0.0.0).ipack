lSection12\" ResourceKey=\"DetailSection12\"><ix:FieldArea span=\"true\"><ix:Field Caption=\"Notes\" For=\"SupComments\" Readonly=\"True\" meta:resourcekey=\"Field24\" ResourceKey=\"Field24\"/><ix:Field Caption=\"Date of Cancellation Request\" For=\"DateCancelled\" SpellCheck=\"false\" meta:resourcekey=\"Field25\" ResourceKey=\"Field25\"/><ix:Field For=\"SupCommHelper\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:WorkflowTracking IsCollapsed=\"true\" DisplayMode=\"View,Edit\"/><style>.redDiv {\r\nbackground-color: #FA5555;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: #9FE1CA;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n\r\n.wfDiagram {\r\n                width:100%;\r\n                overflow:auto;\r\n                margin-bottom:10px;\r\n}\r\n\r\n.wfDiagram > div {\r\n                float: left;\r\n                margin-bottom: 5px;\r\n                padding-left: 24px;\r\n                background-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\r\n                background-repeat: no-repeat;\r\n                background-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n                padding-left: 0;\r\n                background-image: none;\r\n}\r\n\r\n.wfDiagram > div > div {\r\n                width: 180px;\r\n                text-align: center;\r\n                padding: 6px 2px;\r\n                font-weight: bold;\r\n                border-radius: 8px;\r\n                border: 2px solid #6CC0FF;\r\n                background-color: #FFFFFF;\r\n                color: #3F3F3F;\r\n}\r\n\r\n\r\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\r\n                border: 2px solid #0070C0;\r\n                background-color: #0070C0;\r\n                color: #FFFFFF;\r\n}</style></ix:DetailPage>",
