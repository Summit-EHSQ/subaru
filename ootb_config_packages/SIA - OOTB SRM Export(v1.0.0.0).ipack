rightBlue2_24.png\" DisplayMode=\"View,Edit,Create\" meta:resourcekey=\"TabsSection1\" ResourceKey=\"TabsSection1\">\n            <ix:Tab Caption=\"Image Preview\" DisplayMode=\"View,Edit\" meta:resourcekey=\"Tab4\" ResourceKey=\"Tab4\">\n              <ix:GridPanel Entity=\"DocDocumentAttachmentsEntity\" ShowColumnCaptions=\"false\" AllowPaging=\"false\" AllowFiltering=\"false\" AllowSorting=\"false\" RowSelectionMode=\"None\" Readonly=\"True\" DisplayEditColumn=\"false\" CssClass=\"HideBorders\">\n                <Filters>\n                  <ix:Filter>\n                    <ix:CommonPredicate For=\"ObjectRecordId\" Type=\"Equal\">\n                      <ix:Value Parse=\"True\">\n<%= Model.Id %>\n                      </ix:Value>\n                    </ix:CommonPredicate>\n                  </ix:Filter>\n                  <ix:Filter PredicateOperator=\"or\">\n                    <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\n                      <ix:Value>\n.png\n                      </ix:Value>\n                    </ix:LikePredicate>\n                    <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\n                      <ix:Value>\n.jpg\n                      </ix:Value>\n                    </ix:LikePredicate>\n                    <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\n                      <ix:Value>\n.gif\n                      </ix:Value>\n                    </ix:LikePredicate>\n                  </ix:Filter>\n                </Filters>\n                <aliases>\n<ix:Alias For=\"Id\"/>\n<ix:Alias For=\"AttachmentName\"/>\n                </aliases>\n                <columns>\n                  <ix:TemplateColumn>\n                    <template>\n                      <div class=\"imagepreview\" title=\"<%# Container.ViewData.Eval(\"AttachmentName\") %>\" style=\"background-image:url(&apos;<%= HttpEnvironment.SystemApplicationPath %>/intelexforms/attachmentsection/downloadfile?recordid=<%# Container.ViewData.Eval(\"Id\") %>&apos;)\"/>\n                      </template>\n                    </ix:TemplateColumn>\n                  </columns>\n                </ix:GridPanel>\n              </ix:Tab>\n              <ix:Tab Caption=\"Upload\" meta:resourcekey=\"Tab5\" ResourceKey=\"Tab5\">\n<ix:AttachmentSection CssClass=\"HideBorders\" ID=\"AttachmentFragmentGridSection1\" Title=\"Upload images\" meta:resourcekey=\"AttachmentSection0\" ResourceKey=\"AttachmentSection0\"/>\n              </ix:Tab>\n            </ix:TabsSection>\n          </ix:DetailPage>\n          <style>\n.wfDiagram {\n\twidth:100%;\n\ttext-align:center;\n}\n\n.wfDiagram > div {\n\tdisplay: inline-block;\n\tmargin-bottom: 5px;\n\tpadding-left: 24px;\n\tbackground-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\n\tbackground-repeat: no-repeat;\n\tbackground-position: left center;\n}\n\n.wfDiagram > div:first-child {\n\tpadding-left: 0;\n\tbackground-image: none;\n\tposition: relative;\n        top: 25%;\n         transform: translateY(-25%);\n}\n.wfDiagram > div:last-child {\n\t\tmargin-bottom: 5px;\n\tpadding-left: 24px;\n\tbackground-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\n\tposition: relative;\n        top: 25%;\n         transform: translateY(-25%);\n         \tbackground-repeat: no-repeat;\n\tbackground-position: left center;\n\n}\n\n\n.wfDiagram > div > div {\n\twidth: 180px;\n\ttext-align: center;\n\tpadding: 6px 2px;\n\tfont-weight: bold;\n\tborder-radius: 8px;\n\tborder: 2px solid #6CC0FF;\n\tbackground-color: #FFFFFF;\n\tcolor: #3F3F3F;\n}\n\n.wfDiagram > div > div[selected='blue'] {\n\tborder: 2px solid #0070C0;\n\tbackground-color: #0070C0;\n\tcolor: #FFFFFF;\n}\n\n.wfDiagram > div > div[selected='red'] {\n\tborder: 2px solid red;\n\tbackground-color: red;\n\tcolor: #FFFFFF;\n}\n\n.wfDiagram > div > div[selected='green'] {\n\tborder: 2px solid green;\n\tbackground-color: green;\n\tcolor: #FFFFFF;\n}\n