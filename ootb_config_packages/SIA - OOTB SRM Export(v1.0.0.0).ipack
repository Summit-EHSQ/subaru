      {
        "$id": "1905",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "096cd2b4-e8f8-42aa-9c34-7b24d52fbea9",
        "ObjectName": "MetObjectActionEntity",
        "FieldData": {
          "$id": "1906",
          "Id": "096cd2b4-e8f8-42aa-9c34-7b24d52fbea9",
          "ActionType": 3,
          "Description": "It will set a value \"Name\", \"Description\" and \"Person Responsible\"  fields from the Current revision of supplier Item if \"Revision Type\" is \"Obsolete Item\".\r\n(For ex : User select and then they will fill details in those field and they select \"Obsolete Item\")",
          "Flow": "[{\"__type\":\"if\",\"name\":null,\"condition\":\"RevTypeReport.Name = \\\"Obsolete Item\\\"\",\"else\":[],\"then\":[{\"__type\":\"setvalue\",\"name\":null,\"field\":\"Name\",\"value\":\"SupplierItem.SuppCurrentRev.Name\"},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"Description\",\"value\":\"SupplierItem.SuppCurrentRev.Description\"},{\"__type\":\"setvalue\",\"name\":null,\"field\":\"PersonResp\",\"value\":\"SupplierItem.SuppCurrentRev.PersonResp\"}]}]",
          "IsEnabled": true,
          "Name": "Reset values if Revision Type is Obsolete"
        },
        "LocalizationData": null,
        "Id": "d82d7d6a-a407-4c2a-9588-627b9102ecf3",
        "Caption": "Reset values if Revision Type is Obsolete",
        "Type": "Object Action Handler",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
