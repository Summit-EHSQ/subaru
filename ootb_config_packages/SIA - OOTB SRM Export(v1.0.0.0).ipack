          "Content": "<% ViewData[\"Workflow.RecurringSeries.StartDate\"] =  DateTime.Today; %>\n<ix:DetailPage ShowEditReadOnlyLink=\"True\" WorkFlowStatusIsVisible=\"false\"><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\"><ix:DetailSection Title=\"Supplier Parent Company Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" DisplayMode=\"view,edit\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field For=\"RecordNo\" DisplayMode=\"view,edit\" ReadOnly=\"true\"/><ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\"/><ix:Field Caption=\"Parent Company Name\" For=\"Name\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field Caption=\"D&amp;B Number\" For=\"DnBNumber\" SpellCheck=\"false\"/><ix:Field Caption=\"Relationship Start Date\" For=\"RelatStartDate\" SpellCheck=\"false\"/><ix:Field For=\"SupplierStatus\"/><ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" SpellCheck=\"false\" DisplayAs=\"string\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field For=\"Geography\" SpellCheck=\"false\" IsMandatory=\"True\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel><ix:FieldArea Span=\"true\"><ix:Field For=\"Workflow.RecurringSeries.StartDate\" Caption=\"Evaluation Scheduled Date\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval\" ID=\"StageContainer_Approval\"><ix:DetailSection Title=\"Supplier Parent Company Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field For=\"RecordNo\" ReadOnly=\"true\"/><ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\"/><ix:Field Caption=\"Parent Company Name\" For=\"Name\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field Caption=\"D&amp;B Number\" For=\"DnBNumber\" SpellCheck=\"false\"/><ix:Field Caption=\"Relationship Start Date\" For=\"RelatStartDate\" SpellCheck=\"false\"/><ix:Field For=\"SupplierStatus\"/><ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field For=\"NoOfEvaluations\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field For=\"Geography\" SpellCheck=\"false\" IsMandatory=\"True\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel><ix:Panel Title=\"Supplier Review Details\" DisplayMode=\"View,Edit\" ID=\"SupplierReviewPanel\"><ix:FieldArea Span=\"true\"><ix:Field For=\"LastEvaluation.EvaluationDate\" Caption=\"Last Evaluation Date\" ReadOnly=\"true\"/><ix:Field For=\"LastEvaluation.Rating\" Caption=\"Last Evaluation Rating\" ReadOnly=\"true\"/><ix:Field Caption=\"Notes\" For=\"Notes\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel></ix:DetailSection><ix:GridSection For=\"Facilities\" ID=\"FacilitiesGridSection\" Title=\"Supplier Facilities\" EditLinkTarget=\"popup\"><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/><ix:Column For=\"Location\" DisplayAs=\"string\"/><ix:Column For=\"Name\" Caption=\"Supplier Facility\" DisplayAs=\"string\"/><ix:Column For=\"FacilityType\" FilterAs=\"dropdown\"/><ix:Column For=\"SupplierStatus\" FilterAs=\"dropdown\"/></Columns></ix:GridSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_Closed\"><ix:DetailSection Title=\"Supplier Parent Company Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" DisplayAs=\"string\" ReadOnly=\"true\"/><ix:Field For=\"RecordNo\" ReadOnly=\"true\"/><ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\" ReadOnly=\"true\"/><ix:Field Caption=\"Parent Company Name\" For=\"Name\" SpellCheck=\"false\" DisplayAs=\"string\" ReadOnly=\"true\"/><ix:Field Caption=\"D&amp;B Number\" For=\"DnBNumber\" SpellCheck=\"false\" ReadOnly=\"true\"/><ix:Field Caption=\"Relationship Start Date\" For=\"RelatStartDate\" SpellCheck=\"false\" ReadOnly=\"true\"/><ix:Field For=\"SupplierStatus\" ReadOnly=\"true\"/><ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" SpellCheck=\"false\" DisplayAs=\"string\" ReadOnly=\"true\"/><ix:Field For=\"NoOfEvaluations\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\" ReadOnly=\"true\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field Caption=\"Province/State\" For=\"Geography\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"fals