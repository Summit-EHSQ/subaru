      {
        "$id": "3009",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "d6a78b28-91e3-43f4-ad85-e8eb15309bbf",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "3010",
          "Walkthroughs": null,
          "Profiles": null,
          "Id": "d6a78b28-91e3-43f4-ad85-e8eb15309bbf",
          "Caption": null,
          "ConfigurableViewActions": "[{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Hide Country field when geography is empty\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['City'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return Intelex.DetailPage.getField('Geography').value.eq('');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['Geography.ParentGeography']\\u000a                }],\\u000a                falseDecision: []\\u000a        }]\\u000a}\"},{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Hide Supplier Review Panel when number of Evaluation is zero\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['NoOfEvaluations'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return Intelex.DetailPage.getField('NoOfEvaluations').value.eq('0');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['NoOfEvaluations', 'SupplierReviewPanel', 'SupplierReviewPanel_Closed']\\u000a                }],\\u000a                falseDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['NoOfEvaluations']\\u000a                }, {\\u000a                        __type: 'show',\\u000a                        elements: ['SupplierReviewPanel', 'SupplierReviewPanel_Closed']\\u000a                }]\\u000a        }]\\u000a}\"},{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Hide WF StartDate\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['Workflow.RecurringSeries.StartDate'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return !Intelex.DetailPage.getField('Workflow.RecurringSeries.StartDate').value.eq('');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['Workflow.RecurringSeries.StartDate']\\u000a                }],\\u000a                falseDecision: []\\u000a        }]\\u000a}\"}]",
          "Content": "<% ViewData[\"Workflow.RecurringSeries.StartDate\"] =  DateTime.Today; %>\n<ix:DetailPage WorkFlowStatusIsVisible=\"false\"><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\"><ix:DetailSection Title=\"Supplier Facility Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" displayMode=\"view,edit\" displayas=\"string\" readonly=\"true\"/><ix:Field For=\"RecordNo\" displayMode=\"view,edit\" readonly=\"true\"/><ix:Field Caption=\"Supplier Parent Company\" For=\"ParentCompany\" Readonly=\"true\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field Caption=\"Facility ID\" For=\"SupplierID\" DisplayAs=\"string\"/><ix:Field Caption=\"Facility Name\" For=\"Name\"/><ix:Field For=\"FacilityType\"/><ix:Field For=\"SupplierStatus\"/><ix:Field For=\"SupCategory\" DisplayAs=\"string\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field Caption=\"Province/State\" For=\"Geography\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Evaluation Schedule Date\" For=\"Workflow.RecurringSeries.StartDate\" SpellCheck=\"false\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval\" ID=\"StageContainer_Approval\"><ix:DetailSection Title=\"Supplier Facility Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" displayas=\"string\" readonly=\"true\"/><ix:Field For=\"RecordNo\" readonly=\"true\"/><ix:Field Caption=\"Supplier Parent Company\" For=\"ParentCompany\" Readonly=\"true\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field Caption=\"Facility ID\" For=\"SupplierID\" DisplayAs=\"string\"/><ix:Field Caption=\"Facility Name\" For=\"Name\"/><ix:Field For=\"FacilityType\"/><ix:Field For=\"SupplierStatus\"/><ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" DisplayAs=\"string\"/><ix:Field For=\"NoOfEvaluations\"/><ix:Field For=\"CertReqHelper\" visible=\"false\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field Caption=\"Province/State\" For=\"Geography\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel><ix:Panel Title=\"Supplier Review Details\" DisplayMode=\"View,Edit\" ID=\"SupplierReviewPanel\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Last Evaluation Date\" For=\"LastEvaluation.EvaluationDate\" Readonly=\"true\"/><ix:Field Caption=\"Last Evaluation Rating\" For=\"LastEvaluation.Rating\" Readonly=\"true\"/><ix:Field Caption=\"Notes\" For=\"Notes\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_Closed\"><ix:DetailSection Title=\"Supplier Facility Details\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Location\" DisplayAs=\"string\" readonly=\"true\"/><ix:Field For=\"RecordNo\" ReadOnly=\"true\"/><ix:Field Caption=\"Supplier Parent Company\" For=\"ParentCompany\" Readonly=\"true\" SpellCheck=\"false\" DisplayAs=\"string\"/><ix:Field Caption=\"Facility ID\" For=\"SupplierID\" DisplayAs=\"string\" Readonly=\"true\"/><ix:Field Caption=\"Facility Name\" For=\"Name\" Readonly=\"true\"/><ix:Field For=\"FacilityType\" Readonly=\"true\"/><ix:Field For=\"SupplierStatus\" Readonly=\"true\"/><ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" DisplayAs=\"string\" Readonly=\"true\"/><ix:Field For=\"NoOfEvaluations\"/><ix:Field For=\"CertReqHelper\" visible=\"false\"/></ix:FieldArea><ix:Panel Title=\"Address &amp; Contact Details\" Readonly=\"true\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/><ix:Field Caption=\"Province/State\" For=\"Geography\" DisplayAs=\"string\"/><ix:Field For=\"City\"/><ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/><ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/><ix:Field Caption=\"Company Website\" For=\"Website\"/><ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/><ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel><ix:Panel Title=\"Supplier Review Details\" ID=\"SupplierReviewPanel_Closed\" Readonly=\"true\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Last Evaluation Date\" For=\"LastEvaluation.EvaluationDate\" Readonly=\"true\"/><ix:Field Caption=\"Last Evaluation Rating\" For=\"LastEvaluation.Rating\" Readonly=\"true\"/><ix:Field Caption=\"Notes\" For=\"Notes\" SpellCheck=\"false\"/></ix:FieldArea></ix:Panel></ix:DetailSection></ix:StageContainer><ix:AttachmentSection DisplayMode=\"Edit,View\" ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\"/><ix:WorkflowFields visible=\"false\"/><style>\n.redDiv {\nbackground-color: red;\ncolor: white;\npadding: 2px;\nborder-radius: 