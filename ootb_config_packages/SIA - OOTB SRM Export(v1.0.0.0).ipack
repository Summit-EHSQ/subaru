        "RecordId": "dca473f5-630c-4a41-be1a-0f8d56acb081",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "2820",
          "Profiles": null,
          "Walkthroughs": null,
          "Id": "dca473f5-630c-4a41-be1a-0f8d56acb081",
          "Caption": null,
          "ConfigurableViewActions": null,
          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"SupplierMgmt_CertRequirementObjectInventory\">\r\n    <ix:InventoryView ID=\"SupplierMgmt_CertRequirementObjectInventoryView\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n      </Menu>\r\n      <Sorting>\r\n<ix:Sort By=\"AuditDueDate\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" Width=\"2%\" /><ix:Column DisplayAs=\"string\" For=\"Location\" /><ix:Column Caption=\"Supplier\" For=\"SupplierAbs.Name\" /><ix:Column Caption=\"Certification Name\" For=\"Certificate.Name\" /><ix:Column Caption=\"Last Certified On\" For=\"LastAuditHist.CertifiedOn\" format=\"d\" /><ix:Column Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\" />\r\n        <ix:TemplateColumn Caption=\"Expiration Date\" For=\"LastAuditHist.ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\">\r\n          <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"orangeDiv\" : (DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\")) %>\r\n          </div>\r\n        </template>\r\n      </ix:TemplateColumn>\r\n<ix:Column DisplayAs=\"Label\" For=\"Workflow.PersonResponsible\" /><ix:Column For=\"Workflow.Status\" /></Columns>\r\n  </ix:InventoryView>\r\n</ix:Inventory>\r\n</ix:InventoryPage>\r\n<style>\r\n.redDiv {\r\nbackground-color: red;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: black;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: lightgreen;\r\ncolor: black;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n</style>",
          "HasFilter": false,
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "SupplierMgmt_CertRequirement_Select",
          "Path": "SupplierMgmt_CertRequirement_Select",
