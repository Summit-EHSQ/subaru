          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\">\r\n  <ix:DetailPageMenuBar ID=\"DetailPageMenuBar\">\r\n<ix:SaveEditActionLink Override=\"false\" DisplayMode=\"Create\" Caption=\"Continue\" Visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" DisplayMode=\"Create,Edit\"/>\r\n<ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/>\r\n<ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Creation,Draft\" ReadOnlyFor=\"Draft\" Id=\"RevisionDetails_StageContainer\">\r\n    <ix:DetailSection Title=\"Revision Details\" Id=\"RevisionDetails_DetailSection\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field Caption=\"Revision Type\" For=\"RevTypeObs\"/>\r\n<ix:Field Caption=\"Revision Type\" For=\"RevTypeReAct\"/>\r\n<ix:Field For=\"ReasonForRev\"/>\r\n<ix:Field For=\"SupplierItem.SupItemStatus\"/>\r\n<ix:Field Caption=\"Leave this field as it is necessary to be on view for shipping location\" For=\"CompPP.SupplierAbs.Id\" Visible=\"false\"/>\r\n<ix:Field Caption=\"Leave this field as it is necessary to be on view\" For=\"Cancelled\" Visible=\"false\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Creation,Draft\" Id=\"Create\">\r\n    <ix:DetailSection Title=\"Supplier Item Properties\">\r\n      <ix:FieldArea Id=\"SupplierItemProperties_Create_Draft\" Span=\"true\">\r\n<ix:Field For=\"StartWorkflow\"/>\r\n<ix:Field DisplayAs=\"String\" For=\"Locati