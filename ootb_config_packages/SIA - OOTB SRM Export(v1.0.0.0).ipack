        "RecordId": "a7e23152-6973-4e7b-9713-e4ab137a7c34",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "2800",
          "Walkthroughs": null,
          "Id": "a7e23152-6973-4e7b-9713-e4ab137a7c34",
          "Caption": null,
          "ConfigurableViewActions": "[{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Occurance\\/Detection\\/severity all mandatory if one is non empty\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['Severity', 'Occurrence', 'Detection'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return !Intelex.DetailPage.getField('Detection').value.eq('') || !Intelex.DetailPage.getField('Occurrence').value.eq('') || !Intelex.DetailPage.getField('Severity').value.eq('');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'setMandatory',\\u000a                        elements: ['Severity', 'Occurrence', 'Detection']\\u000a                }],\\u000a                falseDecision: [{\\u000a                        __type: 'setNonMandatory',\\u000a                        elements: ['Severity', 'Occurrence', 'Detection']\\u000a                }]\\u000a        }]\\u000a}\"}]",
          "Content": "<ix:DetailPage showeditreadonlylink=\"true\"><div class=\"wfDiagram\"><div><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"0\") || ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"Draft\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"CImplementation\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Root Cause and Implementation%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"VerifEffective\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Verification of Effectiveness%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\") ? \"Green\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Closed%>\"/></div></div></div><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:SecurityActionLink Override=\"true\" Visible=\"false\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_395f38\"><ix:DetailSection Title=\"SCAR Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note21.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"true\"><ix:Field DisplayMode=\"Edit, View\" For=\"RecordNo\" SpellCheck=\"false\"/><ix:Field For=\"Location\" displayas=\"string\"/><ix:Field For=\"IssuDescription\" isMandatory=\"true\"/>