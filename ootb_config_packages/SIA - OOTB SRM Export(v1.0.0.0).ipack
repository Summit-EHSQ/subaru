          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar1\">\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:EditActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" Visible=\"true\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:DetailSection Title=\"Supplier Details\">\r\n    <ix:FieldArea>\r\n<ix:Field DisplayAs=\"string\" DisplayMode=\"View,Edit\" For=\"SupplierAbs.Location\"/>\r\n<ix:Field For=\"SupplierAbs.RecordNo\" Span=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Supplier Name\" For=\"SupplierAbs.Name\" Span=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"LastEvalHelper\" visible=\"false\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:DetailSection Title=\"Supplier Evaluation Details\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field DisplayMode=\"View, Edit\" For=\"RecordNo\"/>\r\n<ix:Field For=\"EvaluationDate\"/>\r\n<ix:Field For=\"EvaluatedBy\"/>\r\n<ix:Field For=\"EvalDescription\"/>\r\n<ix:Field For=\"Rating\"/>\r\n<ix:Field For=\"Comments\"/>\r\n    </ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n  </ix:DetailSection>\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" DisplayMode=\"View, Edit\" IsCollapsed=\"true\"/>\r\n</ix:DetailPage>",
