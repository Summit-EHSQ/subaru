                "Id": "d4cfcab8-0b6f-42d8-967a-1d3132fd321d",
                "Attachments": null,
                "HtmlMessage": "To: {#ItemRevisions.Owner}<br /><br />{#PersonResp.Employee} from {#CompPP} has decided not to supply the item for the release of item {#Item.PartNumber}.  Please review the supplier’s comments and take appropriate action.  <br /><br />Location: {#Location}<br />Item Part No: {#Item.PartNumber}<br />Item Name: {#ItemRevisions.Name}<br />Revision: {#ItemRevisions.RevisionNumber}<br />Supplier Part No: {#ParNumberHelper}<br />Supplier Item Revision: {#RevisionNumber}<br />Item Owner: {#ItemRevisions.Owner}<br /><p>________________________________________</p><p><span style=\"font-family:Arial, Helvetica, sans-serif;font-size:small;\"></span><span style=\"font-family:Arial, Helvetica, sans-serif;font-size:small;\"><span style=\"font-family:Arial, Helvetica, sans-serif;\"><span style=\"font-size:small;\"><a href=\"{#System.Link}/DefaultView/ProductMgmt_SupItemRevisionObject/View/{#ID}\">Please login to view full details of the record.</a></span></span></span></p>",
                "PlainTextMessage": null,
                "Priority": null,
                "ReplayTo": null,
                "SenderName": null,
                "Subject": "Provisioning of the Supplier Item Revision {#DisplayField} has been rejected.",
                "Channel": 1
              },
              "LocalizationData": null,
