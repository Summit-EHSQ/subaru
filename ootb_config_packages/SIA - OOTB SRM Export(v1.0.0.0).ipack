          "ConfigurableViewActions": "[{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide Country field when geography is empty\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"Geography\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"IsNullOperator\",\"negate\":false},\"rightOperand\":null}]},\"falseDecision\":[],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"Geography.ParentGeography\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"City\"}]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide Supplier Review Panel when number of Evaluation is zero\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"NoOfEvaluations\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"0\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"NoOfEvaluations\",\"elementType\":0}]},{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"SupplierReviewPanel\",\"elementType\":0},{\"elementId\":\"SupplierReviewPanel_Closed\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"NoOfEvaluations\",\"elementType\":0},{\"elementId\":