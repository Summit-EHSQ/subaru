          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"SupplierMgmt_PublicProfileObjectInventory\">\r\n    <ix:InventoryView ID=\"SupplierMgmt_PublicProfileObjectInventoryView\" HideGroupAddButton=\"true\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n      </Menu>\r\n      <Grouping>\r\n<ix:Group By=\"SupplierAbs\"/>\r\n      </Grouping>\r\n      <Filters>\r\n        <ix:Filter>\r\n<ix:IsNullPredicate For=\"SupplierAbs\" NEGATE=\"TRUE\"/>\r\n        </ix:Filter>\r\n      </Filters>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\"/>\r\n<ix:Column For=\"Location\" Displayas=\"string\"/>\r\n<ix:Column For=\"SupplierID\"/>\r\n<ix:Column Caption=\"Supplier Name\" For=\"Name\"/>\r\n<ix:Column For=\"Address\"/>\r\n<ix:Column DisplayAs=\"truefalseicon\" For=\"IsOfficialProf\"/>\r\n      </Columns>\r\n    </ix:InventoryView>\r\n  </ix:Inventory>\r\n</ix:InventoryPage>",
          "ParsedView": "{\"__type\":\"ix:InventoryPage\",\"childNodes\":[{\"__type\":\"ix:Inventory\",\"ID\":\"SupplierMgmt_PublicProfileObjectInventory\",\"childNodes\":[{\"__type\":\"ix:InventoryView\",\"ID\":\"SupplierMgmt_PublicProfileObjectInventoryView\",\"HideGroupAddButton\":\"true\",\"childNodes\":[{\"__type\":\"Menu\",\"childNodes\":[{\"__type\":\"ix:GridCreateActionLink\",\"Override\":\"true\",\"Visible\":\"false\"},{\"__type\":\"ix:GridDeleteActionLink\",\"Override\":\"true\",\"Visible\":\"false\"}]},{\"__type\":\"Grouping\",\"childNodes\":[{\"__type\":\"ix:Group\",\"By\":\"SupplierAbs\"}]},{\"__type\":\"Filters\",\"childNodes\":[{\"__type\":\"ix:Filter\",\"childNodes\":[{\"__type\":\"ix:IsNullPredicate\",\"For\":\"SupplierAbs\",\"NEGATE\":\"TRUE\"}]}]},{\"__type\":\"Columns\",\"childNodes\":[{\"__type\":\"ix:Column\",\"For\":\"RecordNo\"},{\"__type\":\"ix:Column\",\"For\":\"Location\",\"Displayas\":\"string\"},{\"__type\":\"ix:Column\",\"For\":\"SupplierID\"},{\"__type\":\"ix:Column\",\"Caption\":\"Supplier Name\",\"For\":\"Name\"},{\"__type\":\"ix:Column\",\"For\":\"Address\"},{\"__type\":\"ix:Column\",\"DisplayAs\":\"truefalseicon\",\"For\":\"IsOfficialProf\"}]}]}]}]}",
