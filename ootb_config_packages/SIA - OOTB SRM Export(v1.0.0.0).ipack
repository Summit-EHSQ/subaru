          "Id": "654566de-3458-4d3b-8253-f69b488a16dc",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\">\r\n  <ix:DetailPageMenuBar ID=\"DetailPageMenuBar1\">\r\n<ix:EditActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:EditReadOnlyActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:HardDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:SaveExitActionLink Visible=\"true\" Override=\"true\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"true\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\">\r\n    <ix:DetailSection Title=\"Supplier Parent Company Details\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Location\" DisplayMode=\"view,edit\" ReadOnly=\"true\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"RecordNo\" DisplayMode=\"view,edit\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Parent Company Name\" For=\"Name\" SpellCheck=\"false\" DisplayAs=\"string\"/>\r\n<ix:Field Caption=\"D&amp;B Number\" For=\"DnBNumber\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Relationship Start Date\" For=\"RelatStartDate\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"SupplierStatus\"/>\r\n<ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" SpellCheck=\"false\" DisplayAs=\"string\"/>\r\n      </ix:FieldArea>\r\n      <ix:Panel Title=\"Address &amp; Contact Details\">\r\n        <ix:FieldArea Span=\"true\">\r\n<ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"Geography\" SpellCheck=\"false\" IsMandatory=\"True\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"City\"/>\r\n<ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/>\r\n<ix:Field Caption=\"Company Website\" For=\"Website\"/>\r\n<ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/>\r\n        </ix:FieldArea>\r\n      </ix:Panel>\r\n      <ix:Panel Title=\"Evaluation Plan\">\r\n        <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Workflow.RecurringSeries.StartDate\" Caption=\"Evaluation Scheduled Date\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"Workflow.RecurringSeries.Frequency\" Caption=\"Evaluation Frequency\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"PersResponsible\" DisplayMode=\"Create\" IsMandatory=\"True\"/>\r\n<ix:Field For=\"PersResponsible\" DisplayMode=\"view,edit\" DisplayAs=\"string\" IsMandatory=\"True\"/>\r\n        </ix:FieldArea>\r\n      </ix:Panel>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval\" ID=\"StageContainer_Approval\">\r\n    <ix:DetailSection Title=\"Supplier Parent Company Details\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Location\" ReadOnly=\"true\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"RecordNo\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Parent Company Name\" For=\"Name\" SpellCheck=\"false\" DisplayAs=\"string\"/>\r\n<ix:Field Caption=\"D&amp;B Number\" For=\"DnBNumber\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Relationship Start Date\" For=\"RelatStartDate\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"SupplierStatus\"/>\r\n<ix:Field Caption=\"Supplier Category\" For=\"SupCategory\" SpellCheck=\"false\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"NoOfEvaluations\"/>\r\n      </ix:FieldArea>\r\n      <ix:Panel Title=\"Address &amp; Contact Details\">\r\n        <ix:FieldArea Span=\"true\">\r\n<ix:Field Caption=\"Country\" For=\"Geography.ParentGeography\" ReadOnly=\"true\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"Geography\" SpellCheck=\"false\" IsMandatory=\"True\" DisplayAs=\"string\"/>\r\n<ix:Field For=\"City\"/>\r\n<ix:Field Caption=\"Address\" For=\"Street\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Postal/Zip Code\" For=\"PostalCode\"/>\r\n<ix:Field Caption=\"Company Website\" For=\"Website\"/>\r\n<ix:Field Caption=\"Company Phone No.\" For=\"PhoneNo\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Company Fax No.\" For=\"FaxNo\" SpellCheck=\"false\"/>\r\n        </ix:FieldArea>\r\n      </ix:Panel>\r\n      <ix:Panel Title=\"Evaluation Plan\">\r\n        <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Workflow.RecurringSeries.StartDate\" Caption=\"Evaluation Scheduled Date\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"Workflow.RecurringSeries.Frequency\" Caption=\"Evaluation Frequency\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"PersResponsible\" DisplayAs=\"string\" IsMandatory=\"True\"/>\r\n        </ix:FieldArea>\r\n      </ix:Panel>\r\n      <ix:Panel Title=\"Supplier Review Details\" DisplayMode=\"View,Edit\" ID=\"SupplierReviewPanel\">\r\n        <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"LastEvaluation.EvaluationDate\" Caption=\"Last Evaluation Date\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"LastEvaluation.Rating\" Caption=\"Last Evaluation Rating\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Notes\" For=\"Notes\" SpellCheck=\"false\"/>\r\n        </ix:FieldArea>\r\n      </ix:Panel>\r\n    </ix:DetailSection>\r\n    <ix:GridSection For=\"SupContacts\" Title=\"Supplier Contacts\" EditLinkTarget=\"popup\" LinkToEditColumn=\"SupplierMgmt_SupplierContact_Detail/Edit?entityid={#id}\">\r\n      <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" visible=\"false\" OpenIn=\"popup\"/>\r\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" Caption=\"Add Contact\" LinkTo=\"SupplierMgmt_SupplierContact_Detail/Create\"/>\r\n      </Menu>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"SupplierMgmt_SupplierContact_Detail/View?entityid={#id}\" LinkTarget=\"popup\"/>\r\n<ix:Column For=\"Number\"/>\r\n<ix:Column For=\"FullName\" DisplayAs=\"string\" Caption=\"Contact Name\"/>\r\n<ix:Column For=\"Position\"/>\r\n<ix:Column For=\"Phone\"/>\r\n<ix:Column For=\"Email\"/>\r\n<ix:Column For=\"ResponsibleFor\" Fetchas=\"Collection\" DisplayAs=\"List\" Caption=\"Responsibilities\"/>\r\n<ix:Column For=\"AllowAccess\" DisplayAs=\"TrueFalseIcon\" Caption=\"Access Enabled?\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n    <ix:GridSection For=\"Facilities\" ID=\"FacilitiesGridSection\" Title=\"Supplier Facilities\" EditLinkTarget=\"popup\">\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Location\" DisplayAs=\"string\"/>\r\n<ix:Column For=\"Name\" Caption=\"Supplier Facility\" DisplayAs=\"string\"/>\r\n<ix:Column For=\"FacilityType\" FilterAs=\"dropdown\"/>\r\n<ix:Column For=\"LastEvaluation.Rating\" Caption=\"Last Evaluation Rating\"/>\r\n<ix:Column For=\"SupplierStatus\" FilterAs=\"dropdown\"/>\r\n<ix:Column For=\"Workflow.WorkflowStatus\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n    <ix:GridSection For=\"SupEvaluations\" EditLinkTarget=\"popup\" Title=\"Supplier Evaluations\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Caption=\"Add Entry\" OpenIn=\"popup\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" visible=\"true\"/>\r\n      </Menu>\r\n      <Sorting>\r\n<ix:Sort By=\"EvaluationDate\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\r\n<ix:Column For=\"EvaluationDate\" format=\"d\"/>\r\n<ix:Column For=\"Rating\" DisplayAs=\"string\"/>\r\n<ix:Column For=\"EvalDescription\"/>\r\n<ix:Column For=\"EvaluatedBy\" DisplayAs=\"string\"/>\r\n<ix:Column For=\"Comments\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n    <ix:DetailSection Title=\"Parent Company Requirements\" IsCollapsed=\"false\">\r\n      <ix:GridPanel For=\"CertReqs\" ID=\"CertificationRequirementGridPanel_approval\" Title=\"Certification Requirements\" EditLinkTarget=\"popup\" OpenIn=\"popup\">\r\n        <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" visible=\"true\"/>\r\n        </Menu>\r\n        <Sorting>\r\n<ix:Sort By=\"AuditDueDate\" Direction=\"Ascending\"/>\r\n        </Sorting>\r\n        <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\" LinkTarget=\"popup\"/>\r\n<ix:Column For=\"Location\" DisplayAs=\"string\"/>\r\n<ix:Column Caption=\"Certification Name\" For=\"Certificate.Name\" DisplayAs=\"string\"/>\r\n<ix:Column Caption=\"Last Certified On\" For=\"LastAuditHist.CertifiedOn\" format=\"d\"/>\r\n<ix:Column Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\"/>\r\n          <ix:TemplateColumn Caption=\"Expiration Date\" For=\"LastAuditHist.ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\">\r\n            <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"LastAuditHist.ExpirationDate\")) %>\r\n            </div>\r\n          </template>\r\n        </ix:TemplateColumn>\r\n<ix:Column For=\"Workflow.PersonResponsible\" DisplayAs=\"Label\"/>\r\n<ix:Column For=\"Workflow.Status\"/>\r\n      </Columns>\r\n    </ix:GridPanel>\r\n    <ix:GridPanel For=\"DocReqs\" Title=\"Documentation Requirements\" EditLinkTarget=\"popup\" OpenIn=\"popup\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\r\n      </Menu>\r\n      <Sorting>\r\n<ix:Sort By=\"ExpirationDate\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\" LinkTarget=\"popup\"/>\r\n<ix:Column For=\"Location\" DisplayAs=\"string\"/>\r\n<ix:Column Caption=\"Document Name\" For=\"Document.Name\"/>\r\n<ix:Column For=\"PriorityOder\"/>\r\n<ix:Column For=\"EffectiveDate\" Format=\"d\"/>\r\n        <ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\">\r\n          <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %>\r\n          </div>\r\n        </template>\r\n      </ix:TemplateColumn>\r\n<ix:Column For=\"Workflow.PersonResponsible\" DisplayAs=\"Label\"/>\r\n<ix:Column For=\"Workflow.Status\"/>\r\n    </Columns>\r\n  </ix:GridPanel>\r\n</ix:DetailSection>\r\n<ix:GridSection For=\"Nonconformances\" ID=\"NonconformancesGridSection_approval\" EditLinkTarget=\"popup\" Title=\"Supplier Nonconformances\" HideGroupAddButton=\"true\">\r\n  <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Caption=\"Add Entry\" OpenIn=\"popup\"/>\r\n  </Menu>\r\n  <Entities>\r\n<ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/>\r\n  </Entities>\r\n  <Sorting>\r\n<ix:Sort By=\"RecordNo\" Direction=\"Descending\"/>\r\n  </Sorting>\r\n  <aliases>\r\n<ix:Alias For=\"Priority.BackgroundColor.Value\" Name=\"BackgroundColor\"/>\r\n<ix:Alias For=\"Priority.TextColor.Value\" Name=\"TextColor\"/>\r\n  </aliases>\r\n  <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Location\" DisplayAs=\"label\"/>\r\n<ix:Column For=\"Name\" caption=\"Title\"/>\r\n<ix:Column For=\"DateReported\" Format=\"d\"/>\r\n<ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\" HorizontalAlign=\"center\" Width=\"2%\"/>\r\n    <ix:TemplateColumn For=\"Workflow.DueDate\" Format=\"d\" Caption=\"Due Date\" HorizontalAlign=\"center\">\r\n      <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"Workflow.DueDate\").ToString() != \"\" ? \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today.AddDays(15) ? \"yellowDiv\" :\r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") > DateTime.Today.AddDays(15) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"Workflow.DueDate\")) %>\r\n      </div>\r\n    </template>\r\n  </ix:TemplateColumn>\r\n<ix:Column For=\"Workflow.PersonResponsible\" DisplayAs=\"label\"/>\r\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\r\n<ix:Column For=\"Workflow.Status\"/>\r\n<ix:Column For=\"Workflow.WorkflowStatus\"/>\r\n</Columns>\r\n</ix:GridSection>\r\n</ix:StageContainer>\r\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_Closed\">\r\n  <ix:DetailSection Title=\"Supplier Parent Company Details\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Location\" DisplayAs=\"string\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RecordNo\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Parent Company ID\" For=\"SupplierID\" SpellCheck=\"false\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Parent Company Name\"