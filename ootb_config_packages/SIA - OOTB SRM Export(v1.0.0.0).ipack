ntityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"AccpCriteriaMet\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"false\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"DateApproved_Assigned\",\"elementType\":0},{\"elementId\":\"NewDueDate_Assigned\",\"elementType\":0},{\"elementId\":\"DateApproved_Approval\",\"elementType\":0},{\"elementId\":\"NewDueDate_Approval\",\"elementType\":0},{\"elementId\":\"DateSigned_Approval\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"NewDueDate_Assigned\",\"elementType\":0},{\"elementId\":\"NewDueDate_Approval\",\"elementType\":0}]},{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"DateApproved_Assigned\",\"elementType\":0},{\"elementId\":\"DateSigned_Assigned\",\"elementType\":0},{\"elementId\":\"DateApproved_Approval\",\"elementType\":0},{\"elementId\":\"DateSigned_Approval\",\"elementType\":0}]},{\"__type\":\"SetMandatoryAction\",\"elements\":[{\"elementId\":\"Comments\",\"elementType\":0},{\"elementId\":\"NewDueDate_Approval\",\"elementType\":0}]},{\"__type\":\"SetNonMandatoryAction\",\"elements\":[{\"elementId\":\"DateApproved_Approval\",\"elementType\":0}]}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"DateApproved_Assigned\",\"elementType\":0},{\"elementId\":\"DateApproved_Approval\",\"elementType\":0},{\"elementId\":\"DateSigned_Approval\",\"elementType\":0},{\"elementId\":\"ApprovalDate_Closed\",\"elementType\":0}]},{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"NewDueDate_Assigned\",\"elementType\":0},{\"elementId\":\"NewDueDate_Approval\",\"elementType\":0}]},{\"__type\":\"SetNonMandatoryAction\",\"elements\":[{\"elementId\":\"Comments\",\"elementType\":0},{\"elementId\":\"NewDueDate_Approval\",\"elementType\":0}]},{\"__type\":\"SetMandatoryAction\",\"elements\":[{\"elementId\":\"DateSigned\",\"elementType\":0},{\"elementId\":\"DateApproved_Approval\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"AccpCriteriaMet\"}]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide fields for Close Stage\",\"stageContainers\":[\"StageContainer_Closed\"],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"AccpCriteriaMet\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"true\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"NewDueDate_Closed\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide NoofApprovalHelper fiel in Approval stage\",\"stageContainers\":[\"StageContainer_Approval\"],\"actions\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"NbOfApprvHelper\",\"elementType\":0}]}],\"onPageLoad\":true,\"triggers\":[]}]",
                "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar1\"><ix:SaveEditActionLink Override=\"true\" DisplayMode=\"Create\" Caption=\"Continue\" meta:resourcekey=\"SaveEditActionLink0\" ResourceKey=\"SaveEditActionLink0\"/><ix:SaveExitActionLink Override=\"true\" visible=\"false\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/><ix:SaveActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/><ix:DeleteActionLink Override=\"true\" Visible=\"false\"/><ix:CancelActionLink Override=\"true\" Visible=\"false\"/><ix:SaveExitActionLink Visible=\"true\"/><ix:CancelActionLink Visible=\"true\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Assigned,Approval\" ID=\"StageContainer_Workflow\"><ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"true\"><ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\"/></ix:FieldArea><div class=\"wfDiagram\"><div><div stage=\"Draft\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/></div></div><div><div stage=\"Assigned\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Assigned%>\"/></div></div><div><div stage=\"Approval\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Approval%>\"/></div></div></div></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\"><ix:DetailSection Title=\"Documentation Requirement Details\" meta:resourcekey=\"DetailSection1\" ResourceKey=\"DetailSection1\"><ix:FieldArea span=\"true\"><ix:Field DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"Location\" Readonly=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" DisplayMode=\"Create\" Displayas=\"string\" For=\"SupplierAbs\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\" meta:resourcekey=\"Field1\" ResourceKey=\"Field1\"/><ix:Field DisplayMode=\"Create\" For=\"Document\"/><ix:Field DisplayMode=\"View,Edit\" For=\"Document\" Readonly=\"True\"/><ix:Field For=\"PriorityOder\"/><ix:Field For=\"RequirementDesc\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_Draft\"><ix:DetailSection Title=\"Documentation Requirement Details\" meta:resourcekey=\"DetailSection2\" ResourceKey=\"DetailSection2\"><ix:FieldArea span=\"true\"><ix:Field DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"Location\" Readonly=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" DisplayMode=\"Create\" Displayas=\"string\" For=\"SupplierAbs\" meta:resourcekey=\"Field2\" ResourceKey=\"Field2\"/><ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\" meta:resourcekey=\"Field3\" ResourceKey=\"Field3\"/><ix:Field DisplayMode=\"View,Edit\" For=\"Document\" Readonly=\"True\"/><ix:Field For=\"PriorityOder\"/><ix:Field For=\"RequirementDesc\"/><ix:Field For=\"DocumentDueDate\" format=\"d\"/><ix:Field Caption=\"Assigned To\" For=\"PersResponsible\" meta:resourcekey=\"Field4\" ResourceKey=\"Field4\"/><ix:Field For=\"Approver\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Assigned\" ID=\"StageContainer_Assigned\"><ix:DetailSection Title=\"Instructions:\" meta:resourcekey=\"DetailSection3\" ResourceKey=\"DetailSection3\"><p>1. Please provide the requested documentation by attaching it to Related Document Attachment grid.</p><p>2. Specify the Effective Date of the document, and if applicable, please also specify the Expiration Date.</p></ix:DetailSection><ix:DetailSection Title=\"Documentation Requirement Details\" meta:resourcekey=\"DetailSection4\" ResourceKey=\"DetailSection4\"><ix:FieldArea span=\"true\"><ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/><ix:Field For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\" meta:resourcekey=\"Field5\" ResourceKey=\"Field5\"/><ix:Field For=\"Document\" Readonly=\"True\"/><ix:Field For=\"PriorityOder\" ReadOnly=\"true\"/><ix:Field For=\"RequirementDesc\" ReadOnly=\"true\"/><ix:Field For=\"DocumentDueDate\" IsMandatory=\"true\" ReadOnly=\"true\" format=\"d\"/><ix:Field For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\"/><ix:Field For=\"EffectiveDate\" IsMandatory=\"True\"/><ix:Field For=\"ExpirationDate\"/><ix:Field For=\"NbOfApprvHelper\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Assigned\" DisplayMode=\"View,Edit\" meta:resourcekey=\"DetailSection5\" ResourceKey=\"DetailSection5\"><ix:FieldArea Span=\"true\"><ix:Field For=\"AccpCriteriaMet\" IsMandatory=\"true\" ReadOnly=\"true\"/><ix:Field For=\"DateApproved\" ID=\"DateApproved_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field For=\"DateSigned\" ID=\"DateSigned_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field Caption=\"Reviewed By\" For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\" meta:resourcekey=\"Field6\" ResourceKey=\"Field6\"/><ix:Field Caption=\"Review Comments\" For=\"Comments\" ReadOnly=\"true\" meta:resourcekey=\"Field7\" ResourceKey=\"Field7\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval\" ID=\"StageContainer_Approval\"><ix:DetailSection Title=\"Instructions:\" meta:resourcekey=\"DetailSection6\" ResourceKey=\"DetailSection6\"><p>1. Please review the uploaded documentation and the dates specified by Supplier.</p><p>2. Approve the document by clicking Approve button or request more information by clicking More Info Required.</p></ix:DetailSection><ix:DetailSection Title=\"Documentation Requirement Details\" meta:resourcekey=\"DetailSection7\" ResourceKey=\"DetailSection7\"><ix:FieldArea span=\"true\"><ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/><ix:Field For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\" meta:resourcekey=\"Field8\" ResourceKey=\"Field8\"/><ix:Field For=\"Document\" Readonly=\"True\"/><ix:Field EditReadonly=\"True\" For=\"PriorityOder\" Readonly=\"True\"/><ix:Field EditReadonly=\"True\" For=\"RequirementDesc\" Readonly=\"True\"/><ix:Field EditReadonly=\"True\" For=\"EffectiveDate\" IsMandatory=\"True\" Readonly=\"True\"/><ix:Field EditReadonly=\"True\" For=\"ExpirationDate\" Readonly=\"True\"/><ix:Field For=\"NbOfApprvHelper\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Approval\" meta:resourcekey=\"DetailSection8\" ResourceKey=\"DetailSection8\"><ix:FieldArea Span=\"true\"><ix:Field For=\"AccpCriteriaMet\"/><ix:Field For=\"DateApproved\" ID=\"DateApproved_Approval\" SpellCheck=\"false\"/><ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Approval\" SpellCheck=\"false\"/><ix:Field For=\"DateSigned\" ID=\"DateSigned_Approval\" SpellCheck=\"false\"/><ix:Field Caption=\"Reviewed By\" DisplayMode=\"Edit,View\" For=\"Approver\" IsMandatory=\"true\" SpellCheck=\"false\" meta:resourcekey=\"Field9\" ResourceKey=\"Field9\"/><ix:Field Caption=\"Review Comments\" DisplayMode=\"View,Edit\" For=\"Comments\" meta:resourcekey=\"Field10\" ResourceKey=\"Field10\"/></ix:FieldArea></ix:DetailSection><ix:WorkflowFields/></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_Closed\"><ix:DetailSection Title=\"Documentation Requirement Details\" meta:resourcekey=\"DetailSection9\" ResourceKey=\"DetailSection9\"><ix:FieldArea span=\"true\"><ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/><ix:Field For=\"RecordNo\"/><ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\" meta:resourcekey=\"Field11\" ResourceKey=\"Field11\"/><ix:Field For=\"Document\" Readonly=\"True\"/><ix:Field For=\"PriorityOder\" ReadOnly=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"RequirementDesc\" ReadOnly=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"EffectiveDate\" IsMandatory=\"True\" ReadOnly=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"ExpirationDate\" ReadOnly=\"true\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Closed\" meta:resourcekey=\"DetailSection10\" ResourceKey=\"DetailSection10\"><ix:FieldArea Span=\"true\"><ix:Field For=\"AccpCriteriaMet\" IsMandatory=\"true\" ReadOnly=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"DateApproved\" ID=\"ApprovalDate_Closed\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field EditReadOnly=\"true\" For=\"DateSigned\" ID=\"DateSigned_Closed\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field Caption=\"Reviewed By\" For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\" meta:resourcekey=\"Field12\" ResourceKey=\"Field12\"/><ix:Field Caption=\"Review Comments\" EditReadOnly=\"true\" For=\"Comments\" ReadOnly=\"true\" meta:resourcekey=\"Field13\" ResourceKey=\"Field13\"/></ix:FieldArea></ix:DetailSection><ix:WorkflowFields/></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" VisibleFor=\"Assigned,Approval\" ID=\"StageContainer_DocAttachment\"><ix:AttachmentSection ID=\"AttachmentFragmentGridSection_create\" DisplayMode=\"Edit,View\" Title=\"Related Document Attachments\" meta:resourcekey=\"AttachmentSection0\" ResourceKey=\"AttachmentSection0\"/></ix:StageContainer><ix:WorkflowTracking IsCollapsed=\"true\"/><style>.redDiv {\r\nbackground-color: #FA5555;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: #9FE1CA;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n\r\n.wfDiagram {\r\n                width:100%;\r\n                overflow:auto;\r\n                margin-bottom:10px;\r\n}\r\n\r\n.wfDiagram > div {\r\n                float: left;\r\n                margin-bottom: 5px;\r\n                padding-left: 24px;\r\n                background-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\r\n                background-repeat: no-repeat;\r\n                background-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n                padding-left: 0;\r\n                background-image: none;\r\n}\r\n\r\n.wfDiagram > div > div {\r\n                width: 180px;\r\n                text-align: center;\r\n                padding: 6px 2px;\r\n                font-weight: bold;\r\n                border-radius: 8px;\r\n                border: 2px solid #6CC0FF;\r\n                background-color: #FFFFFF;\r\n                color: #3F3F3F;\r\n}\r\n\r\n\r\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\r\n                border: 2px solid #0070C0;\r\n                background-color: #0070C0;\r\n                color: #FFFFFF;\r\n}</style></ix:DetailPage>",
