      {
        "$id": "1604",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "5d692a2d-1aa8-4a0b-97c6-4212b546a23e",
        "ObjectName": "SysConfigurableViewProfileEntity",
        "FieldData": {
          "$id": "1605",
          "Id": "5d692a2d-1aa8-4a0b-97c6-4212b546a23e",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"SupplierMgmt_FacilityObjectInventory\">\r\n    <ix:InventoryView ID=\"SupplierMgmt_FacilityObjectInventoryView\" HideGroupAddButton=\"true\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n      </Menu>\r\n      <Grouping>\r\n<ix:Group By=\"ParentCompany\"/>\r\n      </Grouping>\r\n      <Sorting>\r\n<ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\" Width=\"2%\"/>\r\n<ix:Column For=\"Location\" DisplayAs=\"string\"/>\r\n<ix:Column For=\"ParentCompany\" Caption=\"Supplier Parent\"/>\r\n<ix:Column Caption=\"Supplier Facility\" For=\"Name\"/>\r\n<ix:Column FilterAs=\"dropdown\" For=\"FacilityType\"/>\r\n<ix:Column DisplayAs=\"string\" For=\"Workflow.PersonResponsible\"/>\r\n        <ix:TemplateColumn For=\"Workflow.DueDate\" Format=\"d\" Caption=\"Evaluation Due Date\" HorizontalAlign=\"center\">\r\n          <template>\r\n<div class=\"<%# Container.ViewData.Eval(\"Workflow.DueDate\").ToString() != \"\" ? \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today.AddDays(15) ? \"yellowDiv\" :\r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") > DateTime.Today.AddDays(15) ?\"greenDiv\" : \"\" : \"\" %>\">\r\n<%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"Workflow.DueDate\")) %>\r\n          </div>\r\n        </template>\r\n      </ix:TemplateColumn>\r\n<ix:Column FilterAs=\"dropdown\" For=\"SupplierStatus\"/>\r\n<ix:Column For=\"Workflow.WorkflowStatus\"/>\r\n    </Columns>\r\n  </ix:InventoryView>\r\n</ix:Inventory>\r\n<style>\r\n.redDiv {\r\nbackground-color: red;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolo