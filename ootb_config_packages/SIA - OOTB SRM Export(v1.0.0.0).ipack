plier?\" For=\"RemoveSupplier\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" Id=\"Cancelled\">\r\n    <ix:DetailSection Title=\"Approval Details\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ApproveDecision\" ReadOnly=\"true\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"true\" UseDefaultWhenCancelled=\"true\" Id=\"Closed2\">\r\n    <ix:GridSection DisplayEditColumn=\"false\" For=\"Comments\" ID=\"CommentsGridSection_closed\" Title=\"Comments\" readonly=\"true\">\r\n      <Aliases>\r\n<ix:Alias for=\"RecordNo\"/>\r\n      </Aliases>\r\n      <Sorting>\r\n<ix:Sort By=\"RecordNo\" Direction=\"Descending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"Comment\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n    <ix:GridSection DisplayEditColumn=\"false\" For=\"SupplierItem.SuppItemRevs\" Title=\"Revisions\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Caption=\"New Revision\" Override=\"true\" Visible=\"true\" LinkTo=\"ProductMgmt_SupplierItemRevision_Detail/Create?SupplierItem={#SupplierItemId}&amp;CompPPId={#CompPPID}\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"true\"/>\r\n<ix:GridExecuteActionLink Name=\"Detach Supplier\" Override=\"true\" Visible=\"false\"/>\r\n<ix:GridListAllActionLink Override=\"true\" Visible=\"true\"/>\r\n      </Menu>\r\n      <Sorting>\r\n<ix:Sort By=\"DateCreated\" Direction=\"Descending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"RevisionNumber\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Name\"/>\r\n<ix:Column Caption=\"Caption\" For=\"Item.Category\"/>\r\n<ix:Column Caption=\"Item Part Number\" For=\"Item.PartNumber\"/>\r\n<ix:Column For=\"CompPP\"/>\r\n<ix:Column Caption=\"Primary Supplier?\" For=\"IsSuppPrimary\"/>\r\n<ix:Column For=\"DateApproved\" Format=\"d\"/>\r\n<ix:Column Caption=\"Supplier Item Status\" For=\"Workflow.Status\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n  </ix:StageContainer>\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\" DisplayMode=\"View, Edit\"/>\r\n<ix:WorkflowComments ID=\"WorkflowComment\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/>\r\n</ix:DetailPage>\r\n<style type=\"text/css\">\r\n.inline-edit, .popup-edit {\r\n            background-color: #e2f3fa;\r\n            border: 1px dotted #58c3f0 !important;\r\n      }\r\n\r\n\r\n.RowNumber  table {\r\n    counter-reset: rowNumber - 2;\r\n}\r\n\r\n.RowNumber  table tr {\r\n    counter-increment: rowNumber;\r\n}\r\n\r\n.RowNumber  table tr td.first-column::before {\r\n    content: counter(rowNumber);\r\n    padding:10px;\r\n    background-color:#CCCCCC;\r\n    color:#FFFFFF;\r\n    border-radius:10px;\r\n}\r\n\r\n.wfDiagram {\r\n                width:100%;\r\n                margin-bottom:10px;\r\n                text-align:center;\r\n}\r\n\r\n.wfDiagram > div {\r\n                float: left;\r\n                margin-bottom: 5px;\r\n                padding-left: 24px;\r\n                background-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\r\n                background-repeat: no-repeat;\r\n                background-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n                padding-left: 0;\r\n                background-image: none;\r\n}\r\n\r\n.wfDiagram > div > div {\r\n                width: 180px;\r\n                text-align: center;\r\n                padding: 6px 2px;\r\n                font-weight: bold;\r\n                border-radius: 8px;\r\n                border: 2px solid #6CC0FF;\r\n                background-color: #FFFFFF;\r\n                color: #3F3F3F;\r\n}\r\n\r\n\r\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\r\n                border: 2px solid #0070C0;\r\n                background-color: #0070C0;\r\n                color: #FFFFFF;\r\n}\r\n.actionlLink {\r\nvisibility: hidden;\r\nfloat:right;\r\n}\r\n\r\n<% if(Model.Cancelled == true) { %>\r\n[data-workflowactionname=\"Approve\"]{\r\nvisibility: hidden;\r\nfloat:right;\r\n} \r\n<% }  %>\r\n<% if(Model.RevTypeObs != null) { \r\nif(Model.RevTypeObs.ToString() != \"Initiate Change\") {%>\r\n[data-workflowactionname=\"Do Not Supply\"]{\r\nvisibility: hidden;\r\nfloat:right;\r\n} \r\n<%} } else if(Model.RevTypeObs == null && Model.RevisionNumber != 0) {%>\r\n[data-workflowactionname=\"Do Not Supply\"]{\r\nvisibility: hidden;\r\nfloat:right;\r\n} \r\n<% }  %>\r\n</style>",
