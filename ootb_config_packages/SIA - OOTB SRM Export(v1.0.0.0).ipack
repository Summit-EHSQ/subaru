tageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Assigned\" ID=\"StageContainer_Assigned\"><ix:DetailSection Title=\"Instructions:\" meta:resourcekey=\"DetailSection3\" ResourceKey=\"DetailSection3\"><p>- Please provide latest audit details for this certification, attach a copy to the Related Certificates Attachment grid, and then click Submit for Review.</p><p>-  If this certification is not a requirement for you, please provide a reason in the Notes field of Supplier Remarks section and then click Submit for Cancellation.</p></ix:DetailSection><ix:DetailSection Title=\"Certification Requirement Details\" meta:resourcekey=\"DetailSection4\" ResourceKey=\"DetailSection4\"><ix:FieldArea Span=\"true\"><ix:Field Displayas=\"string\" For=\"Location\" Readonly=\"True\"/><ix:Field For=\"RecordNo\" Readonly=\"True\"/><ix:Field Caption=\"Supplier Name\" For=\"SupplierAbs\" Readonly=\"True\" displayas=\"string\" meta:resourcekey=\"Field4\" ResourceKey=\"Field4\"/><ix:Field Caption=\"Certification\" For=\"Certificate\" IsMandatory=\"true\" Readonly=\"True\" meta:resourcekey=\"Field5\" ResourceKey=\"Field5\"/><ix:Field For=\"RequirementDesc\" Readonly=\"True\"/><ix:Field For=\"AuditDueDate\" Readonly=\"True\"/><ix:Field For=\"NbOfApprovals\"/><ix:Field For=\"SupplierAbs.SupplierType\"/><ix:Field For=\"Approver\" IsMandatory=\"true\" Readonly=\"true\"/><ix:Field For=\"NbOfAudits\"/><ix:Field Caption=\"Last Audit Date\" For=\"LastAuditHist.AuditDate\" ID=\"AuditDateAssigned\" Readonly=\"true\" meta:resourcekey=\"Field6\" ResourceKey=\"Field6\"/><ix:Field Caption=\"Last Audit Result\" For=\"LastAuditHist.Result\" ID=\"AuditResultAssigned\" Readonly=\"true\" meta:resourcekey=\"Field7\" ResourceKey=\"Field7\"/></ix:FieldArea><ix:WorkflowFields/></ix:DetailSection><ix:GridSection For=\"AuditHistories\" ID=\"AuditHistoriesGridSection_Assigned\" ResourceKey=\"GridSection0\" Title=\"Certification Audit History\" meta:resourcekey=\"GridSection0\"><Menu><ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" visible=\"true\"/><ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/></Menu><Sorting><ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/><ix:Sort By=\"AuditDate\" Direction=\"Descending\"/></Sorting><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\" /><ix:Column For=\"AuditDate\" format=\"d\" /><ix:Column For=\"CertifiedOn\" format=\"d\" /><ix:TemplateColumn For=\"ExpirationDate\" Format=\"d\" HorizontalAlign=\"center\"><template><div class=\"<%# Container.ViewData.Eval(\"ExpirationDate\").ToString() != \"\" ?  (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today ? \"redDiv\" : \n(DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(3) ? \"yellowDiv\" : (DateTime) Container.ViewData.Eval(\"ExpirationDate\") <= DateTime.Today.AddMonths(6) ?\"greenDiv\" : \"\" : \"\" %>\"><%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ExpirationDate\")) %></div></template></ix:TemplateColumn><ix:Column For=\"Findings\" /><ix:Column For=\"Result\" /></Columns></ix:GridSection><ix:AttachmentSection ID=\"AttachmentFragmentGridSection_assigned\" IsCollapsed=\"true\" Title=\"Related Certificate Attachments\" meta:resourcekey=\"AttachmentSection0\" ResourceKey=\"AttachmentSection0\"/><ix:DetailSection Title=\"Supplier Remarks\" ID=\"SupplierRemarks_Assigned\" meta:resourcekey=\"DetailSection5\" ResourceKey=\"DetailSection5\"><ix:FieldArea span=\"true\"><ix:Field Caption=\"Notes\" For=\"SupComments\" meta:resourcekey=\"Field8\" ResourceKey=\"Field8\"/><ix:Field Caption=\"Date of Cancellation Request\" For=\"DateCancelled\" SpellCheck=\"false\" meta:resourcekey=\"Field9\" ResourceKey=\"Field9\"/><ix:Field For=\"SupCommHelper\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Assigned\" DisplayMode=\"Edit,View\" meta:resource