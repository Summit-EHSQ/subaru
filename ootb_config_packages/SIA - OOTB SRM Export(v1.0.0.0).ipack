          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"SupplierMgmt_PublicProfile_Select_FilterByCompPP\">\r\n    <ix:InventoryView ID=\"SupplierMgmt_PublicProfile_Select_FilterByCompPPView\">\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n      </Menu>\r\n      <Filters>\r\n        <ix:Filter PredicateOperator=\"Or\">\r\n          <ix:CommonPredicate For=\"SupplierAbs:SupplierMgmt_FacilityObject.ParentCompany.Id\" Type=\"Equal\">\r\n            <ix:Value Parse=\"True\">\r\n<%=Request.QueryString[\"SuppCompanyId\"] %>\r\n            </ix:Value>\r\n          </ix:CommonPredicate>\r\n          <ix:CommonPredicate For=\"SupplierAbs.Id\" Type=\"Equal\">\r\n            <ix:Value Parse=\"True\">\r\n<%=Request.QueryString[\"SuppCompanyId\"] %>\r\n            </ix:Value>\r\n          </ix:CommonPredicate>\r\n        </ix:Filter>\r\n      </Filters>\r\n      <Columns><ix:Column For=\"RecordNo\" /><ix:Column Displayas=\"string\" For=\"Location\" /><ix:Column For=\"SupplierID\" /><ix:Column Caption=\"Supplier Name\" For=\"Name\" /><ix:Column For=\"Address\" /><ix:Column DisplayAs=\"truefalseicon\" For=\"IsOfficialProf\" /><ix:Column DisplayAs=\"Dropdown\" For=\"SupplierType\" /></Columns>\r\n    </ix:InventoryView>\r\n  </ix:Inventory>\r\n</ix:InventoryPage>",
          "ParsedView": "{\"__type\":\"ix:InventoryPage\",\"childNodes\":[{\"__type\":\"ix:Inventory\",\"ID\":\"SupplierMgmt_PublicProfile_Select_FilterByCompPP\",\"childNodes\":[{\"__type\":\"ix:InventoryView\",\"ID\":\"SupplierMgmt_PublicProfile_Select_FilterByCompPPView\",\"childNodes\":[{\"__type\":\"Menu\",\"childNodes\":[{\"__type\":\"ix:GridCreateActionLink\",\"Override\":\"true\",\"Visible\":\"false\"},{\"__type\":\"ix:GridDeleteActionLink\",\"Override\":\"true\",\"Visible\":\"false\"}]},{\"__type\":\"Filters\",\"childNodes\":[{\"__type\":\"ix:Filter\",\"PredicateOperator\":\"Or\",\"childNodes\":[{\"__type\":\"ix:CommonPredicate\",\"For\":\"SupplierAbs:SupplierMgmt_FacilityObject.ParentCompany.Id\",\"Type\":\"Equal\",\"childNodes\":[{\"__type\":\"ix:Value\",\"Parse\":\"True\",\"childNodes\":[{\"__type\":\"ContentNode\",\"Value\":\"\\r\\n<%=Request.QueryString[\\\"SuppCompanyId\\\"] %>\\r\\n            \"}]}]},{\"__type\":\"ix:CommonPredicate\",\"For\":\"SupplierAbs.Id\",\"Type\":\"Equal\",\"childNodes\":[{\"__type\":\"ix:Value\",\"Parse\":\"True\",\"childNodes\":[{\"__type\":\"ContentNode\",\"Value\":\"\\r\\n<%=Request.QueryString[\\\"SuppCompanyId\\\"] %>\\r\\n            \"}]}]}]}]},{\"__type\":\"Columns\",\"childNodes\":[{\"__type\":\"ix:Column\",\"For\":\"RecordNo\"},{\"__type\":\"ix:Column\",\"Displayas\":\"string\",\"For\":\"Location\"},{\"__type\":\"ix:Column\",\"For\":\"SupplierID\"},{\"__type\":\"ix:Column\",\"Caption\":\"Supplier Name\",\"For\":\"Name\"},{\"__type\":\"ix:Column\",\"For\":\"Address\"},{\"__type\":\"ix:Column\",\"DisplayAs\":\"truefalseicon\",\"For\":\"IsOfficialProf\"},{\"__type\":\"ix:Column\",\"DisplayAs\":\"Dropdown\",\"For\":\"SupplierType\"}]}]}]}]}",
          "ProfileType": 1,
          "ViewDefinition": "{\"Properties\":[\"RecordNo\",\"Location\",\"SupplierID\",\"Name\",\"Address\",\"IsOfficialProf\",\"SupplierType\",\"SupplierAbs:SupplierMgmt_FacilityObject.ParentCompany.Id\",\"SupplierAbs.Id\"],\"GridProperties\":{},\"ChecklistGrids\":{}}"
