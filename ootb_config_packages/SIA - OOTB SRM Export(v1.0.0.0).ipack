      {
        "$id": "2342",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "aefe6fbe-5b79-4878-af70-b714767a89ae",
        "ObjectName": "SysConfigurableViewProfileEntity",
        "FieldData": {
          "$id": "2343",
          "Id": "aefe6fbe-5b79-4878-af70-b714767a89ae",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar1\">\r\n<ix:SaveEditActionLink Override=\"true\" DisplayMode=\"Create\" Caption=\"Continue\"/>\r\n<ix:SaveExitActionLink Override=\"true\" visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" DisplayMode=\"Edit\"/>\r\n<ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CancelActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveExitActionLink Visible=\"true\"/>\r\n<ix:CancelActionLink Visible=\"true\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Assigned,Approval\" ID=\"StageContainer_Workflow\">\r\n    <ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\"/>\r\n      </ix:FieldArea>\r\n      <div class=\"wfDiagram\">\r\n        <div>\r\n          <div stage=\"Draft\">\r\nDraft\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Assigned\">\r\nAssigned\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Approval\">\r\nApproval\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\">\r\n    <ix:DetailSection Title=\"Documentation Requirement Details\">\r\n      <ix:FieldArea span=\"true\">\r\n<ix:Field DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"Location\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayMode=\"Create\" Displayas=\"string\" For=\"SupplierAbs\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"Create\" For=\"Document\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"Document\" Readonly=\"True\"/>\r\n<ix:Field For=\"PriorityOder\"/>\r\n<ix:Field For=\"RequirementDesc\"/>\r\n      </ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_Draft\">\r\n    <ix:DetailSection Title=\"Documentation Requirement Details\">\r\n      <ix:FieldArea span=\"true\">\r\n<ix:Field DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"Location\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayMode=\"Create\" Displayas=\"string\" For=\"SupplierAbs\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" DisplayMode=\"View,Edit\" For=\"SupplierAbs\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"Document\" Readonly=\"True\"/>\r\n<ix:Field For=\"PriorityOder\"/>\r\n<ix:Field For=\"RequirementDesc\"/>\r\n<ix:Field For=\"DocumentDueDate\" format=\"d\"/>\r\n<ix:Field Caption=\"Assigned To\" For=\"PersResponsible\"/>\r\n<ix:Field For=\"Approver\"/>\r\n      </ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Assigned\" ID=\"StageContainer_Assigned\">\r\n    <ix:DetailSection Title=\"Instructions:\">\r\n<p>\r\n1. Please provide the requested documentation by attaching it to Related Document Attachment grid.\r\n    </p>\r\n<p>\r\n2. Specify the Effective Date of the document, and if applicable, please also specify the Expiration Date.\r\n  </p>\r\n</ix:DetailSection>\r\n<ix:DetailSection Title=\"Documentation Requirement Details\">\r\n  <ix:FieldArea span=\"true\">\r\n<ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RecordNo\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\"/>\r\n<ix:Field For=\"Document\" Readonly=\"True\"/>\r\n<ix:Field For=\"PriorityOder\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RequirementDesc\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"DocumentDueDate\" IsMandatory=\"true\" ReadOnly=\"true\" format=\"d\"/>\r\n<ix:Field For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"EffectiveDate\" IsMandatory=\"True\"/>\r\n<ix:Field For=\"ExpirationDate\"/>\r\n<ix:Field For=\"NbOfApprvHelper\"/>\r\n  </ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n</ix:DetailSection>\r\n<ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Assigned\" DisplayMode=\"View,Edit\">\r\n  <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"AccpCriteriaMet\" IsMandatory=\"true\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"DateApproved\" ID=\"DateApproved_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"DateSigned\" ID=\"DateSigned_Assigned\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Reviewed By\" For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Review Comments\" For=\"Comments\" ReadOnly=\"true\"/>\r\n  </ix:FieldArea>\r\n</ix:DetailSection>\r\n</ix:StageContainer>\r\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval\" ID=\"StageContainer_Approval\">\r\n  <ix:DetailSection Title=\"Instructions:\">\r\n<p>\r\n1. Please review the uploaded documentation and the dates specified by Supplier.\r\n  </p>\r\n<p>\r\n2. Approve the document by clicking Approve button or request more information by clicking More Info Required.\r\n</p>\r\n</ix:DetailSection>\r\n<ix:DetailSection Title=\"Documentation Requirement Details\">\r\n  <ix:FieldArea span=\"true\">\r\n<ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RecordNo\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\"/>\r\n<ix:Field For=\"Document\" Readonly=\"True\"/>\r\n<ix:Field EditReadonly=\"True\" For=\"PriorityOder\" Readonly=\"True\"/>\r\n<ix:Field EditReadonly=\"True\" For=\"RequirementDesc\" Readonly=\"True\"/>\r\n<ix:Field EditReadonly=\"True\" For=\"EffectiveDate\" IsMandatory=\"True\" Readonly=\"True\"/>\r\n<ix:Field EditReadonly=\"True\" For=\"ExpirationDate\" Readonly=\"True\"/>\r\n<ix:Field For=\"NbOfApprvHelper\"/>\r\n  </ix:FieldArea>\r\n</ix:DetailSection>\r\n<ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Approval\">\r\n  <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"AccpCriteriaMet\"/>\r\n<ix:Field For=\"DateApproved\" ID=\"DateApproved_Approval\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"NewDueDate\" ID=\"NewDueDate_Approval\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"DateSigned\" ID=\"DateSigned_Approval\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Reviewed By\" DisplayMode=\"Edit,View\" For=\"Approver\" IsMandatory=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Review Comments\" DisplayMode=\"View,Edit\" For=\"Comments\"/>\r\n  </ix:FieldArea>\r\n</ix:DetailSection>\r\n<ix:WorkflowFields/>\r\n</ix:StageContainer>\r\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_Closed\">\r\n  <ix:DetailSection Title=\"Documentation Requirement Details\">\r\n    <ix:FieldArea span=\"true\">\r\n<ix:Field DisplayAs=\"Label\" For=\"Location\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RecordNo\"/>\r\n<ix:Field Caption=\"Supplier Name\" DisplayAs=\"Label\" For=\"SupplierAbs\" Readonly=\"True\"/>\r\n<ix:Field For=\"Document\" Readonly=\"True\"/>\r\n<ix:Field For=\"PriorityOder\" ReadOnly=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"RequirementDesc\" ReadOnly=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"EffectiveDate\" IsMandatory=\"True\" ReadOnly=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"ExpirationDate\" ReadOnly=\"true\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:DetailSection Title=\"Review Details\" ID=\"ReviewDetails_Closed\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"AccpCriteriaMet\" IsMandatory=\"true\" ReadOnly=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"DateApproved\" ID=\"ApprovalDate_Closed\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"DateSigned\" ID=\"DateSigned_Closed\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Reviewed By\" For=\"Approver\" IsMandatory=\"true\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field Caption=\"Review Comments\" EditReadOnly=\"true\" For=\"Comments\" ReadOnly=\"true\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n<ix:WorkflowFields/>\r\n</ix:StageContainer>\r\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" VisibleFor=\"Assigned,Approval\" ID=\"StageContainer_DocAttachment\">\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection_create\" DisplayMode=\"Edit,View\" Title=\"Related Document Attachments\"/>\r\n</ix:StageContainer>\r\n<ix:WorkflowTracking IsCollapsed=\"true\"/>\r\n<style>\r\n.redDiv {\r\nbackground-color: #FA5555;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: #9FE1CA;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n\r\n.wfDiagram {\r\n                width:100%;\r\n                overflow:auto;\r\n                margin-bottom:10px;\r\n}\r\n\r\n.wfDiagram > div {\r\n                float: left;\r\n                margin-bottom: 5px;\r\n                padding-left: 24px;\r\n                background-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\r\n                background-repeat: no-repeat;\r\n                background-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n                padding-left: 0;\r\n                background-image: none;\r\n}\r\n\r\n.wfDiagram > div > div {\r\n                width: 180px;\r\n                text-align: center;\r\n                padding: 6px 2px;\r\n                font-weight: bold;\r\n                border-radius: 8px;\r\n                border: 2px solid #6CC0FF;\r\n                background-color: #FFFFFF;\r\n                color: #3F3F3F;\r\n}\r\n\r\n\r\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\r\n                border: 2px solid #0070C0;\r\n                background-color: #0070C0;\r\n                color: #FFFFFF;\r\n}\r\n</style>\r\n</ix:DetailPage>",
