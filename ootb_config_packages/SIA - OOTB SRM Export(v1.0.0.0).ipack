          "Caption": null,
          "ConfigurableViewActions": null,
          "Content": "<ix:InventoryPage>\n  <ix:Inventory ID=\"CAR_SCAR_Inventory\">\n    <ix:InventoryView ID=\"CAR_SCAR_InventoryView\" HideGroupAddButton=\"true\">\n      <Grouping>\n<ix:Group by=\"Supplier.Name\"/>\n      </Grouping>\n      <Menu>\n<ix:GridCreateActionLink Visible=\"false\" Override=\"true\"/>\n<ix:GridDeleteActionLink Visible=\"false\" Override=\"true\"/>\n<ix:GridArchiveActionLink Visible=\"false\" Override=\"true\"/>\n      </Menu>\n      <Sorting>\n<ix:Sort By=\"RecordNo\" Direction=\"Descending\"/>\n      </Sorting>\n\n      <Columns>\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\n<ix:Column For=\"Location\" displayas=\"string\"/>\n<ix:Column For=\"IssuDescription\" displayas=\"truncate\" width=\"100%\" wrap=\"true\"/>\n<ix:Column For=\"Supplier\"/>\n<ix:Column For=\"DateCreate\" format=\"d\"/>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\n<ix:Column For=\"RPN\"/>\n<ix:Column For=\"Criticality\"/>\n<ix:Column For=\"BusinessImpact\" displayas=\"list\" fetchas=\"collection\" width=\"40%\"/>\n<ix:Column For=\"Workflow.Status\"/>\n      </Columns>\n    </ix:InventoryView>\n  </ix:Inventory>\n</ix:InventoryPage>\n<style type=\"text/css\">\n.redDiv {\nbackground-color: #FA5555;\ncolor: white;\npadding: 2px;\nborder-radius: 2px;\n}\n</style>",
