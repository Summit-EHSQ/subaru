visions\"><Menu><ix:GridCreateActionLink Caption=\"New Revision\" Override=\"true\" Visible=\"true\" LinkTo=\"ProductMgmt_SupplierItemRevision_Detail/Create?SupplierItem={#SupplierItemId}&amp;CompPPId={#CompPPID}\"/><ix:GridDeleteActionLink Override=\"true\" Visible=\"true\"/><ix:GridExecuteActionLink Name=\"Detach Supplier\" Override=\"true\" Visible=\"false\"/><ix:GridListAllActionLink Override=\"true\" Visible=\"true\"/></Menu><Sorting><ix:Sort By=\"DateCreated\" Direction=\"Descending\"/></Sorting><Columns><ix:Column For=\"RevisionNumber\" LinkTo=\"default\" /><ix:Column For=\"Name\" /><ix:Column Caption=\"Caption\" For=\"Item.Category\" /><ix:Column Caption=\"Item Part Number\" For=\"Item.PartNumber\" /><ix:Column For=\"CompPP\" /><ix:Column Caption=\"Primary Supplier?\" For=\"IsSuppPrimary\" /><ix:Column For=\"DateApproved\" Format=\"d\" /><ix:Column Caption=\"Supplier Item Status\" For=\"Workflow.Status\" /></Columns></ix:GridSection></ix:StageContainer><ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\" DisplayMode=\"View, Edit\"/><ix:WorkflowComments ID=\"WorkflowComment\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/></ix:DetailPage><style type=\"text/css\">\n.inline-edit, .popup-edit {\n            background-color: #e2f3fa;\n            border: 1px dotted #58c3f0 !important;\n      }\n\n\n.RowNumber  table {\n    counter-reset: rowNumber - 2;\n}\n\n.RowNumber  table tr {\n    counter-increment: rowNumber;\n}\n\n.RowNumber  table tr td.first-column::before {\n    content: counter(rowNumber);\n    padding:10px;\n    background-color:#CCCCCC;\n    color:#FFFFFF;\n    border-radius:10px;\n}\n\n.wfDiagram {\n                width:100%;\n                margin-bottom:10px;\n                text-align:center;\n}\n\n.wfDiagram > div {\n                float: left;\n                margin-bottom: 5px;\n                padding-left: 24px;\n                background-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\n                background-repeat: no-repeat;\n                background-position: left center;\n}\n\n.wfDiagram > div:first-child {\n                padding-left: 0;\n                background-image: none;\n}\n\n.wfDiagram > div > div {\n                width: 180px;\n                text-align: center;\n                padding: 6px 2px;\n                font-weight: bold;\n                border-radius: 8px;\n                border: 2px solid #6CC0FF;\n                background-color: #FFFFFF;\n                color: #3F3F3F;\n}\n\n\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\n                border: 2px solid #0070C0;\n                background-color: #0070C0;\n                color: #FFFFFF;\n}\n.actionlLink {\nvisibility: hidden;\nfloat:right;\n}\n\n<% if(Model.Cancelled == true) { %>\n[data-workflowactionname=\"Approve\"]{\nvisibility: hidden;\nfloat:right;\n} \n<% }  %>\n<% if(Model.RevTypeObs != null) { \nif(Model.RevTypeObs.ToString() != \"Initiate Change\") {%>\n[data-workflowactionname=\"Do Not Supply\"]{\nvisibility: hidden;\nfloat:right;\n} \n<%} } else if(Model.RevTypeObs == null && Model.RevisionNumber != 0) {%>\n[data-workflowactionname=\"Do Not Supply\"]{\nvisibility: hidden;\nfloat:right;\n} \n<% }  %>\n</style>",
