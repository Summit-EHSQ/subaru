          "Content": "<ix:InventoryPage><ix:Inventory ID=\"SupplierMgmt_SupNonconformObjectInventory\"><ix:InventoryView ID=\"SupplierMgmt_SupNonconformObjectInventoryView\"><Menu><ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/><ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/><Grouping><ix:Group by=\"SupplierAbs\"/></Grouping></Menu><Sorting><ix:Sort By=\"RecordNo\" Direction=\"Descending\"/></Sorting><aliases><ix:Alias For=\"Priority.BackgroundColor.Value\" Name=\"BackgroundColor\"/><ix:Alias For=\"Priority.TextColor.Value\" Name=\"TextColor\"/></aliases><Columns><ix:Column For=\"RecordNo\" /><ix:Column For=\"Location\" displayas=\"label\" /><ix:Column For=\"Name\" caption=\"Title\" /><ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\" HorizontalAlign=\"center\" ResourceKey=\"Column0\" Width=\"2%\" meta:resourcekey=\"Column0\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:TemplateColumn For=\"Workflow.DueDate\" Format=\"d\" Caption=\"Due Date\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><template><div class=\"<%# Container.ViewData.Eval(\"Workflow.DueDate\").ToString() != \"\" ? \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today ? \"redDiv\" : \r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") <= DateTime.Today.AddDays(15) ? \"yellowDiv\" :\r\n(DateTime) Container.ViewData.Eval(\"Workflow.DueDate\") > DateTime.Today.AddDays(15) ?\"greenDiv\" : \"\" : \"\" %>\"><%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"Workflow.DueDate\")) %></div></template></ix:TemplateColumn><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column DisplayAs=\"Label\" For=\"Workflow.PersonResponsible\" /><ix:Column For=\"Workflow.Status\" /></Columns></ix:InventoryView></ix:Inventory><style>.redDiv {\r\nbackground-color: #FA5555;\r\ncolor: white;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius:2px;\r\n}\r\n.greenDiv {\r\nbackground-color: #9FE1CA;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}\r\n.yellowDiv {\r\nbackground-color: #FCFA86;\r\ncolor: #3A3B3C;\r\npadding: 2px;\r\nborder-radius: 2px;\r\n}</style></ix:InventoryPage>",
