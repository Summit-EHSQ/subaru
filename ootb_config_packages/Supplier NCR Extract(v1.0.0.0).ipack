      {
        "$id": "676",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "c50c92e1-dcb0-40f1-b585-db35af19a05d",
        "ObjectName": "SysConfigurableViewProfileEntity",
        "FieldData": {
          "$id": "677",
          "Id": "c50c92e1-dcb0-40f1-b585-db35af19a05d",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\">\r\n  <ix:DetailPageMenuBar>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:HardDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveExitActionLink Visible=\"true\" Override=\"true\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Validation,Investigation4D,Correction4D,Approval4D\" ID=\"StageContainer_Workflow\">\r\n    <ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\">\r\n      <ix:FieldArea Span=\"true\"><ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\" /><ix:Field For=\"SupPersonRespon\" /><ix:Field For=\"NbOfCAPAHelper\" /></ix:FieldArea>\r\n      <div class=\"wfDiagram\">\r\n        <div>\r\n          <div stage=\"Draft\">\r\nDraft\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Validation\">\r\nValidation\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Investigation4D\">\r\nInvestigation\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Correction4D\">\r\nCorrection\r\n          </div>\r\n        </div>\r\n        <div>\r\n          <div stage=\"Approval4D\">\r\nApproval\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_eb8c29\">\r\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RejectionDetailsSection\">\r\n      <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"CoordinatoNotes\" ReadOnly=\"true\" /></ix:FieldArea>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_c59430\">\r\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RevisionDetails\">\r\n      <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"FinalAppNotes\" ReadOnly=\"true\" /></ix:FieldArea>\r\n      <ix:GridPanel For=\"RNonconformance\" ID=\"RNonconformanceGridSection1\" Title=\"Revised Nonconformances\">\r\n        <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\r\n<ix:Column Caption=\"Title\" For=\"Name\"/>\r\n<ix:Column For=\"Category\"/>\r\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\r\n<ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\"/>\r\n<ix:Column Caption=\"Date Discovered\" For=\"DateReported\" Format=\"d\"/>\r\n<ix:Column For=\"Workflow.DueDate\" Format=\"d\"/>\r\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\r\n<ix:Column For=\"Workflow.Status\"/>\r\n        </Columns>\r\n      </ix:GridPanel>\r\n    </ix:DetailSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\" Visiblefor=\"Draft\">\r\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly2\">\r\n      <ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" DisplayMode=\"Create\" For=\"Location\" /><ix:Field DisplayAs=\"String\" DisplayMode=\"View,Edit\" For=\"Location\" ReadOnly=\"true\" /><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\" /><ix:Field Caption=\"Title\" For=\"Name\" IsMandatory=\"true\" /><ix:Field For=\"Description\" IsMandatory=\"true\" /><ix:Field For=\"firstdiscovered\" /><ix:Field For=\"thisarecurrence\" /><ix: