de=\"Edit,View\"><ix:Panel Title=\"Instructions:\"><p>\r\n- If this nonconformance is complete and fit for approval, please enter Date and Time of Approval, and provide Final Approver Notes.\r\n</p><p>\r\n- If this nonconformance is incomplete and in need of a revision, please add new Revised Nonconformences, and provide a reason in the Final Approver Notes.\r\n</p></ix:Panel><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" SpellCheck=\"false\"/><ix:Field EditReadOnly=\"true\" For=\"DateApproved\" SpellCheck=\"false\"/><ix:Field Caption=\"Final Approver Notes\" EditReadOnly=\"true\" For=\"FinalAppNotes\" SpellCheck=\"false\"/></ix:FieldArea><ix:GridPanel For=\"RNonconformance\" ID=\"RNonconformanceGridSection\" EditLinkTarget=\"popup\" Title=\"Revised Nonconformances\"><Menu><ix:GridCreateActionLink Override=\"true\" Openin=\"popup\" LinkTo=\"SupplierMgmt_SRMNonConform_Detail/Create?SupplierAbsId={#SupplierAbsId}\"/></Menu><Entities><ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/></Entities><Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/><ix:Column Caption=\"Title\" For=\"Name\"/><ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/><ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\"/><ix:Column For=\"DateReported\" Format=\"d\"/><ix:Column For=\"Workflow.DueDate\" Format=\"d\"/><ix:Column For=\"DateClosed\" Format=\"d\"/><ix:Column For=\"Workflow.Status\"/></Columns></ix:GridPanel></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_f8df7e\"><ix:DetailSection Title=\"Final Approval Details\" IsCollapsed=\"true\" ID=\"FinalApprovalDetailClosed\"><ix:FieldArea Span=\"true\"><ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" ReadOnly=\"true\" SpellCheck=