      {
        "$id": "1092",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "99ba45f5-b3e8-45b7-b658-6515675de73d",
        "ObjectName": "SysModuleEntity",
        "FieldData": {
          "$id": "1093",
          "Id": "99ba45f5-b3e8-45b7-b658-6515675de73d",
          "Caption": "Audit Management",
          "Description": "Customers are required to review and improve their processes which is required by all standards/regulations (eg. ISO).  This requirement is auditable by various organizations and evidence must be available to demonstrate due diligence.  Audit Management provides a web and mobile solution to schedule, complete, and report on audits conducted.\r\n\r\nScope:\r\n\r\n- Schedule planned audits\r\n- Assign and schedule audit team\r\n- Provide visibility to auditor is assignment through a calendar view\r\n- Create and complete audit checklists on web or on mobile device\r\n- Identify audit findings and assign actions to correct issues\r\n- Provide the ability to view previous audit findings\r\n- Capture lessons learned\r\n- Provide reports and dashboards to review for continuous improvement activities",
          "Disabled": false,
          "Index": null,
          "IsAvailableForMobile": true,
          "IsAvailableOffline": false,
          "LegacyModuleId": null,
          "MobileCaption": "Audit Management",
          "MobileIcon": "editInspection",
          "UrlCaption": "AuditMgmt",
          "UrlIcon": "Raven/Icons/BrightBlue_48/list3.png",
          "VersionNumber": "1.0.0",
          "VersionOrder": 1000000
        },
        "LocalizationData": null,
        "Id": "1a862ba9-fc65-4ff4-b110-68e826b6aebe",
        "Caption": "Audit Management",
        "Type": "Application",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 2,
        "IsHidden": false
      },
