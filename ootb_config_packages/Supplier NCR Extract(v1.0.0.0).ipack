olumn For=\"Process\"/><ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/><ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\" meta:resourcekey=\"Column1\" ResourceKey=\"Column1\"/><ix:Column For=\"DateReported\" Format=\"d\"/><ix:Column For=\"Workflow.DueDate\" Format=\"d\"/><ix:Column For=\"DateClosed\" Format=\"d\"/><ix:Column For=\"Workflow.Status\"/></Columns></ix:GridPanel></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_ed579e\"><ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailDraft\" meta:resourcekey=\"DetailSection2\" ResourceKey=\"DetailSection2\"><ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\"/><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\"/><ix:Field For=\"RefNonconforman\" ReadOnly=\"true\"/><ix:Field Caption=\"Title\" EditReadOnly=\"true\" For=\"Name\" IsMandatory=\"true\" meta:resourcekey=\"Field2\" ResourceKey=\"Field2\"/><ix:Field EditReadOnly=\"true\" For=\"Description\" IsMandatory=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"Category\" IsMandatory=\"true\"/><ix:Field EditReadOnly=\"true\" For=\"Process\" IsMandatory=\"true\"/><ix:Field For=\"firstdiscovered\"/><ix:Field For=\"thisarecurrence\"/><ix:Field EditReadOnly=\"true\" For=\"SuspectedCause\"/><ix:Field EditReadOnly=\"true\" For=\"ImmediateAction\"/><ix:Field EditReadOnly=\"true\" For=\"ReportedBy\" ReadOnly=\"true\" SpellCheck=\"false\"/><ix:Field EditReadOnly=\"true\" For=\"DateReported\" ReadOnly=\"true\" SpellCheck=\"false\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Validation\" ID=\"StageContainer_08f633\"><ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailVali