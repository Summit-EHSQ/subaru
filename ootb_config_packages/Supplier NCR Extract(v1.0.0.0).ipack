Notes.\r\n      </p>\r\n<p>\r\n- Decide if 8D Methodology is required to correct this Nonconformance. If 'Yes', please assign a team.\r\n    </p>\r\n<p>\r\n- If this nonconformance is not valid, please select 'No' for the field 'Is this a valid Nonconformance?' and provide a reason in the Coordinator Notes.\r\n  </p>\r\n</ix:Panel>\r\n<ix:FieldArea Span=\"true\">\r\n<ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\"/>\r\n<ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"RefNonconforman\" ReadOnly=\"true\"/>\r\n<ix:Field Caption=\"Title\" EditReadOnly=\"true\" For=\"Name\" IsMandatory=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"Description\" IsMandatory=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"Category\" IsMandatory=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"Process\" IsMandatory=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"firstdiscovered\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"thisarecurrence\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"SuspectedCause\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"ImmediateAction\"/>\r\n<ix:Field Span=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"vNonconformance\"/>\r\n<ix:Field For=\"Use8DMethod\" IsMandatory=\"true\"/>\r\n<ix:Field EditReadOnly=\"true\" For=\"CoordinatoNotes\"/>\r\n<ix:Field For=\"ReportedBy\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"DateReported\" ReadOnly=\"true\"/>\r\n<ix:Field For=\"NumofDaysOpened\"/>\r\n<ix:Field Span=\"true\"/>\r\n</ix:FieldArea>\r\n<ix:GridPanel DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSection\" Title=\"Related Nonconformances\" DisplayMode=\"Edit,View\">\r\n  <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" runat=\"server\" LinkTo=\"NonConf_NonconfPlatinum_Select/Index\"/>\r\n  </Menu>\r\n  <Entities>\r\n<ix:IncludeEntity name=\"NonConf_NonconfPlatinumObject\"/>\r\n  </Entities>\r\n  <Columns>\r\n<ix:Column For=\"R