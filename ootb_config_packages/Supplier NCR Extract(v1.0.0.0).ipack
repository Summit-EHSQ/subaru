" For=\"ImmediateAction\" ReadOnly=\"true\"/>\n<ix:Field Span=\"true\"/>\n<ix:Field For=\"vNonconformance\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"CoordinatoNotes\" ReadOnly=\"true\"/>\n<ix:Field For=\"ReportedBy\" ReadOnly=\"true\"/>\n<ix:Field For=\"DateReported\" ReadOnly=\"true\"/>\n<ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\"/>\n<ix:Field Span=\"true\"/>\n      </ix:FieldArea>\n      <ix:GridPanel IsCollapsed=\"true\" ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionReadOnly2\" Title=\"Related Nonconformances\" DisplayMode=\"Edit,View\">\n        <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/>\n<ix:IncludeEntity name=\"SupplierMgmt_SupNonconformObject\"/>\n        </Entities>\n        <Columns>\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\n<ix:Column Caption=\"Title\" For=\"Name\"/>\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\n<ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\"/>\n<ix:Column For=\"DateReported\" Format=\"d\"/>\n<ix:Column For=\"Workflow.DueDate\" Format=\"d\"/>\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n        </Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_18f67f\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailCancelled\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\"/>\n<ix:Field For=\"RecordNo\" ReadOnly=\"true\"/>\n<ix:Field Caption=\"Supplier\" For=\"SupplierAbs\" ReadOnly=\"true\"/>\n<ix:Field Caption=\"Title\" EditReadOnly=\"true\" For=\"Name\" IsMandatory=\"true\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"Description\" IsMandatory=\"true\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"firstdiscovered\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"thisarecurrence\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"SuspectedCause\" ReadOnly=\"true\"/>\n<ix:Field EditReadOnly=\"true\" For=\"ImmediateAction\" ReadOnly=\"true\"/>\n<ix:Field Span=\"true\"/>\n<ix:Field For=\"vNonconformance\" ReadOnly=\"true\"/>\n<ix:Field For=\"ReportedBy\" ReadOnly=\"true\"/>\n<ix:Field For=\"DateReported\" ReadOnly=\"true\"/>\n<ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\"/>\n<ix:Field Span=\"true\"/>\n      </ix:FieldArea>\n      <ix:GridPanel ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionCancelled\" Title=\"Related Nonconformances\" DisplayMode=\"Edit,View\">\n        <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/>\n<ix:IncludeEntity name=\"SupplierMgmt_SupNonconformObject\"/>\n        </Entities>\n        <Columns>\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\n<ix:Column Caption=\"Title\" For=\"Name\"/>\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\n<ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\"/>\n<ix:Column For=\"DateReported\" Format=\"d\"/>\n<ix:Column For=\"Workflow.DueDate\" Format=\"d\"/>\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n        </Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Correction4D\" ReadOnlyFor=\"Correction4D\" ID=\"StageContainer_c1a585\"/>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" VisibleFor=\"Approval4D\" ReadOnlyFor=\"Approval4D\" ID=\"StageContainer_d345e0\"/>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Correction4D\" ID=\"StageContainer_b5c0b0\">\n    <ix:GridSection DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" For=\"SupActionPlans\" Title=\"Corrective Action Plans\" id=\"correctiveActionGrid\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n      </Menu>\n      <Columns>\n<ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\n<ix:Column For=\"CPARActionReq\"/>\n<ix:Column For=\"SupPersonResp\"/>\n<ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\"/>\n<ix:Column For=\"CompletionDate\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n<ix:Column For=\"ActionValidated\"/>\n<ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\"/>\n      </Columns>\n    </ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval4D\" ReadOnlyFor=\"Approval4D\" ID=\"StageContainer_7db736\">\n    <ix:GridSection DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" For=\"SupActionPlans\" ReadOnly=\"true\" Title=\"Corrective Action Plans\" id=\"correctiveActionGridClosed\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n      </Menu>\n      <Columns>\n<ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\n<ix:Column For=\"CPARActionReq\"/>\n<ix:Column For=\"SupPersonResp\"/>\n<ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\"/>\n<ix:Column For=\"CompletionDate\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n<ix:Column For=\"ActionValidated\"/>\n<ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\"/>\n      </Columns>\n    </ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_fd5dd6\">\n    <ix:GridSection EditLinkTarget=\"popup\" For=\"SupActionPlans\" IsCollapsed=\"true\" ReadOnly=\"true\" Title=\"Corrective Action Plans\" id=\"correctiveActionGridClosedCollapsed\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n      </Menu>\n      <Columns>\n<ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\n<ix:Column For=\"CPARActionReq\"/>\n<ix:Column For=\"SupPersonResp\"/>\n<ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\"/>\n<ix:Column For=\"CompletionDate\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n<ix:Column For=\"ActionValidated\"/>\n<ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\"/>\n      </Columns>\n    </ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval4D\" ID=\"StageContainer_0b8aa4\">\n    <ix:DetailSection Title=\"Final Approval Details\" ID=\"FinalApprovalDetail\" DisplayMode=\"Edit,View\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:Panel Title=\"Instructions:\">\n<p>\n- If this nonconformance is complete and fit for approval, please enter Date and Time of Approval, and provide Final Approver Notes.\n      </p>\n<p>\n- If this nonconformance is incomplete and in need of a revision, please add new Revised Nonconformences, and provide a reason in the Final Approver Notes.\n    </p>\n  </ix:Panel>\n  <ix:FieldArea Span=\"true\">\n<ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" SpellCheck=\"false\"/>\n<ix:Field EditReadOnly=\"true\" For=\"DateApproved\" SpellCheck=\"false\"/>\n<ix:Field Caption=\"Final Approver Notes\" EditReadOnly=\"true\" For=\"FinalAppNotes\" SpellCheck=\"false\"/>\n  </ix:FieldArea>\n  <ix:GridPanel For=\"RNonconformance\" ID=\"RNonconformanceGridSection\" EditLinkTarget=\"popup\" Title=\"Revised Nonconformances\">\n    <Menu>\n<ix:GridCreateActionLink Override=\"true\" Openin=\"popup\" LinkTo=\"SupplierMgmt_SRMNonConform_Detail/Create?SupplierAbsId={#SupplierAbsId}\"/>\n    </Menu>\n    <Entities>\n<ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/>\n    </Entities>\n    <Columns>\n<ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\"/>\n<ix:Column Caption=\"Title\" For=\"Name\"/>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\n<ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\"/>\n<ix:Column For=\"DateReported\" Format=\"d\"/>\n<ix:Column For=\"Workflow.DueDate\" Format=\"d\"/>\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n    </Columns>\n  </ix:GridPanel>\n</ix:DetailSection>\n</ix:StageContainer>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_f8df7e\">\n  <ix:DetailSection Title=\"Final Approval Details\" IsCollapsed=\"true\" ID=\"FinalApprovalDetailClosed\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n    <ix:FieldArea Span=\"true\">\n<ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" ReadOnly=\"true\" SpellCheck=\"false\"/>\n<ix:Field EditReadOnly=\"true\" For=\"DateApproved\" ReadOnly=\"true\" SpellCheck=\"false\"/>\n<ix:Field EditReadOnly=\"true\" For=\"FinalAppNotes\" ReadOnly=\"true\" SpellCheck=\"false\"/>\n    </ix:FieldArea>\n  </ix:DetailSection>\n</ix:StageContainer>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"true\" UseDefaultWhenCancelled=\"true\" VisibleFor=\"Approval4D\" ID=\"StageContainer_ISOScopesClosed\" ReadOnlyFor=\"Approval4D\"/>\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/>\n<ix:WorkflowTracking ID=\"WorkflowComment\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/>\n<style>\n.wfDiagram {\n                width:100%;\n                overflow:auto;\n                margin-bottom:10px;\n}\n\n.wfDiagram > div {\n                float: left;\n                margin-bottom: 5px;\n                padding-left: 24px;\n                background-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\n                background-repeat: no-repeat;\n                background-position: left center;\n}\n\n.wfDiagram > div:first-child {\n                padding-left: 0;\n                background-image: none;\n}\n\n.wfDiagram > div > div {\n                width: 180px;\n                text-align: center;\n                padding: 6px 2px;\n                font-weight: bold;\n                border-radius: 8px;\n                border: 2px solid #6CC0FF;\n                background-color: #FFFFFF;\n                color: #3F3F3F;\n}\n\n\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\n                border: 2px solid #0070C0;\n                background-color: #0070C0;\n                color: #FFFFFF;\n}\n</style>\n</ix:DetailPage>",
