          "ConfigurableViewActions": "[{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Show Hide Corrdinator Notes and Assigned To\",\"stageContainers\":[\"StageContainer_Validation\"],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"vNonconformance\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"true\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"vNonconformance\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"false\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"AssignedTo_Validation\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"AssignedTo_Validation\",\"elementType\":0}]},{\"__type\":\"SetNonMandatoryAction\",\"elements\":[{\"elementId\":\"AssignedTo_Validation\",\"elementType\":0}]}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"AssignedTo_Validation\",\"elementType\":0}]},{\"__type\":\"SetMandatoryAction\",\"elements\":[{\"elementId\":\"AssignedTo_Validation\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"vNonconformance\"}]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide Cancel grid2\",\"stageContainers\":[\"StageContainer_eb8c29\",\"StageContainer_c59430\"],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"FinalAppNotes\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"IsNullOperator\",\"negate\":false},\"rightOperand\":null}]},\"falseDecision\":[],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"RevisionDetails\",\"elementType\":0},{\"elementId\":\"correctiveActionGridClosed\",\"elementType\":0},{\"elementId\":\"correctiveActionGridClosedCollapsed\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Hide Cancel grid\",\"stageContainers\":[\"StageContainer_eb8c29\",\"StageContainer_c59430\"],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"FinalAppNotes\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"IsNullOperator\",\"negate\":true},\"rightOperand\":null}]},\"falseDecision\":[],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"RejectionDetailsSection\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[]}]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\">\n  <ix:DetailPageMenuBar>\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\n<ix:SaveEditActionLink Override=\"true\" visible=\"false\"/>\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\n<ix:HardDeleteActionLink Override=\"true\" Visible=\"false\"/>\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\n<ix:SaveExitActionLink Visible=\"true\" Override=\"true\"/>\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\n  </ix:DetailPageMenuBar>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Validation,Correction4D,Approval4D\" ID=\"StageContainer_Workflow\">\n    <ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\"/>\n      </ix:FieldArea>\n      <div class=\"wfDiagram\">\n        <div>\n          <div stage=\"Draft\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Validation\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Validation%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Correction4D\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Correction%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Approval4D\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Approval%>\"/>\n          </div>\n        </div>\n      </div>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_eb8c29\">\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RejectionDetailsSection\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"CoordinatoNotes\" ReadOnly=\"true\"/>\n      </ix:FieldArea>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_c59430\">\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RevisionDetails\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"FinalAppNotes\" ReadOnly=\"true\"/>\n      </ix:FieldArea>\n      <ix:GridPanel For=\"RNonconformance\" ID=\"RNonconformanceGridSection1\" Title=\"Revised Nonconformances\">\n        <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"SupplierMgmt_SupNonconformObject\"/>\n        </Entities>\n        <Columns>\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\n<ix:Column Caption=\"Title\" For=\"Name\"/>\n<ix:Column For=\"Category\"/>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/>\n<ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\"/>\n<ix:Column Caption=\"Date Discovered\" For=\"DateReported\" Format=\"d\"/>\n<ix:Column For=\"Workflow.DueDate\" Format=\"d\"/>\n<ix:Column For=\"DateClosed\" Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n        </Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\" Visiblefor=\"Draft\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly2\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field DisplayAs=\"String\" DisplayMo