          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar>\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\n<ix:HardDeleteActionLink Override=\"true\" Visible=\"false\"/>\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\n<ix:SaveExitActionLink Visible=\"true\" Override=\"true\"/>\n<ix:SecurityActionLink Override=\"true\" Visible=\"false\"/>\n  </ix:DetailPageMenuBar>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Draft,Validation,Investigation4D,Correction4D,Approval4D\" ID=\"StageContainer_Workflow\">\n    <ix:DetailSection Title=\"Default Section Title\" ShowHeader=\"false\">\n      <ix:FieldArea Span=\"true\"><ix:Field For=\"Workflow.CurrentStage.SystemName\" Visible=\"false\" /><ix:Field For=\"SupPersonRespon\" /><ix:Field For=\"NbOfCAPAHelper\" /><ix:Field For=\"SupplierAbs\" /></ix:FieldArea>\n      <div class=\"wfDiagram\">\n        <div>\n          <div stage=\"Draft\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Validation\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Validation%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Investigation4D\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Investigation%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Correction4D\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Correction%>\"/>\n          </div>\n        </div>\n        <div>\n          <div stage=\"Approval4D\">\n<asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Approval%>\"/>\n          </div>\n        </div>\n      </div>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_eb8c29\">\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RejectionDetailsSection\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"CoordinatoNotes\" ReadOnly=\"true\" /></ix:FieldArea>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"true\" ID=\"StageContainer_c59430\">\n    <ix:DetailSection Title=\"Cancel Detail\" id=\"RevisionDetails\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Reason for Cancelled Nonconformance\" EditReadOnly=\"true\" For=\"FinalAppNotes\" ReadOnly=\"true\" /></ix:FieldArea>\n      <ix:GridPanel For=\"RNonconformance\" ID=\"RNonconformanceGridSection1\" Title=\"Revised Nonconformances\">\n        <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" /><ix:Column For=\"Category\" /><ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\" /><ix:Column Caption=\"Date Discovered\" For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_Create\" Visiblefor=\"Draft\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly2\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" DisplayMode=\"Create\" For=\"Location\" /><ix:Field DisplayAs=\"String\" DisplayMode=\"View,Edit\" For=\"Location\" ReadOnly=\"true\" /><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\" /><ix:Field Caption=\"Title\" For=\"Name\" IsMandatory=\"true\" /><ix:Field For=\"Description\" IsMandatory=\"true\" /><ix:Field For=\"firstdiscovered\" /><ix:Field For=\"thisarecurrence\" /><ix:Field For=\"SuspectedCause\" /><ix:Field For=\"ImmediateAction\" /><ix:Field Span=\"true\" /><ix:Field For=\"ReportedBy\" /><ix:Field For=\"DateReported\" /><ix:Field Span=\"true\" /></ix:FieldArea>\n      <ix:GridPanel IsCollapsed=\"true\" ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionReadOnly\" Title=\"Related Nonconformances\" DisplayMode=\"Edit,View\">\n        <Menu>\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" LinkTo=\"NonConf_NonconfPlatinum_Select/Index\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"NonConf_NonconfPlatinumObject\"/>\n        </Entities>\n        <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" />\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Validation\" ID=\"StageContainer_DraftValidation\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly3\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\" /><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\" /><ix:Field Caption=\"Title\" For=\"Name\" IsMandatory=\"true\" /><ix:Field For=\"Description\" IsMandatory=\"true\" /><ix:Field For=\"firstdiscovered\" /><ix:Field For=\"thisarecurrence\" /><ix:Field For=\"SuspectedCause\" /><ix:Field For=\"ImmediateAction\" /><ix:Field Span=\"true\" /><ix:Field For=\"vNonconformance\" IsMandatory=\"true\" /><ix:Field For=\"CoordinatoNotes\" IsMandatory=\"true\" /><ix:Field For=\"ReportedBy\" ReadOnly=\"true\" /><ix:Field For=\"DateReported\" ReadOnly=\"true\" /><ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\" /><ix:Field Span=\"true\" /></ix:FieldArea>\n      <ix:GridPanel IsCollapsed=\"true\" ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionReadOnly3\" Title=\"Related Nonconformances\">\n        <Menu>\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" LinkTo=\"NonConf_NonconfPlatinum_Select/Index\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"NonConf_NonconfPlatinumObject\"/>\n        </Entities>\n        <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" />\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ReadOnlyFor=\"Investigation4D,Correction4D,Approval4D\" VisibleFor=\"Investigation4D,Correction4D,Approval4D\" ID=\"StageContainer_62e590\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\" /><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\" /><ix:Field Caption=\"Title\" EditReadOnly=\"true\" For=\"Name\" IsMandatory=\"true\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"Description\" IsMandatory=\"true\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"firstdiscovered\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"thisarecurrence\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"SuspectedCause\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"ImmediateAction\" ReadOnly=\"true\" /><ix:Field Span=\"true\" /><ix:Field For=\"vNonconformance\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"CoordinatoNotes\" ReadOnly=\"true\" /><ix:Field For=\"ReportedBy\" ReadOnly=\"true\" /><ix:Field For=\"DateReported\" ReadOnly=\"true\" /><ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\" /><ix:Field Span=\"true\" /></ix:FieldArea>\n      <ix:GridPanel IsCollapsed=\"true\" ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionReadOnly2\" Title=\"Related Nonconformances\">\n        <Menu>\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" LinkTo=\"NonConf_NonconfPlatinum_Select/Index\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"NonConf_NonconfPlatinumObject\"/>\n        </Entities>\n        <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" />\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"false\" ID=\"StageContainer_18f67f\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailCancelled\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\" /><ix:Field For=\"RecordNo\" ReadOnly=\"true\" /><ix:Field Caption=\"Title\" EditReadOnly=\"true\" For=\"Name\" IsMandatory=\"true\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"Description\" IsMandatory=\"true\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"firstdiscovered\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"thisarecurrence\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"SuspectedCause\" ReadOnly=\"true\" /><ix:Field EditReadOnly=\"true\" For=\"ImmediateAction\" ReadOnly=\"true\" /><ix:Field Span=\"true\" /><ix:Field For=\"vNonconformance\" ReadOnly=\"true\" /><ix:Field For=\"ReportedBy\" ReadOnly=\"true\" /><ix:Field For=\"DateReported\" ReadOnly=\"true\" /><ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\" /><ix:Field Span=\"true\" /></ix:FieldArea>\n      <ix:GridPanel ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionCancelled\" Title=\"Related Nonconformances\">\n        <Menu>\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" LinkTo=\"NonConf_NonconfPlatinum_Select/Index\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"NonConf_NonconfPlatinumObject\"/>\n        </Entities>\n        <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" />\n          <ix:TemplateColumn For=\"Priority\" FilterAs=\"Dropdown\" HorizontalAlign=\"center\">\n            <template>\n              <div style=\"padding:2px;background-color:<%# Container.ViewData.Eval(\"BackgroundColor\") %>;color:<%# Container.ViewData.Eval(\"TextColor\") %>\">\n<%# Container.ViewData.Eval(\"Priority\") %>\n              </div>\n            </template>\n          </ix:TemplateColumn>\n<ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\":NonConf_NonconfPlatinumObject.NumofDaysOpened\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Investigation4D\" ID=\"StageContainer_8185b6\">\n    <ix:GridSection For=\"CauseAnalysis\" HideGroupAddButton=\"true\" ID=\"CauseAnalysisGridSection\" ModernIcon=\"Raven/Icons/BrightBlue_48/magnifying59.png\" Title=\"Root Cause Analysis\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\"/>\n      </Menu>\n      <grouping>\n<ix:Group By=\"SystemType.Caption\" HeaderCaption=\"Method\"/>\n      </grouping>\n      <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column For=\"Title\" /><ix:Column For=\"Date\" format=\"d\" /><ix:Column For=\"Owner\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Correction4D\" ReadOnlyFor=\"Correction4D\" ID=\"StageContainer_c1a585\">\n    <ix:GridSection For=\"CauseAnalysis\" HideGroupAddButton=\"true\" ID=\"CauseAnalysisGridSectionClosed\" ModernIcon=\"Raven/Icons/BrightBlue_48/magnifying59.png\" ReadOnly=\"true\" Title=\"Root Cause Analysis\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\"/>\n      </Menu>\n      <grouping>\n<ix:Group By=\"SystemType.Caption\" HeaderCaption=\"Method\"/>\n      </grouping>\n      <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column For=\"Title\" /><ix:Column For=\"Date\" format=\"d\" /><ix:Column For=\"Owner\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" VisibleFor=\"Approval4D\" ReadOnlyFor=\"Approval4D\" ID=\"StageContainer_d345e0\">\n    <ix:GridSection For=\"CauseAnalysis\" HideGroupAddButton=\"true\" ID=\"CauseAnalysisGridSectionClosedCollapsed\" IsCollapsed=\"true\" ModernIcon=\"Raven/Icons/BrightBlue_48/magnifying59.png\" ReadOnly=\"true\" Title=\"Root Cause Analysis\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\"/>\n      </Menu>\n      <grouping>\n<ix:Group By=\"SystemType.Caption\" HeaderCaption=\"Method\"/>\n      </grouping>\n      <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column For=\"Title\" /><ix:Column For=\"Date\" format=\"d\" /><ix:Column For=\"Owner\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Correction4D\" ID=\"StageContainer_b5c0b0\">\n    <ix:GridSection EditLinkTarget=\"popup\" For=\"EventActionPlan\" LinkToEditColumn=\"NonConf_EventActionPlan_Detail/Edit?entityid={#id}\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\" Title=\"Corrective Action Plans\" id=\"correctiveActionGrid\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/Create?CPARTypeID=d0de0e2b-dde6-4f41-914c-da08371636a0\"/>\n      </Menu>\n      <Filters>\n        <ix:Filter>\n          <ix:CommonPredicate For=\"CPARTypeID\" Type=\"Equal\">\n            <ix:Value>\nCorrective\n            </ix:Value>\n          </ix:CommonPredicate>\n        </ix:Filter>\n      </Filters>\n      <Columns><ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/View?entityid={#id}\" /><ix:Column For=\"CPARActionReq\" /><ix:Column For=\"PersonResp\" /><ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\" /><ix:Column For=\"CompletionDate\" Format=\"d\" /><ix:Column For=\"ToCostofActions\" /><ix:Column For=\"Workflow.Status\" /><ix:Column For=\"ActionValidated\" /><ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval4D\" ReadOnlyFor=\"Approval4D\" ID=\"StageContainer_7db736\">\n    <ix:GridSection EditLinkTarget=\"popup\" For=\"EventActionPlan\" LinkToEditColumn=\"NonConf_EventActionPlan_Detail/Edit?entityid={#id}\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\" ReadOnly=\"true\" Title=\"Corrective Action Plans\" id=\"correctiveActionGridClosed\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/Create?CPARTypeID=d0de0e2b-dde6-4f41-914c-da08371636a0\"/>\n      </Menu>\n      <Filters>\n        <ix:Filter>\n          <ix:CommonPredicate For=\"CPARTypeID\" Type=\"Equal\">\n            <ix:Value>\nCorrective\n            </ix:Value>\n          </ix:CommonPredicate>\n        </ix:Filter>\n      </Filters>\n      <Columns><ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/View?entityid={#id}\" /><ix:Column For=\"CPARActionReq\" /><ix:Column For=\"PersonResp\" /><ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\" /><ix:Column For=\"CompletionDate\" Format=\"d\" /><ix:Column For=\"ToCostofActions\" /><ix:Column For=\"Workflow.Status\" /><ix:Column For=\"ActionValidated\" /><ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"true\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_fd5dd6\">\n    <ix:GridSection EditLinkTarget=\"popup\" For=\"EventActionPlan\" IsCollapsed=\"true\" LinkToEditColumn=\"NonConf_EventActionPlan_Detail/Edit?entityid={#id}\" ModernIcon=\"Raven/Icons/BrightBlue_48/right218.png\" ReadOnly=\"true\" Title=\"Corrective Action Plans\" id=\"correctiveActionGridClosedCollapsed\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/Create?CPARTypeID=d0de0e2b-dde6-4f41-914c-da08371636a0\"/>\n      </Menu>\n      <Filters>\n        <ix:Filter>\n          <ix:CommonPredicate For=\"CPARTypeID\" Type=\"Equal\">\n            <ix:Value>\nCorrective\n            </ix:Value>\n          </ix:CommonPredicate>\n        </ix:Filter>\n      </Filters>\n      <Columns><ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"NonConf_EventActionPlan_Detail/View?entityid={#id}\" /><ix:Column For=\"CPARActionReq\" /><ix:Column For=\"PersonResp\" /><ix:Column Caption=\"Target Date\" For=\"DueDate\" Format=\"d\" /><ix:Column For=\"CompletionDate\" Format=\"d\" /><ix:Column For=\"ToCostofActions\" /><ix:Column For=\"Workflow.Status\" /><ix:Column For=\"ActionValidated\" /><ix:Column Caption=\"Completed?\" DisplayAs=\"TrueFalseIcon\" For=\"IsCompleted\" /></Columns></ix:GridSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Approval4D\" ID=\"StageContainer_0b8aa4\">\n    <ix:DetailSection Title=\"Final Approval Details\" ID=\"FinalApprovalDetail\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:Panel Title=\"Instructions:\">\n<p>\n- If this nonconformance is complete and fit for approval, please enter Date and Time of Approval, and provide some Final Verification and Approver Notes.\n      </p>\n<p>\n- If this nonconformance is incomplete and in need of a revision, please add new Revised Nonconformences, and provide a reason in the Final Verification and Approver Notes.\n    </p>\n  </ix:Panel>\n  <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" SpellCheck=\"false\" /><ix:Field Caption=\"Verification and Approval Date\" EditReadOnly=\"true\" For=\"DateApproved\" SpellCheck=\"false\" /><ix:Field Caption=\"Verification and Approver Comments\" EditReadOnly=\"true\" For=\"FinalAppNotes\" SpellCheck=\"false\" /></ix:FieldArea>\n  <ix:GridPanel EditLinkTarget=\"popup\" For=\"RNonconformance\" ID=\"RNonconformanceGridSection\" Title=\"Revised Nonconformances\">\n    <Entities>\n<ix:IncludeEntity name=\"I9001Compliance_QNonconformanceObject\"/>\n    </Entities>\n    <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n    </Menu>\n    <Columns><ix:Column For=\"RecordNo\" LinkTarget=\"popup\" LinkTo=\"default\" /><ix:Column Caption=\"Title\" For=\"Name\" /><ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\" /><ix:Column Caption=\"No. of Days Opened\" For=\"NumofDaysOpened\" /><ix:Column For=\"DateReported\" Format=\"d\" /><ix:Column For=\"Workflow.DueDate\" Format=\"d\" /><ix:Column For=\"DateClosed\" Format=\"d\" /><ix:Column For=\"Workflow.Status\" /></Columns>\n  </ix:GridPanel>\n</ix:DetailSection>\n</ix:StageContainer>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"true\" ID=\"StageContainer_f8df7e\">\n  <ix:DetailSection Title=\"Final Approval Details\" IsCollapsed=\"true\" ID=\"FinalApprovalDetailClosed\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n    <ix:FieldArea Span=\"true\"><ix:Field Caption=\"Verification of Effectiveness\" EditReadOnly=\"true\" For=\"CorrectiActions\" ReadOnly=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Verification and Approval Date\" EditReadOnly=\"true\" For=\"DateApproved\" ReadOnly=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Verification and Approval Comments\" EditReadOnly=\"true\" For=\"FinalAppNotes\" ReadOnly=\"true\" SpellCheck=\"false\" /></ix:FieldArea>\n  </ix:DetailSection>\n</ix:StageContainer>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Draft,Validation,Investigation4D,Correction4D\" ID=\"StageContainer_SupplierAbs\"/>\n<ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"true\" UseDefaultWhenCancelled=\"true\" VisibleFor=\"Approval4D\" ID=\"StageContainer_ISOScopesClosed\" ReadOnlyFor=\"Approval4D\"/>\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/>\n<ix:WorkflowComments ID=\"WorkflowComment\" IsCollapsed=\"true\" DisplayMode=\"Edit,View\"/>\n<ix:WorkflowFields/>\n<style>\n.wfDiagram {\n                width:100%;\n                overflow:auto;\n                margin-bottom:10px;\n}\n\n.wfDiagram > div {\n                float: left;\n                margin-bottom: 5px;\n                padding-left: 24px;\n                background-image: url('<%= ImageHelper.GetVersionedPath(\"navigate_right.gif\") %>');\n                background-repeat: no-repeat;\n                background-position: left center;\n}\n\n.wfDiagram > div:first-child {\n                padding-left: 0;\n                background-image: none;\n}\n\n.wfDiagram > div > div {\n                width: 180px;\n                text-align: center;\n                padding: 6px 2px;\n                font-weight: bold;\n                border-radius: 8px;\n                border: 2px solid #6CC0FF;\n                background-color: #FFFFFF;\n                color: #3F3F3F;\n}\n\n\n.wfDiagram > div > div[stage='<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\")%>'] {\n                border: 2px solid #0070C0;\n                background-color: #0070C0;\n                color: #FFFFFF;\n}\n</style>\n<ix:GridSection For=\"SupActionPlans\" ID=\"SupActionPlansGridSection\"><Columns><ix:Column For=\"ActionNo\" LinkTo=\"default\" /><ix:Column For=\"Activites\" /><ix:Column For=\"ActivitiesStart\" /><ix:Column For=\"ActivitProgress\" /><ix:Column For=\"ActualCost\" /></Columns></ix:GridSection></ix:DetailPage>",
          "HasFilter": true,
