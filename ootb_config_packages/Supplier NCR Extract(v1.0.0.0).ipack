              "FieldData": {
                "$id": "37",
                "Id": "c1d96efc-48f1-466d-ab2e-f28bca238bfc",
                "Attachments": null,
                "HtmlMessage": "<p>The following Nonconformance requires a revision for further investigation. Please create a new revised Nonconformance.<br /><br /></p><p>Status: Cancelled</p><div class=\"t-paste-container\">Location: {#Location}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Record No.: {#RecordNo}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Title: {#Name}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Description: {#Description}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Category: {#Category}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Process: {#Process}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\"><p>Is this a valid Nonconformance? : {#vNonconformance}</p><p>Use 8D Methodology: {#Use8DMethod}</p><p>Number of Days Opened: {#NumofDaysOpened}</p></div><div class=\"t-paste-container\">Coordinator Notes: {#CoordinatoNotes}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Team Leader: {#TeamLeader}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Priority: {#Priority}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\">Summary: {#Summary}</div><div class=\"t-paste-container\"><br /></div><div class=\"t-paste-container\"><p>Effectiveness of Corrective Actions: {#CorrectiActions}</p></div><p>Reason for Cancelled Nonconformance: {#FinalAppNotes}</p><p> </p><p>Cancelled By: {#Workflow.PersonResponsible}</p><p>Date Cancelled: {#DateClosed}</p><p>--------------------------------------------------------</p><p><a href=\"{#System.Link}\">Please login to view full details of the report.<a></p>",
                "PlainTextMessage": null,
                "Priority": null,
                "ReplayTo": null,
                "SenderName": null,
                "Subject": "Nonconformance {#RecordNo} requires a revision for further investigation.",
                "Channel": 1
              },
