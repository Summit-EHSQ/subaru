        "FieldData": {
          "$id": "973",
          "Walkthroughs": null,
          "Profiles": null,
          "Id": "8e9b31ee-0ab8-45fe-aa73-7de584fd7c21",
          "Caption": "Nonconformance",
          "ConfigurableViewActions": "[{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\" Is this a valid Nonconformance?\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['vNonconformance', 'Use8DMethod'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return Intelex.DetailPage.getField('vNonconformance').value.eq('true');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'show',\\u000a                        elements: ['Use8DMethod', 'RelatedEventsGridSection', 'RelatedEventsGridSectionReadOnly', 'RelatedEventsGridSectionCancelled']\\u000a                }, {\\u000a                        __type: 'decision',\\u000a                        condition: function () {\\u000a                                return Intelex.DetailPage.getField('Use8DMethod').value.eq('true');\\u000a                        },\\u000a                        trueDecision: [{\\u000a                                __type: 'show',\\u000a                                elements: ['TeamDetails', 'TeamDetailsClosed']\\u000a                        }, {\\u000a                                __type: 'setMandatory',\\u000a                                elements: ['TeamLeader']\\u000a                        }],\\u000a                        falseDecision: [{\\u000a                                __type: 'hide',\\u000a                                elements: ['TeamDetails', 'TeamDetailsClosed']\\u000a                        }, {\\u000a                                __type: 'setNonMandatory',\\u000a                                elements: ['TeamLeader']\\u000a                        }]\\u000a                }],\\u000a                falseDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['Use8DMethod', 'RelatedEventsGridSection', 'RelatedEventsGridSectionReadOnly', 'RelatedEventsGridSectionCancelled', 'TeamDetails', 'TeamDetailsClosed', 'summaryDetailClosedCollapsed', 'containmentActionsGridClosedCollapsed', 'CauseAnalysisGridSectionClosedCollapsed', 'correctiveActionGridClosedCollapsed', 'effectivenessDetailsClosedCollapsed', 'lessonsLearnedGridClosedCollapsed']\\u000a                }, {\\u000a                        __type: 'setNonMandatory',\\u000a                        elements: ['TeamLeader']\\u000a                }]\\u000a        }]\\u000a}\"},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Rejection\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"FinalAppNotes\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"IsNullOperator\",\"negate\":false},\"rightOperand\":null}]},\"falseDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"RevisionDetails\",\"elementType\":0}]},{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"RejectionDetailsSection\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"RevisionDetails\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"FinalAppNotes\"}]},{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Reference Nonconformance\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['RefNonconforman'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return Intelex.DetailPage.getField('RefNonconforman').value.value.eq('');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['RefNonconforman']\\u000a                }],\\u000a                falseDecision: [{\\u000a                        __type: 'show',\\u000a                        elements: ['RefNonconforman']\\u000a                }]\\u000a        }]\\u000a}\"}]",
