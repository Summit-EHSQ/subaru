 Format=\"d\"/>\n<ix:Column For=\"Workflow.Status\"/>\n        </Columns>\n      </ix:GridPanel>\n    </ix:DetailSection>\n  </ix:StageContainer>\n  <ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCancelled=\"false\" UseDefaultWhenCompleted=\"false\" VisibleFor=\"Validation\" ID=\"StageContainer_Validation\">\n    <ix:DetailSection Title=\"Nonconformance Details\" ID=\"NonconformanceDetailReadOnly3\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\">\n      <ix:FieldArea Span=\"true\">\n<ix:Field DisplayAs=\"String\" For=\"Location\" ReadOnly=\"true\"/>\n<ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" ReadOnly=\"true\"/>\n<ix:Field Caption=\"Supplier\" For=\"SupplierAbs\" ReadOnly=\"true\"/>\n<ix:Field Caption=\"Title\" For=\"Name\" IsMandatory=\"true\"/>\n<ix:Field For=\"Description\" IsMandatory=\"true\"/>\n<ix:Field For=\"firstdiscovered\"/>\n<ix:Field For=\"thisarecurrence\"/>\n<ix:Field For=\"SuspectedCause\"/>\n<ix:Field For=\"ImmediateAction\"/>\n<ix:Field Span=\"true\"/>\n<ix:Field For=\"vNonconformance\" IsMandatory=\"true\"/>\n<ix:Field For=\"SupPersonRespon\" ID=\"AssignedTo_Validation\"/>\n<ix:Field For=\"CoordinatoNotes\" IsMandatory=\"true\" ID=\"CoordinatorNotes_Validation\"/>\n<ix:Field For=\"ReportedBy\" ReadOnly=\"true\"/>\n<ix:Field For=\"DateReported\" ReadOnly=\"true\"/>\n<ix:Field For=\"NumofDaysOpened\" ReadOnly=\"true\"/>\n<ix:Field Span=\"true\"/>\n      </ix:FieldArea>\n      <ix:GridPanel IsCollapsed=\"true\" ReadOnly=\"true\" DisplayEditColumn=\"false\" EditLinkTarget=\"popup\" For=\"RelatedEvents\" ID=\"RelatedEventsGridSectionReadOnly3\" Title=\"Related Nonconformances\" DisplayMode=\"Edit,View\">\n        <Menu>\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\n        </Menu>\n        <Entities>\n<ix:IncludeEntity name=\"SupplierMgmt_SRMNonConformObject\"/>\n<ix:IncludeEntity name=\"SupplierMgmt_SupNonconformObject\"/>\n        </Entities>\n        <Columns>\n<ix:Column For=\"RecordNo\" LinkTo=\"