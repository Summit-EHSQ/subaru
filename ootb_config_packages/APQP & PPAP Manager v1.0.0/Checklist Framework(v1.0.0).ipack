          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:SaveActionLink Override=\"true\" Visible=\"false\"/><ix:DeleteActionLink Override=\"true\" Visible=\"false\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/></ix:DetailPageMenuBar><ix:DetailSection Title=\"Question\" Icon=\"Icons/new/48x48/help.gif\"><ix:FieldArea><ix:Field DisplayMode=\"View\" For=\"ChecklistAnswer\" LinkTarget=\"popup\" Span=\"true\" /><ix:Field For=\"PubQuestion.Section\" Span=\"true\" /><ix:Field DisplayAs=\"html\" For=\"PubQuestion.Content\" Span=\"true\" /><ix:Field For=\"PubQuestion.Guideline\" Span=\"true\" /><ix:Field For=\"PubQuestion.AnswerType\" IsVisible=\"false\" /><ix:Field For=\"PubQuestion.Question.UseReferences\" IsVisible=\"false\" /></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"References\" Id=\"QuestionReferencesSection\" IsCollapsed=\"True\" Icon=\"Icons/new/48x48/book_green.gif\"><ix:DetailSection Title=\"Text References\" Icon=\"Icons/new/48x48/edit.gif\"><ix:FieldValue DisplayAs=\"html\" For=\"PubQuestion.Question.TextReferences\" /></ix:DetailSection><ix:DetailSection Title=\"Tags\" Icon=\"Icons/new/48x48/index_add.gif\"><ix:FieldArea><ix:Field CaptionPosition=\"top\" For=\"PubQuestion.Question.References\" Span=\"true\" SpellCheck=\"false\" /></ix:FieldArea></ix:DetailSection><ix:AttachmentSection For=\"PubQuestion.Question\" ID=\"Question_AttachmentFragmentGridSection\"/></ix:DetailSection><ix:GridSection AllowFiltering=\"false\" AllowSorting=\"false\" DisplayEditColumn=\"false\" DisplayMode=\"View,edit\" Entity=\"CLF_QuestionAnswerObject\" ID=\"PreviousdGridSection\" Icon=\"Icons/new/48x48/alarmclock_preferences.gif\" PageSize=\"5\" PageSizeSelector=\"0,5,10,20,30,40,50,100,200,500\" Readonly=\"True\" RowSelectionMode=\"None\" Title=\"Previous Assessment of this Question\" Visible=\"false\"><Sorting><ix:Sort runat=\"server\" By=\"DateModified\" Direction=\"Descending\"/></Sorting><Filters><ix:Filter><ix:CommonPredicate For=\"ChecklistAnswer.LocationId\" Type=\"Equal\"><ix:Value Parse=\"True\">\n<%= Model.ChecklistAnswer.LocationId%>\n</ix:Value></ix:CommonPredicate><ix:CommonPredicate For=\"PubQuestion.QuestionId\" Type=\"Equal\"><ix:Value Parse=\"True\">\n<%= Model.PubQuestion.QuestionId%>\n</ix:Value></ix:CommonPredicate><ix:CommonPredicate For=\"Id\" Type=\"Equal\" Negate=\"true\"><ix:Value Parse=\"True\">\n<%= Model.Id%>\n</ix:Value></ix:CommonPredicate></ix:Filter></Filters><aliases><ix:Alias For=\"Choice.BColor.Value\"/><ix:Alias For=\"Choice.TColor.Value\"/><ix:Alias For=\"Choice.Css\"/></aliases><Columns><ix:Column Caption=\"Audit\" DisplayAs=\"Label\" For=\"ChecklistAnswer\" /><ix:Column Caption=\"Assess by\" DisplayAs=\"Label\" For=\"ModifiedBy\" /><ix:Column Caption=\"Assess on\" For=\"DateModified\" Format=\"d\" /><ix:MergeColumn Caption=\"Answer\" For=\"PubQuestion.AnswerType.Value\"><MappedColumns><ix:TemplateColumn MapValue=\"Choice\" For=\"Choice\"><Template><div style=\"color:<%# Container.ViewData.Eval(\"Choice.TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"Choice.BColor.Value\") %>;<%# Container.ViewData.Eval(\"Choice.Css\") %>\">\n<%# Container.ViewData.Eval(\"Choice\") %>\n</div></Template></ix:TemplateColumn><ix:Column For=\"Date\" Format=\"d\" MapValue=\"Date\" /><ix:Column DisplayAs=\"List\" FetchAs=\"collection\" For=\"Choices\" MapValue=\"Choices\" /><ix:Column For=\"Float\" HorizontalAlign=\"right\" MapValue=\"Float\" /><ix:Column For=\"Text\" MapValue=\"Text\" /><ix:Column For=\"Checkbox\" MapValue=\"Checkbox\" /></MappedColumns></ix:MergeColumn><ix:Column For=\"Comments\" /></Columns></ix:GridSection><ix:DetailSection Title=\"Answer\" Icon=\"Icons/new/48x48/about.gif\"><ix:FieldArea><ix:Field Caption=\"Answer\" For=\"Choice\" Span=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Answer\" For=\"Text\" Span=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Answer\" For=\"Float\" Span=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Answer\" For=\"Date\" Span=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Answer\" For=\"Checkbox\" Span=\"true\" SpellCheck=\"false\" /><ix:Field Caption=\"Answer\" For=\"Choices\" Span=\"true\" SpellCheck=\"false\" /><ix:Field For=\"Comments\" Span=\"true\" /></ix:FieldArea></ix:DetailSection><ix:TabsSection Title=\"Private Document Attachment\" ShowHeader=\"true\" Icon=\"Icons/new/48x48/folder_up.gif\"><ix:Tab Caption=\"Upload\"><ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" Title=\"Upload images\" CssClass=\"HideBorders\" isCollapsed=\"false\" UseCookies=\"false\"/></ix:Tab><ix:Tab Caption=\"Image Preview\" DisplayMode=\"View,Edit\"><ix:GridPanel Entity=\"DocDocumentAttachmentsEntity\" isCollapsed=\"false\" UseCookies=\"false\" ShowColumnCaptions=\"false\" AllowPaging=\"false\" AllowFiltering=\"false\" AllowSorting=\"false\" RowSelectionMode=\"None\" Readonly=\"True\" DisplayMode=\"View,Edit\" DisplayEditColumn=\"false\" CssClass=\"HideBorders\"><Filters><ix:Filter><ix:CommonPredicate For=\"ObjectRecordId\" Type=\"Equal\"><ix:Value Parse=\"True\">\n<%= Model.Id %>\n</ix:Value></ix:CommonPredicate></ix:Filter><ix:Filter PredicateOperator=\"or\"><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>\n.png\n</ix:Value></ix:LikePredicate><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>\n.jpg\n</ix:Value></ix:LikePredicate><ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\"><ix:Value>\n.gif\n</ix:Value></ix:LikePredicate></ix:Filter></Filters><aliases><ix:Alias For=\"Id\"/><ix:Alias For=\"AttachmentName\"/></aliases><columns><ix:TemplateColumn><template><div class=\"imagepreview\" title=\"<%# Container.ViewData.Eval(\"AttachmentName\") %>\" style=\"background-image:url(&apos;<%= HttpEnvironment.SystemApplicationPath %>/intelexforms/attachmentsection/downloadfile?recordid=<%# Container.ViewData.Eval(\"Id\") %>&apos;)\"/></template></ix:TemplateColumn></columns></ix:GridPanel></ix:Tab></ix:TabsSection><ix:GridSection DisplayMode=\"View,Edit\" For=\"Findings\" ID=\"FindingsGridSection\"><Menu><ix:GridAttachActionLink Override=\"true\" LinkTo=\"CLF_Finding_Select/Index\" Caption=\"Attach Existing Finding\"/><ix:GridCreateActionLink Override=\"true\" LinkTo=\"CLF_Finding_Detail/Create?ChecklistAnswer={#ChecklistAnswerId}\" Caption=\"Create &amp; Attach a new Finding\" OpenIn=\"popup\"/><ix:GridDetachActionLink Override=\"true\" Visible=\"false\"/><ix:GridDetachActionLink Override=\"false\" Caption=\"Detach\"/><ix:GridListAllActionLink Override=\"true\" Visible=\"false\"/><ix:GridListAllActionLink Override=\"false\" Visible=\"True\"/></Menu><aliases><ix:Alias For=\"Severity.BackgroundColor.Value\" Name=\"BC\"/><ix:Alias For=\"Severity.TextColor.Value\" Name=\"TC\"/><ix:Alias For=\"Severity.CSS\" Name=\"CSS\"/><ix:Alias For=\"FindingStatus.TC.Value\" Name=\"StatusTC\"/><ix:Alias For=\"FindingStatus.BC.Value\" Name=\"StatusBC\"/></aliases><Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column DisplayAs=\"truncate\" For=\"Description\" /><ix:TemplateColumn For=\"Severity\" FilterAs=\"Dropdown\"><template><div style=\"background-color:<%# Container.ViewData.Eval(\"BC\") %>;text:<%# Container.ViewData.Eval(\"TC\") %>;<%# Container.ViewData.Eval(\"CSS\") %>\">\n<%# Container.ViewData.Eval(\"Severity\") %>\n</div></template></ix:TemplateColumn><ix:Column For=\"ResponseDue\" Format=\"d\" /><ix:Column For=\"PersResponsible\" /><ix:TemplateColumn For=\"FindingStatus\" FilterAs=\"dropdown\" HorizontalAlign=\"center\"><Template><div style=\"background-color:<%# Container.ViewData.Eval(\"StatusBC\") %>;color:<%# Container.ViewData.Eval(\"StatusTC\") %>\">\n<%# Container.ViewData.Eval(\"FindingStatus\") %>\n</div></Template></ix:TemplateColumn><ix:TemplateColumn For=\"NbAPs\" Caption=\"Add Action Plans\" HorizontalAlign=\"center\" width=\"20px\" AllowFiltering=\"false\" AllowSorting=\"false\"><Template><a title=\"Create &amp; Attach a new Action Plan\" class=\"openInPopup\" href=\"<%= HttpEnvironment.SystemApplicationPath %>/Forms/CLF_InsActionPlan_Detail/Create?ChecklistAnswer=<%# Model.ChecklistAnswerId %>&amp;RelatedId=<%# Container.ViewData.Eval(\"Id\") %>&amp;RelatedPath=CLF_FindingObject.ActionPlans\"><img src=\"<%= ImageHelper.GetVersionedPath(\"Grid/add.png\") %>\"/></a></Template></ix:TemplateColumn><ix:Column Caption=\"Attached Action Plans\" DisplayAs=\"List\" EditMode=\"popup\" FetchAs=\"Collection\" For=\"ActionPlans\" RefreshScope=\"row\" /></Columns></ix:GridSection></ix:DetailPage><style>\n.HideBorders > .header {\n    display: none;\n}\n\n.HideBorders > .footer {\n    display: none;\n}\n\n.HideBorders > .content {\n    border: medium none;\n    padding: 0;\n}\n\n.imagepreview {\nbackground-repeat:no-repeat;\nmax-width:500px;\nmin-height:300px;\nbackground-size:contain;\n}\n</style>",
