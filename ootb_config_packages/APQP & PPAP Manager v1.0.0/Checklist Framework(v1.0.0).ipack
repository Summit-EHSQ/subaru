      },
      {
        "$id": "152",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "e95f18e6-5617-425b-b244-6919b1085ea2",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "153",
          "Walkthroughs": null,
          "Id": "e95f18e6-5617-425b-b244-6919b1085ea2",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailSection Title=\"Audit (Single Checklist)\" Icon=\"Icons/new/48x48/clipboard_empty.gif\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Location\" EditAs=\"EntitySelector\" DisplayMode=\"Create\"/>\r\n<ix:Field For=\"Location\" DisplayAs=\"Label\" DisplayMode=\"View,Edit\" Readonly=\"true\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"RecordNo\"/>\r\n<ix:Field For=\"Name\" EditAs=\"textbox\" IsMandatory=\"true\"/>\r\n<ix:Field For=\"Comments\"/>\r\n<ix:Field For=\"PubChecklist\" DisplayMode=\"Create\" IsMandatory=\"true\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection ID=\"QuestionAnswersGridSection\" For=\"QuestionAnswers\" DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" RefreshScope=\"Row\" HideGroupAddButton=\"true\" Title=\"{#PubChecklist}\" AllowSorting=\"false\">\r\n    <Actions>\r\n<ix:MassUpdateAction ViewName=\"CLF_QuestionAnswer_MassUpdate\"/>\r\n    </Actions>\r\n    <menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n    </menu>\r\n    <Sorting>\r\n<ix:Sort By=\"PubQuestion.Order\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <grouping>\r\n<ix:Group By=\"PubQuestion.Section\"/>\r\n    </grouping>\r\n    <aliases>\r\n<ix:Alias For=\"PubQuestion.QuestionRef\"/>\r\n<ix:Alias For=\"PubQuestion.Guideline\"/>\r\n<ix:Alias For=\"PubQuestion.Id\"/>\r\n<ix:Alias For=\"ChecklistAnswerId\"/>\r\n<ix:Alias For=\"Choice.BColor.Value\"/>\r\n<ix:Alias For=\"Choice.TColor.Value\"/>\r\n<ix:Alias For=\"Id\"/>\r\n    </aliases>\r\n    <Columns>\r\n      <ix:TemplateColumn For=\"PubQuestion.Content\" Width=\"1\">\r\n        <Template>\r\n          <span style=\"font-weight:bold;\">\r\n<%# Container.ViewData.Eval(\"PubQuestion.QuestionRef\") %> <%# Container.ViewData.Eval(\"PubQuestion.Content\") %>\r\n          </span>\r\n          <div class=\"fieldHint\">\r\n<%# Container.ViewData.Eval(\"PubQuestion.Guideline\") %>\r\n          </div>\r\n        </Template>\r\n      </ix:TemplateColumn>\r\n<ix:Column For=\"PubQuestion.Question.References\" FetchAs=\"Collection\" DisplayAs=\"List\" Visible=\"false\"/>\r\n      <ix:MergeColumn Caption=\"Answer\" For=\"PubQuestion.AnswerType.Value\" EditMode=\"popup\" RefreshScope=\"Row\">\r\n        <MappedColumns>\r\n          <ix:TemplateColumn MapValue=\"Choice_Disable\" For=\"Choice\" EditMode=\"inline\">\r\n            <Template>\r\n              <div style=\"color:<%# Container.ViewData.Eval(\"Choice.TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"Choice.BColor.Value\") %>;<%# Container.ViewData.Eval(\"Choice.Css\") %>\">\r\n<%# Container.ViewData.Eval(\"Choice\") %>\r\n              </div>\r\n            </Template>\r\n          </ix:TemplateColumn>\r\n<ix:Column MapValue=\"Choice\" For=\"Choice\" EditMode=\"inline\"/>\r\n<ix:Column MapValue=\"Date\" For=\"Date\" EditMode=\"inline\" Format=\"d\"/>\r\n<ix:Column MapValue=\"Choices\" For=\"Choices\" FetchAs=\"collection\" DisplayAs=\"List\" EditMode=\"popup\"/>\r\n<ix:Column MapValue=\"Float\" For=\"Float\" EditMode=\"inline\" HorizontalAlign=\"right\"/>\r\n<ix:Column MapValue=\"Text\" For=\"Text\" EditMode=\"popup\"/>\r\n<ix:Column MapValue=\"Checkbox\" For=\"Checkbox\" EditMode=\"inline\"/>\r\n        </MappedColumns>\r\n      </ix:MergeColumn>\r\n<ix:Column For=\"Comments\" EditMode=\"popup\" RefreshScope=\"Row\"/>\r\n<ix:Column For=\"NumbofDocuments\" LinkTo=\"CLF_QuestionAnswer_Docs/View?entityid={#id}\" LinkTarget=\"popup\" RefreshScope=\"Row\" Caption=\"#Docs\" HorizontalAlign=\"center\"/>\r\n      <ix:TemplateColumn For=\"NbFindings\" Caption=\"Add\" HorizontalAlign=\"center\" width=\"20px\" AllowFiltering=\"false\" AllowSorting=\"false\">\r\n        <Template>\r\n          <a title=\"Create &amp; Attach a new Finding\" class=\"openInPopup\" href=\"<%= HttpEnvironment.SystemApplicationPath %>/Forms/CLF_Finding_Detail/Create?ChecklistAnswer=<%# Container.ViewData.Eval(\"ChecklistAnswerId\") %>&amp;RelatedId=<%# Container.ViewData.Eval(\"Id\") %>&amp;RelatedPath=CLF_QuestionAnswerObject.Findings\">\r\n            <img src=\"<%= ImageHelper.GetVersionedPath(\"Grid/add.png\") %>\"/>\r\n            </a>\r\n          </Template>\r\n        </ix:TemplateColumn>\r\n<ix:Column Caption=\"Attached Findings\" DisplayAs=\"List\" EditMode=\"popup\" FetchAs=\"Collection\" For=\"Findings\" RefreshScope=\"row\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n    <ix:GridSection ID=\"FindingsGridSection\" For=\"Findings\" DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" RefreshScope=\"Row\" Title=\"Finding Summary\">\r\n      <menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"true\" OpenIn=\"popup\"/>\r\n      </menu>\r\n      <Sorting>\r\n<ix:Sort By=\"RecordNo\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <aliases>\r\n<ix:Alias For=\"Id\"/>\r\n      </aliases>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Description\" Truncate=\"true\"/>\r\n<ix:Column For=\"ResponseDue\" Format=\"d\"/>\r\n      </Columns>\r\n    </ix:GridSection>\r\n<ix:WorkflowComments DisplayMode=\"View\" IsCollapsed=\"true\"/>\r\n<ix:WorkflowTracking DisplayMode=\"View\" IsCollapsed=\"true\"/>\r\n<ix:ESignatureHistorySection DisplayMode=\"View\" IsCollapsed=\"true\"/>\r\n<ix:MailMergeTemplates ID=\"MailMergeFragmentGridSection\" DisplayMode=\"View\" IsCollapsed=\"true\"/>\r\n  </ix:DetailPage>\r\n  <style>\r\n.data_row td.wrap {\r\n    white-space: normal !important;\r\n}\r\n  </style>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_SingleChecklist_Detail",
          "Path": "CLF_SingleChecklist_Detail",
          "Type": 0
        },
        "LocalizationData": null,
        "Id": "499ad4ee-0637-4e2b-97fb-2f4f1bd879b0",
        "Caption": "CLF_SingleChecklist_Detail",
        "Type": "Configurable View",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
