      {
        "$id": "229",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "bd2330ab-913e-4bb6-b748-b629e7be26dd",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "230",
          "Walkthroughs": null,
          "Id": "bd2330ab-913e-4bb6-b748-b629e7be26dd",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailPageMenuBar ID=\"DetailPageMenuBar\">\r\n<ix:CloneActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:EditActionLink Override=\"true\" Visible=\"False\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:StageContainer UseDefaultDuringCreate=\"True\" VisibleFor=\"Draft\" ID=\"StageContainer_Draft\">\r\n    <ix:DetailSection Title=\"Action Plan\" Icon=\"Icons/new/48x48/check2.gif\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ChecklistAnswer\" Caption=\"Inspection\" Readonly=\"true\" Span=\"true\"/>\r\n<ix:Field For=\"CPARTypeID\"/>\r\n<ix:Field For=\"CPARActionReq\" IsMandatory=\"True\" Span=\"true\"/>\r\n<ix:Field For=\"ActionOwner\"/>\r\n<ix:Field For=\"DueDate\" IsMandatory=\"True\" SpellCheck=\"false\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n    <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View,Edit\" For=\"Findings\" ID=\"FindingsGridSection_Draft\" IsCollapsed=\"True\">\r\n      <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" LinkTo=\"CLF_Finding_Select/Index\" Caption=\"Attach Findings\"/>\r\n<ix:GridDetachActionLink Override=\"true\" Caption=\"Detach\"/>\r\n      </Menu>\r\n      <aliases>\r\n<ix:Alias For=\"Severity.BackgroundColor.Value\" Name=\"BC\"/>\r\n<ix:Alias For=\"Severity.TextColor.Value\" Name=\"TC\"/>\r\n<ix:Alias For=\"Severity.CSS\" Name=\"CSS\"/>\r\n<ix:Alias For=\"FindingStatus.TC.Value\" Name=\"StatusTC\"/>\r\n<ix:Alias For=\"FindingStatus.BC.Value\" Name=\"StatusBC\"/>\r\n      </aliases>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\" LinkTo=\"CLF_Finding_Detail_Readonly/View?entityid={#Id}\"/>\r\n<ix:Column DisplayAs=\"truncate\" For=\"Description\"/>\r\n        <ix:TemplateColumn For=\"Severity\" FilterAs=\"Dropdown\">\r\n          <template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"BC\") %>;color:<%# Container.ViewData.Eval(\"TC\") %>;<%# Container.ViewData.Eval(\"CSS\") %>\">\r\n<%# Container.ViewData.Eval(\"Severity\") %>\r\n            </div>\r\n          </template>\r\n        </ix:TemplateColumn>\r\n<ix:Column Caption=\"Suggested Action Plan\" For=\"ImmediateAction\"/>\r\n<ix:Column For=\"ResponseDue\" Format=\"d\"/>\r\n        <ix:TemplateColumn For=\"FindingStatus\" FilterAs=\"dropdown\" HorizontalAlign=\"center\">\r\n          <Template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"StatusBC\") %>;color:<%# Container.ViewData.Eval(\"StatusTC\") %>\">\r\n<%# Container.ViewData.Eval(\"FindingStatus\") %>\r\n            </div>\r\n          </Template>\r\n        </ix:TemplateColumn>\r\n      </Columns>\r\n    </ix:GridSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer VisibleFor=\"InProgress\" ID=\"StageContainer_InProgress\">\r\n    <ix:DetailSection Title=\"Action Plan\" Icon=\"Icons/new/48x48/check2.gif\">\r\n      <ix:FieldArea>\r\n<ix:Field For=\"ChecklistAnswer\" Caption=\"Inspection\" Readonly=\"true\" Span=\"true\"/>\r\n<ix:Field For=\"CPARTypeID\" Readonly=\"true\"/>\r\n<ix:Field For=\"CPARActionReq\" Readonly=\"True\" Span=\"true\" SpellCheck=\"false\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n    <ix:DetailSection Title=\"Completion\" Icon=\"Icons/new/48x48/checks.gif\" DisplayMode=\"View,Edit\">\r\n      <ix:FieldArea>\r\n<ix:Field For=\"CompletedBy\"/>\r\n<ix:Field For=\"CompletionDate\"/>\r\n<ix:Field For=\"CompletionNotes\" Span=\"true\" SpellCheck=\"false\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n    <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View,Edit\" For=\"Findings\" ID=\"FindingsGridSection_Inprogress\" IsCollapsed=\"True\" Readonly=\"True\">\r\n      <aliases>\r\n<ix:Alias For=\"Severity.BackgroundColor.Value\" Name=\"BC\"/>\r\n<ix:Alias For=\"Severity.TextColor.Value\" Name=\"TC\"/>\r\n<ix:Alias For=\"Severity.CSS\" Name=\"CSS\"/>\r\n<ix:Alias For=\"FindingStatus.TC.Value\" Name=\"StatusTC\"/>\r\n<ix:Alias For=\"FindingStatus.BC.Value\" Name=\"StatusBC\"/>\r\n      </aliases>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\"/>\r\n<ix:Column DisplayAs=\"truncate\" For=\"Description\"/>\r\n        <ix:TemplateColumn For=\"Severity\" FilterAs=\"Dropdown\">\r\n          <template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"BC\") %>;color:<%# Container.ViewData.Eval(\"TC\") %>;<%# Container.ViewData.Eval(\"CSS\") %>\">\r\n<%# Container.ViewData.Eval(\"Severity\") %>\r\n            </div>\r\n          </template>\r\n        </ix:TemplateColumn>\r\n<ix:Column Caption=\"Suggested Action Plan\" For=\"ImmediateAction\"/>\r\n<ix:Column For=\"ResponseDue\" Format=\"d\"/>\r\n        <ix:TemplateColumn For=\"FindingStatus\" FilterAs=\"dropdown\" HorizontalAlign=\"center\">\r\n          <Template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"StatusBC\") %>;color:<%# Container.ViewData.Eval(\"StatusTC\") %>\">\r\n<%# Container.ViewData.Eval(\"FindingStatus\") %>\r\n            </div>\r\n          </Template>\r\n        </ix:TemplateColumn>\r\n      </Columns>\r\n    </ix:GridSection>\r\n  </ix:StageContainer>\r\n  <ix:StageContainer UseDefaultWhenCompleted=\"True\" ID=\"StageContainer_Completed\">\r\n    <ix:DetailSection Title=\"Action Plan\" Icon=\"Icons/new/48x48/check2.gif\">\r\n      <ix:FieldArea>\r\n<ix:Field For=\"ChecklistAnswer\" Caption=\"Inspection\" Readonly=\"true\" Span=\"true\"/>\r\n<ix:Field For=\"CPARTypeID\" Readonly=\"True\"/>\r\n<ix:Field For=\"CPARActionReq\" Readonly=\"True\" Span=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"ActionOwner\" Readonly=\"True\"/>\r\n<ix:Field For=\"DueDate\" Readonly=\"True\"/>\r\n      </ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n    </ix:DetailSection>\r\n    <ix:DetailSection Title=\"Completion\" Icon=\"Icons/new/48x48/checks.gif\" DisplayMode=\"View,Edit\">\r\n      <ix:FieldArea>\r\n<ix:Field For=\"CompletedBy\" Readonly=\"True\"/>\r\n<ix:Field For=\"CompletionDate\" Readonly=\"True\"/>\r\n<ix:Field For=\"CompletionNotes\" Span=\"true\" Readonly=\"True\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n    <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View,Edit\" For=\"Findings\" ID=\"FindingsGridSection_Completed\" IsCollapsed=\"True\" Readonly=\"True\">\r\n      <aliases>\r\n<ix:Alias For=\"Severity.BackgroundColor.Value\" Name=\"BC\"/>\r\n<ix:Alias For=\"Severity.TextColor.Value\" Name=\"TC\"/>\r\n<ix:Alias For=\"Severity.CSS\" Name=\"CSS\"/>\r\n<ix:Alias For=\"FindingStatus.TC.Value\" Name=\"StatusTC\"/>\r\n<ix:Alias For=\"FindingStatus.BC.Value\" Name=\"StatusBC\"/>\r\n      </aliases>\r\n      <Columns>\r\n<ix:Column For=\"RecordNo\"/>\r\n<ix:Column DisplayAs=\"truncate\" For=\"Description\"/>\r\n        <ix:TemplateColumn For=\"Severity\" FilterAs=\"Dropdown\">\r\n          <template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"BC\") %>;color:<%# Container.ViewData.Eval(\"TC\") %>;<%# Container.ViewData.Eval(\"CSS\") %>\">\r\n<%# Container.ViewData.Eval(\"Severity\") %>\r\n            </div>\r\n          </template>\r\n        </ix:TemplateColumn>\r\n<ix:Column Caption=\"Suggested Action Plan\" For=\"ImmediateAction\"/>\r\n<ix:Column For=\"ResponseDue\" Format=\"d\"/>\r\n        <ix:TemplateColumn For=\"FindingStatus\" FilterAs=\"dropdown\" HorizontalAlign=\"center\">\r\n          <Template>\r\n            <div style=\"background-color:<%# Container.ViewData.Eval(\"StatusBC\") %>;color:<%# Container.ViewData.Eval(\"StatusTC\") %>\">\r\n<%# Container.ViewData.Eval(\"FindingStatus\") %>\r\n            </div>\r\n          </Template>\r\n        </ix:TemplateColumn>\r\n      </Columns>\r\n    </ix:GridSection>\r\n  </ix:StageContainer>\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" DisplayMode=\"edit,view\"/>\r\n<ix:WorkflowComments IsCollapsed=\"true\"/>\r\n<ix:ESignatureHistorySection DisplayMode=\"View\" isCollapsed=\"True\" UseCookies=\"false\"/>\r\n</ix:DetailPage>",
