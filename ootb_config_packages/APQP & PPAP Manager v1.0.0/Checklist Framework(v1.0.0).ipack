        ],
        "RequiresUomSystemProperties": false,
        "RecordId": "9eb5b820-84e7-459d-a736-062bf1637ac3",
        "ObjectName": "MetSimplePropertyEntity",
        "FieldData": {
          "$id": "502",
          "DefaultUnitOfMeasure": null,
          "ValidationRules": null,
          "EditPermission": null,
          "ViewPermission": null,
          "Id": "9eb5b820-84e7-459d-a736-062bf1637ac3",
          "DetailDisplayFormat": null,
          "DetailEditMask": null,
          "FieldName": "FilledQuestions",
          "InventoryDisplayFormat": null,
          "InventoryEditMask": null,
          "IsLocalizable": false,
          "MaxLength": null,
          "MaxValue": null,
          "MinLength": null,
          "MinValue": null,
          "Precision": null,
          "Scale": null,
          "Calculation": "<?xml version=\"1.0\" encoding=\"utf-16\"?><CalculationBase xmlns:i=\"http://www.w3.org/2001/XMLSchema-instance\" i:type=\"XScriptExpressionCalculation\" xmlns=\"http://schemas.intelex.net\"><Expression>SUM(QuestionAnswers.IsFilled) + SUM(SubChecklists.FilledQuestions)</Expression></CalculationBase>",
          "Caption": "# Filled Questions",
          "Category": null,
          "DefaultValue": null,
          "Description": "On Question Answer, there is Field called IsFilled. It contains an expression that set it to 1 or 0. That expression can be changed with configuration.\r\nAt the Checklist answer level, this field is meant to Count the number of Question Answer currently considered as \"Filled\".\r\nThe expression grab data from directly attached Question Answer Records as well as from Sub-Checklists.\r\n\r\nIt is not recommended to change this expression.",
          "DetailDisplayAs": null,
          "DetailEditAs": null,
          "DetailEmptyText": null,
          "Hint": null,
          "InventoryDisplayAs": null,
          "InventoryEditAs": null,
          "InventoryEmptyText": null,
          "IsAvailableForReporting": true,
          "IsPrimaryKey": false,
          "IsReadOnly": true,
          "IsRequired": false,
          "IsStatic": false,
          "IsSystem": false,
