          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\n  <ix:DetailSection Title=\"Checklist Type Definition\" Icon=\"Icons/new/48x48/clipboard_empty.gif\">\n    <ix:FieldArea Span=\"true\">\n<ix:Field For=\"Reference\"/>\n<ix:Field For=\"Name\" SpellCheck=\"false\"/>\n<ix:Field For=\"Description\"/>\n    </ix:FieldArea>\n  </ix:DetailSection>\n  <ix:GridSection DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" For=\"Checklists\" ID=\"ChecklistsGridSection\" RefreshScope=\"Row\">\n    <Menu>\n<ix:GridCreateActionLink runat=\"server\" Override=\"true\" OpenIn=\"popup\"/>\n    </Menu>\n    <Actions>\n<ix:MassUpdateAction ViewName=\"CLF_Checklist_MassUpdate\"/>\n    </Actions>\n    <Columns>\n<ix:Column EditMode=\"inline\" For=\"Reference\" LinkTo=\"default\" RefreshScope=\"Row\"/>\n<ix:Column EditMode=\"inline\" For=\"Title\" RefreshScope=\"Row\"/>\n<ix:Column DisplayAs=\"Truncate\" EditMode=\"inline\" For=\"Description\" RefreshScope=\"Row\"/>\n<ix:Column For=\"NbQuestions\" HorizontalAlign=\"center\"/>\n    </Columns>\n  </ix:GridSection>\n  <ix:GridSection DisplayMode=\"Edit,View\" EditLinkTarget=\"popup\" For=\"Questions\" ID=\"QuestionsGridSection\" RefreshScope=\"Row\">\n    <Menu>\n<ix:GridCreateActionLink runat=\"server\" Override=\"true\" OpenIn=\"popup\"/>\n    </Menu>\n    <Actions>\n<ix:MassUpdateAction ViewName=\"CLF_QuestObjectDetailView_MassUpdate\"/>\n    </Actions>\n    <Sorting>\n<ix:Sort runat=\"server\" By=\"Order\" Direction=\"Ascending\"/>\n    </Sorting>\n    <grouping>\n<ix:Group By=\"Section\"/>\n    </grouping>\n    <Columns>\n<ix:Column EditMode=\"inline\" For=\"QuestionRef\" LinkTo=\"default\" RefreshScope=\"Row\"/>\n<ix:Column DisplayAs=\"Truncate\" EditMode=\"inline\" For=\"Content\" RefreshScope=\"Row\"/>\n<ix:Column EditMode=\"inline\" FilterAs=\"Dropdown\" For=\"AnswerType\" RefreshScope=\"Row\"/>\n<ix:Column EditMode=\"inline\" FilterAs=\"Dropdown\" For=\"ChoiceList\" RefreshScope=\"Row\"/>\n<ix:Column EditMode=\"inline\" For=\"Order\"/>\n    </Columns>\n  </ix:GridSection>\n</ix:DetailPage>",
          "IsParsedForMobile": false,
