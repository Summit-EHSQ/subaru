      {
        "$id": "723",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "c5de9527-0aed-4c33-b4c8-fe049a8ac0e9",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "724",
          "Walkthroughs": null,
          "Id": "c5de9527-0aed-4c33-b4c8-fe049a8ac0e9",
          "Caption": null,
          "ConfigurableViewActions": "[{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Show Manual Close Comment\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"ManualClose\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"true\"}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"ManCloseCom\",\"elementType\":0}]},{\"__type\":\"SetNonMandatoryAction\",\"elements\":[{\"elementId\":\"ManCloseCom\",\"elementType\":0}]},{\"__type\":\"ClearValueAction\",\"elements\":[{\"elementId\":\"ManCloseCom\",\"elementType\":0}]},{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"ActionPlanGridSection\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"ManCloseCom\",\"elementType\":0}]},{\"__type\":\"SetMandatoryAction\",\"elements\":[{\"elementId\":\"ManCloseCom\",\"elementType\":0}]},{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"ActionPlanGridSection\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"ManualClose\"}]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Show \\/ Hide Stuff depending on Status\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":\"A OR B\",\"predicates\":[{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"FindingStatus.Code\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"Open\"}},{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"FindingStatus.Code\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"Closed without Action\"}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"ManualCloseSection\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"ManualCloseSection\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"FindingStatus.Code\"}]}]",
          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\">\r\n<ix:CloneActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:SecurityActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:EditActionLink Override=\"true\" Visible=\"False\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:DetailSection Title=\"Finding Details\" Icon=\"Icons/new/48x48/flag_red.gif\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ChecklistAnswer\" Readonly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"FindingStatus.Code\" Caption=\"Finding Status\"/>\r\n<ix:Field EditAs=\"radiogroup\" For=\"Severity\" Readonly=\"True\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"Description\" Readonly=\"True\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"PersResponsible\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"Create\" For=\"DueIn\" Readonly=\"True\"/>\r\n<ix:Field DisplayMode=\"View,Edit\" For=\"ResponseDue\" Readonly=\"True\"/>\r\n<ix:Field Caption=\"Suggested Action Plan\" For=\"ImmediateAction\" Readonly=\"True\" SpellCheck=\"false\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View,Edit\" For=\"QuestionAnswers\" HideGroupAddButton=\"true\" ID=\"QuestionAnswersGridSection\" IsCollapsed=\"True\" RowSelectionMode=\"None\" UseCookies=\"false\">\r\n    <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:GridDetachActionLink Override=\"true\" Visible=\"False\"/>\r\n    </Menu>\r\n    <Sorting>\r\n<ix:Sort By=\"PubQuestion.Order\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <grouping>\r\n<ix:Group By=\"PubQuestion.Section\"/>\r\n    </grouping>\r\n    <aliases>\r\n<ix:Alias For=\"ChecklistAnswerId\"/>\r\n<ix:Alias For=\"PubQuestion.Guideline\"/>\r\n<ix:Alias For=\"PubQuestion.Id\"/>\r\n<ix:Alias For=\"Choice.BColor.Value\"/>\r\n<ix:Alias For=\"Choice.TColor.Value\"/>\r\n<ix:Alias For=\"Choice.Css\"/>\r\n    </aliases>\r\n    <Columns>\r\n      <ix:TemplateColumn For=\"PubQuestion.Content\" Width=\"1\">\r\n        <Template>\r\n          <span style=\"font-weight:bold;\">\r\n<%# Container.ViewData.Eval(\"PubQuestion.QuestionRef\") %> <%# Container.ViewData.Eval(\"PubQuestion.Content\") %>\r\n          </span>\r\n          <div class=\"fieldHint\">\r\n<%# Container.ViewData.Eval(\"PubQuestion.Guideline\") %>\r\n          </div>\r\n        </Template>\r\n      </ix:TemplateColumn>\r\n      <ix:MergeColumn Caption=\"Answer\" For=\"PubQuestion.AnswerType.Value\">\r\n        <MappedColumns>\r\n          <ix:TemplateColumn MapValue=\"Choice_Disable\" For=\"Choice\">\r\n            <Template>\r\n              <div style=\"color:<%# Container.ViewData.Eval(\"Choice.TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"Choice.BColor.Value\") %>;<%# Container.ViewData.Eval(\"Choice.Css\") %>\">\r\n<%# Container.ViewData.Eval(\"Choice\") %>\r\n              </div>\r\n            </Template>\r\n          </ix:TemplateColumn>\r\n<ix:Column For=\"Choice\" MapValue=\"Choice\" /><ix:Column For=\"Date\" Format=\"d\" MapValue=\"Date\" /><ix:Column DisplayAs=\"List\" FetchAs=\"collection\" For=\"Choices\" MapValue=\"Choices\" /><ix:Column For=\"Float\" HorizontalAlign=\"right\" MapValue=\"Float\" /><ix:Column For=\"Text\" MapValue=\"Text\" /><ix:Column For=\"Checkbox\" MapValue=\"Checkbox\" />\r\n        </MappedColumns>\r\n      </ix:MergeColumn>\r\n<ix:Column For=\"Comments\" /><ix:Column Caption=\"#Docs\" For=\"NumbofDocuments\" HorizontalAlign=\"center\" LinkTarget=\"popup\" LinkTo=\"CLF_QuestionAnswer_Docs_Readonly/View?entityid={#id}\" /></Columns></ix:GridSection>\r\n  <ix:TabsSection Title=\"Evidence\" ShowHeader=\"true\" Icon=\"Icons/new/48x48/folder_up.gif\">\r\n    <ix:Tab Caption=\"Upload\">\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" Title=\"Upload images\" CssClass=\"HideBorders\" isCollapsed=\"false\" UseCookies=\"false\" Readonly=\"true\"/>\r\n    </ix:Tab>\r\n    <ix:Tab Caption=\"Image Preview\" DisplayMode=\"View,Edit\">\r\n      <ix:GridPanel Entity=\"DocDocumentAttachmentsEntity\" isCollapsed=\"false\" UseCookies=\"false\" ShowColumnCaptions=\"false\" AllowPaging=\"false\" AllowFiltering=\"false\" AllowSorting=\"false\" RowSelectionMode=\"None\" Readonly=\"True\" DisplayMode=\"View,Edit\" DisplayEditColumn=\"false\" CssClass=\"HideBorders\">\r\n        <Filters>\r\n          <ix:Filter>\r\n            <ix:CommonPredicate For=\"ObjectRecordId\" Type=\"Equal\">\r\n              <ix:Value Parse=\"True\">\r\n393ae517-3ae2-43db-b379-cce30d4eed0e\r\n              </ix:Value>\r\n            </ix:CommonPredicate>\r\n          </ix:Filter>\r\n          <ix:Filter PredicateOperator=\"or\">\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.png\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.jpg\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.gif\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n          </ix:Filter>\r\n        </Filters>\r\n        <aliases>\r\n<ix:Alias For=\"Id\"/>\r\n<ix:Alias For=\"AttachmentName\"/>\r\n        </aliases>\r\n        <columns>\r\n          <ix:TemplateColumn>\r\n            <template>\r\n<div class=\"imagepreview\" title=\"895cb0b6-1b10-4e16-8fb6-758d3c72f4b3\" style=\"background-image:url(&apos;ae537e49-2ee4-4958-ae39-f7f8e666b043/intelexforms/attachmentsection/downloadfile?recordid=fe0f7cf7-43d0-4dca-87ed-14b8a1086c36&apos;)\"/>\r\n            </template>\r\n          </ix:TemplateColumn>\r\n        </columns>\r\n      </ix:GridPanel>\r\n    </ix:Tab>\r\n  </ix:TabsSection>\r\n  <ix:DetailSection Title=\"Close Finding\" Icon=\"Icons/new/48x48/error.gif\" Id=\"ManualCloseSection\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ManualClose\"/>\r\n<ix:Field For=\"ManCloseCom\" SpellCheck=\"false\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View\" For=\"ActionPlans\" Id=\"ActionPlanGridSection\" Title=\"Action Plan Summary\">\r\n    <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:GridDetachActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:GridListAllActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"False\"/>\r\n<ix:GridDetachActionLink Override=\"false\" Visible=\"False\"/>\r\n<ix:GridListAllActionLink Override=\"false\" Visible=\"True\"/>\r\n    </Menu>\r\n    <Sorting>\r\n<ix:Sort By=\"ActionNo\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <Columns><ix:Column For=\"ActionNo\" LinkTarget=\"popup\" LinkTo=\"CLF_InsActionPlan_Detail_NoEdit/View?entityid={#id}\" /><ix:Column DisplayAs=\"Truncate\" For=\"CPARActionReq\" /><ix:Column FilterAs=\"dropdown\" For=\"CPARTypeID\" /><ix:Column DisplayAs=\"Label\" For=\"Workflow.PersonResponsible\" /><ix:Column FOrmat=\"d\" For=\"Workflow.DueDate\" /><ix:Column For=\"CompletedBy\" /><ix:Column FOrmat=\"d\" For=\"CompletionDate\" /><ix:Column For=\"Workflow.Status\" /></Columns></ix:GridSection>\r\n  <ix:WorkflowComments DisplayMode=\"View\" IsCollapsed=\"True\" UseCookies=\"false\"/>\r\n<ix:WorkflowTracking DisplayMode=\"View\" IsCollapsed=\"True\" UseCookies=\"false\"/>\r\n<ix:ESignatureHistorySection DisplayMode=\"View\" IsCollapsed=\"True\" UseCookies=\"false\"/>\r\n</ix:DetailPage>\r\n<style>\r\n.data_row td.wrap {\r\n    white-space: normal !important;\r\n}\r\n\r\n.one-column .group-item {\r\nclear: none !important;\r\n}\r\n.group-item {\r\nfloat: left;\r\nwidth: auto!important;\r\npadding-right:10px;\r\n}\r\n\r\n.group {\r\nborder:none!important;\r\n}\r\n\r\n.HideBorders > .header {\r\n    display: none;\r\n}\r\n\r\n.HideBorders > .footer {\r\n    display: none;\r\n}\r\n\r\n.HideBorders > .content {\r\n    border: medium none;\r\n    padding: 0;\r\n}\r\n\r\n.imagepreview {\r\nbackground-repeat:no-repeat;\r\nmax-width:500px;\r\nmin-height:300px;\r\nbackground-size:contain;\r\n}\r\n</style>",
          "IsParsedForMobile": false,
          "IsPublic": false,
