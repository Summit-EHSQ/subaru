      {
        "$id": "475",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "22e1d276-8cae-4a75-a42c-6ee07af95242",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "476",
          "Walkthroughs": null,
          "Id": "22e1d276-8cae-4a75-a42c-6ee07af95242",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailSection Title=\"Checklist Answer\">\r\n    <ix:FieldArea Span=\"true\"><ix:Field For=\"Name\" /><ix:Field DisplayMode=\"Edit,View\" For=\"PubChecklist\" ReadOnly=\"true\" /><ix:Field For=\"MasterChecklist\" /><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\" /><ix:Field DisplayAs=\"String\" For=\"Location\" /><ix:Field DisplayMode=\"Create\" For=\"PubChecklist\" IsMandatory=\"true\" /><ix:Field For=\"Comments\" /><ix:Field For=\"NbFindings\" /><ix:Field For=\"PrevChecklistId\" /><ix:Field For=\"NbActions\" /><ix:Field For=\"SysteTypeHelper\" /><ix:Field For=\"Depth\" /><ix:Field For=\"NbSubChecklists\" /><ix:Field For=\"Path\" /><ix:Field For=\"DefPersRespFind\" /></ix:FieldArea>\r\n<ix:WorkflowFields/>\r\n  </ix:DetailSection>\r\n  <ix:DetailSection Title=\"Checklist Progress &amp; Scoring\" DisplayMode=\"Edit,View\">\r\n    <ix:FieldArea><ix:Field For=\"PointsAwarded\" /><ix:Field For=\"MaxPoints\" /><ix:Field For=\"FilledQuestions\" /><ix:Field For=\"ApplicQuestions\" /><ix:Field For=\"Progress\" /></ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayMode=\"Edit,View\" For=\"QuestionAnswers\" HideGroupAddButton=\"true\" ID=\"QuestionAnswersGridSection\">\r\n    <grouping>\r\n<ix:Group By=\"PubQuestion.Section\"/>\r\n    </grouping>\r\n    <menu>\r\n<ix:GridCreateActionLink runat=\"server\" Override=\"true\" Visible=\"false\"/>\r\n<ix:GridDeleteActionLink runat=\"server\" Override=\"true\" Visible=\"false\"/>\r\n    </menu>\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"PubQuestion.Order\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <aliases>\r\n<ix:Alias runat=\"server\" For=\"Choice.BColor.Value\"/>\r\n<ix:Alias runat=\"server\" For=\"Choice.TColor.Value\"/>\r\n    </aliases>\r\n    <Columns><ix:Column DisplayAs=\"html\" For=\"PubQuestion.Content\" />\r\n      <ix:TemplateColumn runat=\"server\" For=\"Choice\" EditMode=\"inline\" RefreshScope=\"Row\">\r\n        <Template>\r\n          <div style=\"text-align:center;color:<%# Container.ViewData.Eval(\"Choice.TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"Choice.BColor.Value\") %>;\">\r\n<%# Container.ViewData.Eval(\"Choice\") %>\r\n          </div>\r\n        </Template>\r\n      </ix:TemplateColumn>\r\n<ix:Column EditMode=\"inline\" For=\"Comments\" RefreshScope=\"Row\" /></Columns></ix:GridSection><ix:GridSection DisplayMode=\"Edit,View\" For=\"SubChecklists\" ID=\"SubChecklistsGridSection\">\r\n    <aliases>\r\n<ix:Alias runat=\"server\" For=\"PointsAwarded\"/>\r\n<ix:Alias runat=\"server\" For=\"MaxPoints\"/>\r\n    </aliases>\r\n    <Columns><ix:Column For=\"PubChecklist\" LinkTo=\"default\" /><ix:Column For=\"Comments\" /><ix:Column For=\"FilledQuestions\" /><ix:Column For=\"ApplicQuestions\" /><ix:Column For=\"Progress\" />\r\n      <ix:TemplateColumn runat=\"server\" For=\"Score\">\r\n        <Template>\r\n          <center>\r\n<%# Container.ViewData.Eval(\"PointsAwarded\") %> / <%# Container.ViewData.Eval(\"MaxPoints\") %>\r\n          </center>\r\n        </Template>\r\n      </ix:TemplateColumn>\r\n    </Columns></ix:GridSection><ix:GridSection For=\"Findings\" ID=\"FindingsGridSection\"><Columns><ix:Column For=\"Description\" LinkTo=\"default\" /><ix:Column For=\"Name\" /><ix:Column For=\"QuestionAnswer\" /><ix:Column For=\"RecordNo\" /></Columns></ix:GridSection>\r\n<ix:WorkflowComments/>\r\n<ix:WorkflowTracking/>\r\n<ix:ESignatureHistorySection/>\r\n  <ix:GridSection For=\"ActionPlans\" ID=\"ActionPlansGridSection\"><Columns><ix:Column For=\"ActionNo\" LinkTo=\"default\" /><ix:Column For=\"Activites\" /><ix:Column For=\"ActivitiesStart\" /><ix:Column For=\"ActivitProgress\" /><ix:Column For=\"ActualCost\" /></Columns></ix:GridSection></ix:DetailPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_ChecklistAnswer_Detail",
          "Path": "CLF_ChecklistAnswerObjectDetailView",
          "Type": 0
        },
