        "FieldData": {
          "$id": "41",
          "Id": "d44fbc81-a83e-4b38-8382-ac0733d13bda",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"CLF_ChoicesList_Inventory\">\r\n    <ix:InventoryView ID=\"CLF_ChoicesList_InventoryView\" Caption=\"Choice List\">\r\n      <Columns>\r\n<ix:Column For=\"Reference\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Name\"/>\r\n<ix:Column For=\"Description\" Width=\"1\"/>\r\n<ix:Column For=\"NbChoices\" HorizontalAlign=\"center\"/>\r\n<ix:Column For=\"MaxPoints\" HorizontalAlign=\"center\"/>\r\n      </Columns>\r\n    </ix:InventoryView>\r\n  </ix:Inventory>\r\n</ix:InventoryPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_ChoicesList_Inventory",
          "Path": "CLF_ChoicesList_Inventory",
          "Type": 1
        },
        "LocalizationData": null,
