          "Caption": null,
          "ConfigurableViewActions": "[{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Show\\/Hide Choice List\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":\"(A OR B)\",\"predicates\":[{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"AnswerType\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"771916e1-5251-4658-add8-3091457e7295\"}},{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"AnswerType\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"93ab1484-09ce-4868-9618-bfa62ea0b01c\"}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"ChoiceList\",\"elementType\":0}]},{\"__type\":\"SetNonMandatoryAction\",\"elements\":[{\"elementId\":\"ChoiceList\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"ChoiceList\",\"elementType\":0}]},{\"__type\":\"SetMandatoryAction\",\"elements\":[{\"elementId\":\"ChoiceList\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"AnswerType\"}]},{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"SHow\\/Hide References Section\",\"stageContainers\":[],\"actions\":[{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"UseReferences\",\"aggregateFunction\":0},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"true\"}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"ReferencesSection\",\"elementType\":0}]},{\"__type\":\"ClearValueAction\",\"elements\":[{\"elementId\":\"References\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"ReferencesSection\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"UseReferences\"}]}]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailSection Title=\"Question\" Icon=\"Icons/new/48x48/help2.gif\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ChecklistType\" ReadOnly=\"true\" SpellCheck=\"false\"/>\r\n<ix:Field For=\"QuestionRef\"/>\r\n<ix:Field For=\"Order\"/>\r\n<ix:Field EditAs=\"SmallTextArea\" For=\"Content\" IsMandatory=\"True\"/>\r\n<ix:Field EditAs=\"SmallTextArea\" For=\"Guideline\"/>\r\n<ix:Field EditAs=\"SmallTextArea\" For=\"Section\"/>\r\n<ix:Field For=\"AnswerType\" IsMandatory=\"True\"/>\r\n<ix:Field For=\"ChoiceList\"/>\r\n<ix:Field Span=\"true\"/>\r\n<ix:Field For=\"UseReferences\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:DetailSection Title=\"References\" Icon=\"Icons/new/48x48/book_open.gif\" DisplayMode=\"View,Edit\" Id=\"ReferencesSection\">\r\n    <ix:DetailSection Title=\"Text References\" Icon=\"Icons/new/48x48/edit.gif\">\r\n<ix:FieldValue DisplayAs=\"html\" For=\"TextReferences\"/>\r\n    </ix:DetailSection>\r\n    <ix:DetailSection Title=\"Tags\" Icon=\"Icons/new/48x48/index_add.gif\">\r\n      <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"References\" CaptionPosition=\"top\"/>\r\n      </ix:FieldArea>\r\n    </ix:DetailSection>\r\n<ix:DocumentSection ID=\"DocumentFragmentGridSection\"/>\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\"/>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayMode=\"View\" For=\"Checklists\" IsColllapsed=\"True\" Title=\"Part of following Checklists:\">\r\n    <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" LinkTo=\"CLF_Checklist_Select/Index\"/>\r\n<ix:GridExecuteActionLink Override=\"true\" Name=\"Publish\" Visible=\"false\"/>\r\n    </Menu>\r\n    <Columns>\r\n<ix:Column For=\"Reference\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Title\"/>\r\n<ix:Column For=\"Description\"/>\r\n<ix:Column For=\"NbQuestions\"/>\r\n    </Columns>\r\n  </ix:GridSection>\r\n  <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View\" For=\"PubQuestions\" ID=\"PubQuestionsGridSection\" IsColllapsed=\"True\" ReadOnly=\"true\" RowSelectionMode=\"None\" Title=\"Question Version History\">\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"DateCreated\" Direction=\"Descending\"/>\r\n    </Sorting>\r\n    <Columns>\r\n<ix:Column For=\"QuestionRef\" LinkTo=\"Default\"/>\r\n<ix:Column DisplayAs=\"html\" For=\"Content\" Width=\"1\"/>\r\n<ix:Column For=\"ChoiceList\"/>\r\n<ix:Column For=\"DateCreated\" Format=\"g\"/>\r\n    </Columns>\r\n  </ix:GridSection>\r\n</ix:DetailPage>\r\n<style>\r\n#TextReferences {\r\nbackground-color: white;\r\nborder: 1px solid #DDDDDD;\r\npadding: 5px;\r\n}\r\n</style>",
