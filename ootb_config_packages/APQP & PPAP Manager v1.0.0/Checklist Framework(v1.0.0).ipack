        "FieldData": {
          "$id": "527",
          "Id": "39a5f868-dfd3-46d0-80b5-5d5d46e629a4",
          "ActionType": 3,
          "Description": "If the Answer Type is different form Choice or Choices, the Choice List field needs to be empty.\r\nClean the Text Reference value if Use Reference is un-checked.",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"ChoiceList\",\"value\":\"NULL\"}],\"else\":[],\"condition\":\"AND(AnswerType.Value<>\\\"Choice\\\", AnswerType.Value<>\\\"Choices\\\") \"},{\"__type\":\"if\",\"then\":[],\"else\":[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"TextReferences\",\"value\":\"NULL\"}],\"else\":[],\"condition\":\"TextReferences<>NULL\"}],\"condition\":\"UseReferences\"}]",
          "Name": "Clean up Choice List Field"
        },
        "LocalizationData": null,
        "Id": "31bd890d-9f75-4991-b1df-4ce814edfe7c",
        "Caption": "Clean up Choice List Field",
        "Type": "Object Action Handler",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
