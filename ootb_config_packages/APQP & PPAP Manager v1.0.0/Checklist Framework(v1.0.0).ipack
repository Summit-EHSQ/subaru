      {
        "$id": "590",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "9668bbf5-b9a1-4966-966c-9d81420b46c3",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "591",
          "Walkthroughs": null,
          "Id": "9668bbf5-b9a1-4966-966c-9d81420b46c3",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailSection Title=\"Checklist Definition\" Icon=\"Icons/new/48x48/scroll_refresh.gif\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"ChecklistType\"/>\r\n<ix:Field For=\"Reference\"/>\r\n<ix:Field For=\"Title\"/>\r\n<ix:Field For=\"Description\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayMode=\"View,Edit\" EditLinkTarget=\"popup\" For=\"Questions\" HideGroupAddButton=\"true\" ID=\"QuestionsGridSection\">\r\n    <Actions>\r\n<ix:MassUpdateAction ViewName=\"CLF_QuestObjectDetailView_MassUpdate\"/>\r\n    </Actions>\r\n    <grouping>\r\n<ix:Group By=\"Section\"/>\r\n    </grouping>\r\n    <Menu>\r\n<ix:GridAttachActionLink Override=\"true\" Visible=\"true\" Caption=\"Attach an existing Question\" LinkTo=\"CLF_Quest_Select/Index\"/>\r\n<ix:GridDetachActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridListAllActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:GridCreateActionLink Override=\"false\" OpenIn=\"popup\" Visible=\"true\" Caption=\"Create &amp; Attach a new Question\" LinkTo=\"CLF_Quest_Detail/Create?ChecklistType={#ChecklistTypeId}\"/>\r\n<ix:GridDetachActionLink Override=\"false\" Caption=\"Detach Question(s)\"/>\r\n<ix:GridListAllActionLink Override=\"false\" Visible=\"false\"/>\r\n    </Menu>\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"Order\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <Columns>\r\n<ix:Column For=\"QuestionRef\" LinkTo=\"default\"/>\r\n<ix:Column DisplayAs=\"Truncate\" EditMode=\"inline\" For=\"Content\"/>\r\n<ix:Column EditMode=\"inline\" FilterAs=\"Dropdown\" For=\"AnswerType\" RefreshScope=\"Row\"/>\r\n<ix:Column EditMode=\"inline\" FilterAs=\"Dropdown\" For=\"ChoiceList\" RefreshScope=\"Row\"/>\r\n<ix:Column EditMode=\"inline\" For=\"Order\"/>\r\n    </Columns>\r\n  </ix:GridSection>\r\n  <ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"View,Edit\" For=\"PubChecklists\" ID=\"PubChecklistsGridSection\" Title=\"Checklist Version History\">\r\n    <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"False\"/>\r\n    </Menu>\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"DateCreated\" Direction=\"Descending\"/>\r\n    </Sorting>\r\n    <Columns>\r\n<ix:Column For=\"ChecklistRef\" LinkTo=\"default\"/>\r\n<ix:Column For=\"Title\"/>\r\n<ix:Column DisplayAs=\"Truncate\" For=\"Description\"/>\r\n<ix:Column For=\"DateCreated\" Format = 'd'/>\r\n<ix:Column EditMode=\"inline\" For=\"IsActive\"/>\r\n    </Columns>\r\n  </ix:GridSection>\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" DisplayMode=\"edit,view\"/>\r\n</ix:DetailPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_Checklist_Detail",
          "Path": "CLF_Checklist_Detail",
          "Type": 0
        },
        "LocalizationData": null,
        "Id": "b1f85cd1-beab-4127-b0c8-60262da272ee",
