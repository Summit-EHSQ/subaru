        "ResourceItems": null,
        "RecordId": "ff597a8e-7eb8-47f4-9cc8-fdc9352ef3bc",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "460",
          "Walkthroughs": null,
          "Id": "ff597a8e-7eb8-47f4-9cc8-fdc9352ef3bc",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\">\r\n<ix:EditActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n  </ix:DetailPageMenuBar><ix:GridSection Entity=\"CLF_FindingObject\" HideGroupAddButton=\"true\" Icon=\"Icons/new/48x48/flag_red.gif\" Title=\"Findings\">\r\n    <Filters>\r\n      <ix:Filter runat=\"server\" PredicateOperator=\"Or\">\r\n        <ix:CommonPredicate For=\"ChecklistAnswer.RecordNo\" Type=\"Equal\" runat=\"server\">\r\n          <ix:Value runat=\"server\" Parse=\"True\">\r\n<%= Model.RecordNo %>\r\n          </ix:Value>\r\n        </ix:CommonPredicate>\r\n        <ix:CommonPredicate For=\"ChecklistAnswer.MasterChecklist.RecordNo\" Type=\"Equal\" runat=\"server\">\r\n          <ix:Value runat=\"server\" Parse=\"True\">\r\n<%= Model.RecordNo %>\r\n          </ix:Value>\r\n        </ix:CommonPredicate>\r\n      </ix:Filter>\r\n    </Filters>\r\n    <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" Visible=\"False\"/>\r\n    </Menu>\r\n    <grouping>\r\n<ix:Group By=\"Location\"/>\r\n    </grouping>\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"RecordNo\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\" /><ix:Column For=\"Description\" truncate=\"true\" /><ix:Column For=\"ResponseDue\" Format=\"d\" /></Columns></ix:GridSection><ix:GridSection For=\"ActionPlans\" ID=\"ActionPlansGridSection\"><Columns><ix:Column For=\"ActionNo\" LinkTo=\"default\" /><ix:Column For=\"Activites\" /><ix:Column For=\"ActivitiesStart\" /><ix:Column For=\"ActivitProgress\" /><ix:Column For=\"ActualCost\" /></Columns></ix:GridSection></ix:DetailPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_ChecklistAnswer_Findings",
          "Path": "CLF_ChecklistAnswer_Findings",
          "Type": 0
        },
        "LocalizationData": null,
        "Id": "9dd82e54-4ff2-488c-88d7-831a49fb9b07",
