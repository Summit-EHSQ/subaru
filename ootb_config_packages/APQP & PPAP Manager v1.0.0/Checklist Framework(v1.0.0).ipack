        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
      {
        "$id": "42",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "e18ca4b4-7d9c-4fdb-96fe-1497fccad9cd",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "43",
          "Walkthroughs": null,
          "Id": "e18ca4b4-7d9c-4fdb-96fe-1497fccad9cd",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage>\r\n  <ix:DetailSection Title=\"Choice List\" Icon=\"Icons/new/48x48/index.gif\">\r\n    <ix:FieldArea Span=\"true\">\r\n<ix:Field For=\"Reference\"/>\r\n<ix:Field For=\"Name\"/>\r\n<ix:Field For=\"Description\"/>\r\n    </ix:FieldArea>\r\n  </ix:DetailSection>\r\n  <ix:GridSection DisplayMode=\"View,Edit\" EditLinkTarget=\"popup\" For=\"Choices\" ID=\"ChoicesGridSection\">\r\n    <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\"/>\r\n    </Menu>\r\n    <Sorting>\r\n<ix:Sort runat=\"server\" By=\"Name\" Direction=\"Ascending\"/>\r\n    </Sorting>\r\n    <aliases>\r\n<ix:Alias For=\"TColor.Value\"/>\r\n<ix:Alias For=\"BColor.Value\"/>\r\n    </aliases>\r\n    <Columns>\r\n<ix:Column EditMode=\"Inline\" For=\"Reference\" LinkTo=\"default\" RefreshScope=\"Row\"/>\r\n      <ix:TemplateColumn For=\"Name\" EditMode=\"inline\" RefreshScope=\"Row\">\r\n        <Template>\r\n          <div style=\"color:<%# Container.ViewData.Eval(\"TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"BColor.Value\") %>;<%# Container.ViewData.Eval(\"Css\") %>\">\r\n<%# Container.ViewData.Eval(\"Name\") %>\r\n          </div>\r\n        </Template>\r\n      </ix:TemplateColumn>\r\n<ix:Column EditMode=\"Inline\" For=\"Value\" RefreshScope=\"Row\"/>\r\n<ix:Column EditMode=\"Inline\" FilterAs=\"dropdown\" For=\"BColor\" RefreshScope=\"Row\"/>\r\n<ix:Column EditMode=\"Inline\" FilterAs=\"dropdown\" For=\"TColor\" RefreshScope=\"Row\"/>\r\n<ix:Column EditMode=\"Inline\" For=\"Css\" RefreshScope=\"Row\"/>\r\n    </Columns>\r\n  </ix:GridSection>\r\n</ix:DetailPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_ChoiceList_Detail",
          "Path": "CLF_ChoiceList_Detail",
          "Type": 0
        },
