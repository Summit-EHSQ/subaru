      {
        "$id": "178",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "b06cd56d-6508-4d38-835a-3f5d7977fb29",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "179",
          "Walkthroughs": null,
          "Id": "b06cd56d-6508-4d38-835a-3f5d7977fb29",
          "Caption": null,
          "ConfigurableViewActions": null,
          "Content": "<ix:InventoryPage>\n  <ix:Inventory ID=\"CLF_QuestionAnswer_Inventory\">\n    <ix:InventoryView ID=\"CLF_QuestionAnswer_InventoryView\" DisplayEditColumn=\"false\" HideGroupAddButton=\"true\">\n      <Menu>\n<ix:GridCreateActionLink Override=\"true\" Visible=\"false\"/>\n<ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/>\n      </Menu>\n      <Sorting>\n<ix:Sort By=\"PubQuestion.Order\" Direction=\"Ascending\"/>\n      </Sorting>\n      <grouping>\n<ix:Group By=\"PubQuestion.Section\"/>\n      </grouping>\n      <aliases>\n<ix:Alias For=\"ChecklistAnswerId\"/>\n<ix:Alias For=\"PubQuestion.Guideline\"/>\n<ix:Alias For=\"PubQuestion.Id\"/>\n<ix:Alias For=\"Choice.BColor.Value\"/>\n<ix:Alias For=\"Choice.TColor.Value\"/>\n<ix:Alias For=\"Choice.Css\"/>\n      </aliases>\n      <Columns>\n        <ix:TemplateColumn For=\"PubQuestion.Content\">\n          <Template>\n            <span style=\"font-weight:bold;\">\n<%# Container.ViewData.Eval(\"PubQuestion.QuestionRef\") %> <%# Container.ViewData.Eval(\"PubQuestion.Content\") %>\n            </span>\n            <div class=\"fieldHint\">\n<%# Container.ViewData.Eval(\"PubQuestion.Guideline\") %>\n            </div>\n          </Template>\n        </ix:TemplateColumn>\n        <ix:MergeColumn Caption=\"Answer\" For=\"PubQuestion.AnswerType.Value\"><MappedColumns>\n            <ix:TemplateColumn MapValue=\"Choice_Disable\" For=\"Choice\">\n              <Template>\n                <div style=\"color:<%# Container.ViewData.Eval(\"Choice.TColor.Value\") %>;background-color:<%# Container.ViewData.Eval(\"Choice.BColor.Value\") %>;<%# Container.ViewData.Eval(\"Choice.Css\") %>\">\n<%# Container.ViewData.Eval(\"Choice\") %>\n                </div>\n              </Template>\n            </ix:TemplateColumn>\n<ix:Column For=\"Choice\" MapValue=\"Choice\" /><ix:Column For=\"Date\" Format=\"d\" MapValue=\"Date\" /><ix:Column DisplayAs=\"List\" FetchAs=\"collection\" For=\"Choices\" MapValue=\"Choices\" /><ix:Column For=\"Float\" HorizontalAlign=\"right\" MapValue=\"Float\" /><ix:Column For=\"Text\" MapValue=\"Text\" /><ix:Column For=\"Checkbox\" MapValue=\"Checkbox\" /></MappedColumns></ix:MergeColumn><ix:Column For=\"Comments\" /></Columns>\n    </ix:InventoryView>\n  </ix:Inventory>\n</ix:InventoryPage>\n<style>\n.data_row td.wrap {\n    white-space: normal !important;\n}\n</style>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_QuestionAnswer_Inventory",
          "Path": "CLF_QuestionAnswer_Inventory",
          "Type": 1
        },
        "LocalizationData": null,
        "Id": "955a8a40-4db2-44c2-b2e7-1e7c7cbf8fd4",
        "Caption": "CLF_QuestionAnswer_Inventory",
        "Type": "Configurable View",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
