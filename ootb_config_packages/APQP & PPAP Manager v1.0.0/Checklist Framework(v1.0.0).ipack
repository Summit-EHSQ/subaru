      {
        "$id": "682",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "d42b7332-e01a-46cc-9bf8-93217f3861df",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "683",
          "Walkthroughs": null,
          "Id": "d42b7332-e01a-46cc-9bf8-93217f3861df",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage>\r\n  <ix:Inventory ID=\"Insp_PubQuestion_Select\">\r\n    <ix:InventoryView ID=\"Insp_PubQuestion_SelectSelect\" HideGroupAddButton=\"true\">\r\n      <filters>\r\n        <ix:Filter>\r\n          <ix:SubQueryPredicate For=\"Question.ChecklistType.Id\" FromEntity=\"Insp_InspectionAbsObject\" Type=\"In\" EntityAlias=\"Inspection\">\r\n<ix:Property Text=\"TypeOfInspec.Id\"/>\r\n            <ix:Filter>\r\n              <ix:CommonPredicate For=\"[Inspection].Id\" Type=\"Equal\">\r\n                <ix:Value Parse=\"true\">\r\n<%=Request.QueryString[\"_DependsOn.Parent\"].Replace(\"ChecklistAnswer:\", \"\") %>\r\n                </ix:Value>\r\n              </ix:CommonPredicate>\r\n            </ix:Filter>\r\n          </ix:SubQueryPredicate>\r\n          <ix:CommonPredicate For=\"DateCreated\" Type=\"GreaterThanOrEqual\">\r\n<ix:Property Text=\"Question.LastPublish\"/>\r\n          </ix:CommonPredicate>\r\n        </ix:Filter>\r\n      </filters>\r\n      <Menu>\r\n<ix:GridCreateActionLink Override=\"true\" visible=\"false\"/>\r\n<ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/>\r\n      </Menu>\r\n      <grouping>\r\n<ix:Group By=\"Section\"/>\r\n      </grouping>\r\n      <Sorting>\r\n<ix:Sort By=\"Order\" Direction=\"Ascending\"/>\r\n      </Sorting>\r\n      <Columns>\r\n<ix:Column For=\"QuestionRef\"/>\r\n<ix:Column For=\"Content\" DisplayAs=\"Truncate\"/>\r\n<ix:Column For=\"Guideline\" DisplayAs=\"Truncate\"/>\r\n      </Columns>\r\n    </ix:InventoryView>\r\n  </ix:Inventory>\r\n</ix:InventoryPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "Insp_PubQuestion_Select",
          "Path": "Insp_PubQuestion_Select",
          "Type": 1
        },
        "LocalizationData": null,
        "Id": "c116e235-7d7c-4487-820a-829fcb2a548d",
        "Caption": "Insp_PubQuestion_Select",
        "Type": "Configurable View",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
