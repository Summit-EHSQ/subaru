      {
        "$id": "793",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.SysConfigurableViewPackageItemData, Intelex.Business.PackageManagement",
        "ResourceItems": null,
        "RecordId": "bf127e4c-520e-4818-9e2c-c051a79ef6e8",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "794",
          "Walkthroughs": null,
          "Id": "bf127e4c-520e-4818-9e2c-c051a79ef6e8",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\" runat=\"server\">\r\n<ix:EditActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveExitActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:CloneActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:DeleteActionLink Override=\"true\" Visible=\"false\"/>\r\n<ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/>\r\n  </ix:DetailPageMenuBar>\r\n  <ix:TabsSection Title=\"Private Document Attachment\" ShowHeader=\"true\" Icon=\"Icons/new/48x48/folder_up.gif\">\r\n    <ix:Tab Caption=\"Upload\">\r\n<ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" Title=\"Upload images\" CssClass=\"HideBorders\" isCollapsed=\"false\" UseCookies=\"false\"/>\r\n    </ix:Tab>\r\n    <ix:Tab Caption=\"Image Preview\" DisplayMode=\"View,Edit\">\r\n      <ix:GridPanel Entity=\"DocDocumentAttachmentsEntity\" isCollapsed=\"false\" UseCookies=\"false\" ShowColumnCaptions=\"false\" AllowPaging=\"false\" AllowFiltering=\"false\" AllowSorting=\"false\" RowSelectionMode=\"None\" Readonly=\"True\" DisplayMode=\"View,Edit\" DisplayEditColumn=\"false\" CssClass=\"HideBorders\">\r\n        <Filters>\r\n          <ix:Filter>\r\n            <ix:CommonPredicate For=\"ObjectRecordId\" Type=\"Equal\">\r\n              <ix:Value Parse=\"True\">\r\n<%= Model.Id %>\r\n              </ix:Value>\r\n            </ix:CommonPredicate>\r\n          </ix:Filter>\r\n          <ix:Filter PredicateOperator=\"or\">\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.png\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.jpg\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n            <ix:LikePredicate For=\"AttachmentName\" Type=\"EndsWith\">\r\n              <ix:Value>\r\n.gif\r\n              </ix:Value>\r\n            </ix:LikePredicate>\r\n          </ix:Filter>\r\n        </Filters>\r\n        <aliases>\r\n<ix:Alias For=\"Id\"/>\r\n<ix:Alias For=\"AttachmentName\"/>\r\n        </aliases>\r\n        <columns>\r\n          <ix:TemplateColumn>\r\n            <template>\r\n              <div class=\"imagepreview\" title=\"<%# Container.ViewData.Eval(\"AttachmentName\") %>\" style=\"background-image:url(&apos;<%= HttpEnvironment.SystemApplicationPath %>/intelexforms/attachmentsection/downloadfile?recordid=<%# Container.ViewData.Eval(\"Id\") %>&apos;)\"/>\r\n              </template>\r\n            </ix:TemplateColumn>\r\n          </columns>\r\n        </ix:GridPanel>\r\n      </ix:Tab>\r\n    </ix:TabsSection>\r\n  </ix:DetailPage>\r\n  <style>\r\n.HideBorders > .header {\r\n    display: none;\r\n}\r\n\r\n.HideBorders > .footer {\r\n    display: none;\r\n}\r\n\r\n.HideBorders > .content {\r\n    border: medium none;\r\n    padding: 0;\r\n}\r\n\r\n.imagepreview {\r\nbackground-repeat:no-repeat;\r\nmax-width:500px;\r\nmin-height:300px;\r\nbackground-size:contain;\r\n}\r\n  </style>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "CLF_QuestionAnswer_Docs",
          "Path": "CLF_QuestionAnswer_Docs",
          "Type": 0
        },
        "LocalizationData": null,
        "Id": "7c11607b-607e-482c-a611-edc1f794b5a9",
