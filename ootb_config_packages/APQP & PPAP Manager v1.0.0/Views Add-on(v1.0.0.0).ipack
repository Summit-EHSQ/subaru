          }
        ],
        "RecordId": "413d7155-212b-4475-b340-262943d5f35e",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "78",
          "Id": "413d7155-212b-4475-b340-262943d5f35e",
          "Caption": "Employees",
          "ConfigurableViewActions": null,
          "Content": "<ix:InventoryPage><ix:Inventory ID=\"TrainMgmt_Employee_Select_WithStatus\"><ix:InventoryView ID=\"TrainMgmt_Employee_Select_WithStatusView\" Caption=\"Employees with Overdue/Upcoming Requirement\" HelperText=\"Shows only employees with training requirements that are overdue or upcoming in the next two months.\" DisplayEditColumn=\"False\" HideGroupAddButton=\"true\" meta:resourcekey=\"InventoryView0\" ResourceKey=\"InventoryView0\"><Menu><ix:GridCreateActionLink Visible=\"false\" Override=\"true\"/><ix:GridDeleteActionLink Override=\"true\" Visible=\"false\"/><ix:GridArchiveActionLink Override=\"true\" Visible=\"false\"/></Menu><grouping><ix:Group By=\"ReqStatuses.Workflow.DueDateType\"/></grouping><Sorting><ix:Sort By=\"ReqStatuses.Workflow.DueDateType\" Direction=\"Descending\"/><ix:Sort By=\"ReqStatuses.NextDueDate\" Direction=\"Ascending\"/></Sorting><filters><ix:Filter PredicateOperator=\"And\"><ix:CommonPredicate For=\"ReqStatuses.Requirement:TrainMgmt_CourseObject.Sessions.id\" Type=\"Equal\"><ix:Value Parse=\"true\"><%=Request.QueryString[\"_DependsOn.Parent$\"].Replace(\"Session:\", \"\") %></ix:Value></ix:CommonPredicate><ix:IsNullPredicate For=\"ReqStatuses.NextSchedDate\"/><ix:IsNullPredicate For=\"ReqStatuses.NextDueDate\" Negate=\"true\"/><ix:CommonPredicate For=\"ReqStatuses.NextDueDate\" Type=\"LessThan\"><ix:Value Parse=\"True\"><%= DateTime.Today.AddMonths(2) %></ix:Value></ix:CommonPredicate><ix:SubQueryPredicate For=\"Id\" FromEntity=\"TrainMgmt_IndTrainRecordObject\" Type=\"In\" EntityAlias=\"TrainingRecords\" Negate=\"true\"><ix:Property Text=\"Employee.Id\"/><ix:Filter><ix:CommonPredicate For=\"[TrainingRecords].SessionId\" Type=\"Equal\"><ix:Value Parse=\"true\"><%=Request.QueryString[\"_DependsOn.Parent$\"].Replace(\"Session:\", \"\") %></ix:Value></ix:CommonPredicate></ix:Filter></ix:SubQueryPredicate><ix:SubQueryPredicate For=\"Id\" FromEntity=\"TrainMgmt_SessionTrainRecObject\" Type=\"In\" EntityAlias=\"TrainingRecords\" Negate=\"true\"><ix:Property Text=\"Employee.Id\"/><ix:Filter><ix:CommonPredicate For=\"[TrainingRecords].SessionId\" Type=\"Equal\"><ix:Value Parse=\"true\"><%=Request.QueryString[\"_DependsOn.Parent$\"].Replace(\"Session:\", \"\") %></ix:Value></ix:CommonPredicate></ix:Filter></ix:SubQueryPredicate></ix:Filter></filters><Columns><ix:Column For=\"Number\"/><ix:Column For=\"FullName\"/><ix:Column For=\"Location\" displayas=\"string\"/><ix:Column For=\"Position\"/><ix:Column For=\"ReqStatuses.LastCompDate\" Format=\"d\"/><ix:TemplateColumn For=\"ReqStatuses.NextDueDate\"><template><div class=\"<%# (DateTime) Container.ViewData.Eval(\"ReqStatuses.NextDueDate\") <= DateTime.Today ? \"redDiv\" : (DateTime) Container.ViewData.Eval(\"ReqStatuses.NextDueDate\") <= DateTime.Today.AddMonths(1) ? \"orangeDiv\" : \"greenDiv\" %>\"><%# String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"ReqStatuses.NextDueDate\")) %></div></template></ix:TemplateColumn></Columns></ix:InventoryView></ix:Inventory></ix:InventoryPage><style>.redDiv {\n\tfont-weight:bold;\n\tcolor:red;\n}\n\n.orangeDiv {\n\tfont-weight:bold;\n\tcolor:orange;\n}\n\n\n.greenDiv {\n\tfont-weight:bold;\n\tcolor:green;\n}</style>",
          "IsParsedForMobile": false,
          "IsPublic": false,
