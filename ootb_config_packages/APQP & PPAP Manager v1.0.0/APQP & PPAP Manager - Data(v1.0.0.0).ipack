          "Description": "This application provides the ability to manage your new product process in Advanced Product Quality Planning (APQP) & Production Part Approval Process (PPAP) management system.",
          "Disabled": false,
          "Index": null,
          "IsAvailableForMobile": false,
          "IsAvailableOffline": false,
          "LegacyModuleId": null,
          "MobileCaption": null,
          "MobileIcon": null,
          "UrlCaption": "APQP",
          "UrlIcon": "Raven/Icons/BrightBlue_48/marketing8.png",
