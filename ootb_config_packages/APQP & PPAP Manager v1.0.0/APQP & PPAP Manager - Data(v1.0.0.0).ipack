        "FieldData": {
          "$id": "804",
          "Id": "602f2dea-d5e4-4980-97a9-7418f8203540",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage><ix:Inventory ID=\"APQP_PPAP_Inventory_Open\"><ix:InventoryView ID=\"APQP_PPAP_Inventory_OpenView\" HideGroupAddButton=\"true\"><Filters><ix:Filter><ix:CommonPredicate For=\"Workflow.WorkflowStatus\" Type=\"Equal\"><ix:Value Parse=\"true\">Open</ix:Value></ix:CommonPredicate></ix:Filter></Filters><Menu><ix:GridCreateActionLink Override=\"true\" Caption=\"Add New PPAP\" LinkTo=\"APQP_PPAP_Detail/Create?ProjectType=a6aa71e1-4202-4d7f-b583-caddd4c87188\" meta:resourcekey=\"GridCreateActionLink0\" ResourceKey=\"GridCreateActionLink0\"/></Menu><Sorting><ix:Sort By=\"SubmissionDate\" Direction=\"Ascending\"/></Sorting><Grouping><ix:Group by=\"Product.PartOf.ParentItem.Name\" HeaderCaption=\"Program\"/></Grouping><aliases><ix:Alias For=\"Settings.PPAPCautioInd\" Name=\"PPAPCautioInd\"/></aliases><Columns><ix:TemplateColumn For=\"SubmissionDate\" Format=\"d\" Caption=\"PPAP Due Date\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><template><div class=\"<%# Container.ViewData.Eval(\"SubmissionDate\").ToString() != \"\" ? \n(DateTime) Container.ViewData.Eval(\"SubmissionDate\") < DateTime.Today ? \"redDiv\" : \n(DateTime) Container.ViewData.Eval(\"SubmissionDate\") <= DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"PPAPCautioInd\"))) ? \"yellowDiv\" :\n(DateTime) Container.ViewData.Eval(\"SubmissionDate\") > DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"PPAPCautioInd\"))) ?\"greenDiv\" : \"\" : \"inlineDiv\" %>\"><%# Container.ViewData.Eval(\"SubmissionDate\").ToString() != \"\" ? String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"SubmissionDate\")) : \"-- Assign Due Date --\"%></div></template></ix:TemplateColumn><ix:Column Caption=\"Part Number\" For=\"Product\" LinkTo=\"default\" meta:resourcekey=\"Column1\" ResourceKey=\"Column1\"/><ix:Column Caption=\"Product Name\" For=\"Product.Name\" meta:resourcekey=\"Column2\" ResourceKey=\"Column2\"/><ix:Column Caption=\"Program\" For=\"Product.PartOf.ParentItem.Name\" meta:resourcekey=\"Column0\" ResourceKey=\"Column0\"/><ix:Column For=\"Progress\"/><ix:Column For=\"ProgProTasks\"/><ix:Column For=\"Workflow.CurrentStage\"/><ix:Column For=\"ProjectOwner\"/><ix:Column DisplayAs=\"string\" For=\"Location\"/></Columns></ix:InventoryView></ix:Inventory><style><%= ApplicationSettings.Get(\"APQP_SettingsObject\",\"CustomCSS\",\"\")  %></style></ix:InventoryPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
