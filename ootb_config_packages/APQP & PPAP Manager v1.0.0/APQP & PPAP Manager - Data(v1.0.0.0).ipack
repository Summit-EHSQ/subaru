        "RecordId": "d8c514bd-5c1e-4e28-951d-822603a1ed8f",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "909",
          "Id": "d8c514bd-5c1e-4e28-951d-822603a1ed8f",
          "Caption": "APQP List",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage><ix:Inventory ID=\"APQP_APQP_Inventory_Open\"><ix:InventoryView ID=\"APQP_APQP_Inventory_OpenView\" Caption=\"APQP List\" HideGroupAddButton=\"true\" meta:resourcekey=\"InventoryView0\" ResourceKey=\"InventoryView0\"><Filters><ix:Filter><ix:CommonPredicate For=\"Workflow.WorkflowStatus\" Type=\"Equal\"><ix:Value Parse=\"true\">Open</ix:Value></ix:CommonPredicate></ix:Filter></Filters><Menu><ix:GridCreateActionLink Override=\"true\" Caption=\"Add New APQP\" LinkTo=\"APQP_APQP_Detail/Create?ProjectType=f467e500-49c1-4877-8b65-9a20492687f9\" meta:resourcekey=\"GridCreateActionLink0\" ResourceKey=\"GridCreateActionLink0\"/></Menu><Sorting><ix:Sort By=\"PPAPDueDate\" Direction=\"Ascending\"/></Sorting><Grouping><ix:Group by=\"Product.PartOf.ParentItem.Name\" HeaderCaption=\"Program\"/></Grouping><aliases><ix:Alias For=\"Settings.APQPCautioInd\" Name=\"APQPCautioInd\"/></aliases><Columns><ix:TemplateColumn For=\"PPAPDueDate\" Format=\"d\" Caption=\"PPAP Due Date\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><template><div class=\"<%# Container.ViewData.Eval(\"PPAPDueDate\").ToString() != \"\" ? \n(DateTime) Container.ViewData.Eval(\"PPAPDueDate\") < DateTime.Today ? \"redDiv\" : \n(DateTime) Container.ViewData.Eval(\"PPAPDueDate\") <= DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"APQPCautioInd\"))) ? \"yellowDiv\" :\n(DateTime) Container.ViewData.Eval(\"PPAPDueDate\") > DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"APQPCautioInd\"))) ?\"greenDiv\" : \"\" : \"inlineDiv\" %>\"><%# Container.ViewData.Eval(\"PPAPDueDate\").ToString() != \"\" ? String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"PPAPDueDate\")) : \"-- Assign Due Date --\"%></div></template></ix:TemplateColumn><ix:Column For=\"Product\" Caption=\"Part Number\" LinkTo=\"default\" meta:resourcekey=\"Column1\" ResourceKey=\"Column1\"/><ix:Column For=\"Product.Name\" Caption=\"Product Name\" meta:resourcekey=\"Column2\" ResourceKey=\"Column2\"/><ix:Column Caption=\"Program\" For=\"Product.PartOf.ParentItem.Name\" meta:resourcekey=\"Column0\" ResourceKey=\"Column0\"/><ix:Column For=\"Progress\"/><ix:Column For=\"ProgProTasks\"/><ix:Column For=\"Workflow.CurrentStage\"/><ix:Column For=\"ProcessOwner\"/><ix:Column DisplayAs=\"string\" For=\"Location\"/></Columns></ix:InventoryView></ix:Inventory><style><%= ApplicationSettings.Get(\"APQP_SettingsObject\",\"CustomCSS\",\"\")  %></style></ix:InventoryPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
          "Name": "APQP_APQP_Inventory_Open",
          "Path": "APQP_APQP_Inventory_Open",
          "Type": 1
        },
