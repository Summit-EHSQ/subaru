        "ObjectName": "APQP_SettingsObject",
        "FieldData": {
          "$id": "1611",
          "Id": "7b040ae4-8679-43df-ad06-3ad53a684674",
          "APQPCautioInd": 15,
          "APQPTaskCaution": 15,
          "CustomCSS": ".bigicon {\r\n  width:auto !important;\r\n    height:auto !important;\r\n  }\r\n\r\n.datagrid_title {\r\ncolor:#222 !important;\r\nfont-size:12px !important;\r\nborder:none !important;\r\nfont-family: Verdana,Helvetica,sans-serif !important;\r\n}\r\n\r\n.inventory-row td.data-cell.wrap {\r\n    white-space: normal !important;\r\n}\r\n\r\n.inlineDiv {\r\nfont-weight: bold;\r\ncolor: #3498db;\r\n}\r\n\r\n#inLineEditForm {\r\npadding:0px !important;\r\n}\r\n\r\n#inLineEditForm .fieldarea-field input[type=\"text\"] {\r\nwidth: auto!important;\r\n}\r\n\r\n#inLineEditForm .fieldarea-row {\r\nmargin-right: 0 !important;\r\n}\r\n\r\n#inLineEditForm .fieldarea-field select, .fieldarea-field select[multiple] {\r\nwidth: auto!important;\r\n}\r\n\r\n.hiddenHeader > .header{\r\ndisplay:none;\r\n}\r\n\r\n.hiddenSection {\r\ndisplay:none;\r\n}\r\n\r\n\r\n.redDiv {\r\nbackground-color: #C0392B;\r\nfont-weight: bold;\r\ncolor: white;\r\npadding: 5px 2px;\r\nborder-radius: 2px;\r\nborder: 1px solid #C0392B;\r\n}\r\n.orangeDiv {\r\nbackground-color: orange;\r\nfont-weight: bold;\r\ncolor: white;\r\ncolor: #3A3B3C;\r\npadding: 5px 2px;\r\nborder-radius: 2px;\r\nborder: 1px solid #CC8400;\r\n}\r\n.greenDiv {\r\nbackground-color: #27AE60;\r\nfont-weight: bold;\r\ncolor: white;\r\npadding: 5px 2px;\r\nborder-radius: 2px;\r\nborder: 1px solid #27AE60;\r\n}\r\n.yellowDiv {\r\nbackground-color: #F1C40F;\r\nfont-weight: bold;\r\ncolor: white;\r\npadding: 5px 2px;\r\nborder-radius: 2px;\r\nborder: 1px solid #F1C40F;\r\n}\r\n\r\n.wfDiagram {\r\n\twidth:100%;\r\n\ttext-align:center;\r\n\toverflow:auto;\r\n\tmargin-bottom:10px;\r\n}\r\n\r\n.wfDiagram > div {\r\n\tdisplay: inline-block;\r\n\tmargin-bottom: 5px;\r\n\tpadding-left: 24px;\r\n\tbackground-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\r\n\tbackground-repeat: no-repeat;\r\n\tbackground-position: left center;\r\n}\r\n\r\n.wfDiagram > div:first-child {\r\n\tpadding-left: 0;\r\n\tbackground-image: none;\r\n\tposition: relative;\r\n}\r\n.wfDiagram > div:last-child {\r\n\t\tmargin-bottom: 5px;\r\n\tposition: relative;\r\n\tpadding-left: 24px;\r\n\tbackground-image: url('<%= ImageHelper.GetStaticPath(\"Icons/new/24x24/navigate_right.gif\") %>');\r\n         \tbackground-repeat: no-repeat;\r\n\tbackground-position: left center;\r\n\r\n}\r\n\r\n.wfDiagram > div > div {\r\n\twidth: 180px;\r\n\ttext-align: center;\r\n\tpadding: 6px 2px;\r\n\tfont-weight: bold;\r\n\tborder-radius: 8px;\r\n\tborder: 2px solid #6CC0FF;\r\n\tbackground-color: #FFFFFF;\r\n\tcolor: #3F3F3F;\r\n\r\n}\r\n\r\n.wfDiagram > div > div[selected='blue'] {\r\n\tborder: 2px solid #0070C0;\r\n\tbackground-color: #0070C0;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n.wfDiagram > div > div[selected='red'] {\r\n\tborder: 2px solid #C0392B;\r\n\tbackground-color: #C0392B;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n.wfDiagram > div > div[selected='green'] {\r\n\tborder: 2px solid #27AE60;\r\n\tbackground-color: #27AE60;\r\n\tcolor: #FFFFFF;\r\n}\r\n\r\n.wfDiagram > div > div[selected='yellow'] {\r\n\tborder: 2px solid #F1C40F;\r\n\tbackground-color: #F1C40F;\r\n\tcolor: #FFFFFF;\r\n}",
          "EnableCAR": true,
          "EnableCARPPAP": true,
          "HideTaskDraft": false,
          "Name": "Default",
          "PPAPCautioInd": 15,
          "PPAPHidTskDraft": false,
          "PPAPTaskCaution": 15,
          "SkipGate2": false,
          "SkipGate2Msg": "Please ensure that you adjust the APQP Gate Weighting after saving this change."
        },
