        "LocalizationData": {
          "$id": "4025",
          "Caption": {
            "$id": "4026",
            "fr": "Application d’assistance est Active",
            "de": "Helfer ist aktiv",
            "en-US": "Helper Is Active",
            "zh": "帮助器处于活动状态",
            "pt": "Auxiliar está ativo",
            "es": "Ayudante es activo"
          },
          "Description": {
            "$id": "4027",
            "fr": "Domaine d’assistance utilisé pour aider l’état de vérification/set point. (Oui = actif ; Ne = obsolète)",
            "de": "Helfer Bereich zur Überprüfung/Set Positionsstatus helfen. (Ja = aktiv; Nein = veraltet)",
            "en-US": "Helper field used to help check/set item status. (Yes=Active; No=Obsolete)",
            "zh": "帮助器字段用来帮助检查/设置项目状态。（= 是的活动;不 = 已过时)",
            "pt": "Campo de auxiliar usado para ajudar o status do item de seleção/conjunto. (Sim = ativo; Não = obsoleto)",
            "es": "Campo auxiliar utilizado para ayudar al estado artículo check/juego. (Sí = activo; No = obsoleto)"
          },
          "Hint": {
            "$id": "4028",
            "fr": "",
