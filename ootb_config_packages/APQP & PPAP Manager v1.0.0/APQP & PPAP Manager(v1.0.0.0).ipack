        "FieldData": {
          "$id": "8355",
          "Id": "b4b01894-d81c-41cf-be14-ba9f519ea0af",
          "ActionType": 2,
          "Description": "Auto Close Related Task WF when PPAP WF is closed or cancelled.",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"Task.Workflow.DateNotRequired\",\"value\":\"TODAY()\"},{\"__type\":\"setvalue\",\"field\":\"Task.IsCompleted\",\"value\":\"TRUE\"},{\"__type\":\"setvalue\",\"field\":\"Task.CompletedBy\",\"value\":\"CURRENTUSER\"}],\"else\":[],\"condition\":\"AND(Task<>NULL,OR(Workflow.WorkflowStatus=\\\"Completed\\\",Workflow.WorkflowStatus=\\\"Cancelled\\\"))\"}]",
          "Name": "Auto Close Related Task WF"
        },
        "LocalizationData": null,
        "Id": "50262975-3dea-4e0f-9e7d-e99df5c55b70",
        "Caption": "Auto Close Related Task WF",
