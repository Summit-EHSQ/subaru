        "ResourceItems": [
          {
            "$id": "6661",
            "IsPublished": true,
            "MetaResourceKey": "0942b1a1-52f0-430f-8f1a-b2a7ba39854c",
            "DefaultValue": "Please fill out all mandatory attribute values before proceeding: LSL,USL for Quantitative attributes, additional UoM for Unit of Measure attribute, and Target Value for Qualitative attributes.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6662",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte füllen Sie alle obligatorischen Attributwerte, bevor Sie fortfahren: LSL, USL für Quantitative Attribute, zusätzliche UoM für Maßeinheit Attribut und Zielwert für qualitativen Merkmalen."
              },
              {
                "$id": "6663",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, preencha todos os valores de atributo obrigatório antes de prosseguir: LSL, USL para quantitativa de atributos, UoM adicional para o atributo de unidade de medida e o valor-alvo para atributos qualitativos."
              },
              {
                "$id": "6664",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Veuillez remplir toutes les valeurs d’attribut obligatoire avant de procéder : LSL, USL pour Quantitative attribue, UoM supplémentaire pour l’attribut de l’unité de mesure et la valeur cible pour les attributs qualitatifs."
              },
              {
                "$id": "6665",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please fill out all mandatory attribute values before proceeding: LSL,USL for Quantitative attributes, additional UoM for Unit of Measure attribute, and Target Value for Qualitative attributes."
              },
              {
                "$id": "6666",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请填写所有必填属性值之前： LSL、 USL 的定量属性，其他计量单位为单位的度量标准属性和定性属性的目标值。"
              },
              {
                "$id": "6667",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor llene todos los valores de atributo obligatorios antes de continuar: atributos de LSL, USL para cuantitativo, UoM adicional para el atributo de la unidad de medida y valor objetivo para atributos cualitativos."
              }
            ]
          },
          {
            "$id": "6668",
            "IsPublished": true,
            "MetaResourceKey": "d54b7725-f932-40d2-9284-835708d6adf9",
            "DefaultValue": "You must specify the changes made on this attempt. Need to be updated by Mastan...",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6669",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "您必须指定在此尝试所做的更改。需要由 Mastan 更新..."
              },
              {
                "$id": "6670",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Debe especificar los cambios realizados en este intento. Necesitan ser actualizados por Mastan..."
              },
              {
                "$id": "6671",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Você deve especificar as alterações feitas a esta tentativa. Precisa ser atualizado por Marcos Vinicius..."
              },
              {
                "$id": "6672",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "You must specify the changes made on this attempt. Need to be updated by Mastan..."
              },
              {
                "$id": "6673",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Sie müssen die Änderungen auf dieser Versuch angeben. Notwendigkeit von Mastan aktualisiert werden..."
              },
              {
                "$id": "6674",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Vous devez spécifier les modifications apportées à cette tentative. Doivent être actualisés par Mastan..."
              }
            ]
          },
          {
            "$id": "6675",
            "IsPublished": true,
            "MetaResourceKey": "f760bbaa-9381-4213-b841-3f18fdb54069",
            "DefaultValue": "You must enter Details of Changes Made in order to proceed to Approval.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6676",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Sie müssen Details der Änderungen eingeben, um zur Genehmigung zu gelangen."
              },
              {
                "$id": "6677",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "你必须输入详细信息进行更改才能着手进行批准。"
              },
              {
                "$id": "6678",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Vous devez entrer le détails des modifications apportées afin de procéder à l’approbation."
              },
              {
                "$id": "6679",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Debe ingresar los datos de cambios para proceder a la aprobación."
              },
              {
                "$id": "6680",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Você deve entrar em detalhes de mudanças feitas para proceder à aprovação."
              },
              {
                "$id": "6681",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "You must enter Details of Changes Made in order to proceed to Approval."
              }
            ]
          },
          {
            "$id": "6682",
            "IsPublished": true,
            "MetaResourceKey": "d7910c2b-5c9a-44b8-b90f-bb1d50a4dac3",
            "DefaultValue": "Category cannot be changed when obsoleting item.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6683",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Category cannot be changed when obsoleting item."
              },
              {
                "$id": "6684",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "类别不能更改时逐步淘汰项目。"
              },
              {
                "$id": "6685",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Categoría no puede ser cambiada cuando obsoleting artículo."
              },
              {
                "$id": "6686",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Kategorie kann nicht geändert werden, wenn Artikel Bilddateien."
              },
              {
                "$id": "6687",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Catégorie ne peut être changée lorsque obsolète point."
              },
              {
                "$id": "6688",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Categoria não pode ser alterada quando obsoleting item."
              }
            ]
          },
          {
            "$id": "6689",
            "IsPublished": true,
            "MetaResourceKey": "a4c20b25-7d2a-47c4-96c6-497034678e4f",
            "DefaultValue": "Please fill out all mandatory attribute values before proceeding: Date/Number:LSL,USL. Unit of Measure:LSL,USL,UoM. Applicability/Descriptive:TargetValue",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6690",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, preencha todos os valores de atributo obrigatório antes de prosseguir: data / número: LSL, USL. Unidade de medida: LSL, USL, UoM. Aplicabilidade/descritivo: TargetValue"
              },
              {
                "$id": "6691",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Veuillez remplir toutes les valeurs d’attribut obligatoire avant de procéder : Date / Numéro : LSL, USL. Unité de mesure : LSL, USL, unité de mesure. Applicabilité/descriptif : TargetValue"
              },
              {
                "$id": "6692",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请填写所有必填属性值之前： 日期 / 数量： LSL、 USL。措施： LSL，USL，UoM 的单位。适用性/描述性： 只"
              },
              {
                "$id": "6693",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte füllen Sie alle obligatorischen Attributwerte, bevor Sie fortfahren: Datum / Zahl: LSL, USL. Einheit der Maßnahme: LSL, USL, UoM. Anwendbarkeit/beschreibenden: TargetValue"
              },
              {
                "$id": "6694",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please fill out all mandatory attribute values before proceeding: Date/Number:LSL,USL. Unit of Measure:LSL,USL,UoM. Applicability/Descriptive:TargetValue"
              },
              {
                "$id": "6695",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor llene todos los valores de atributo obligatorios antes de continuar: fecha / número: LSL, USL. Unidad de medida: LSL, USL, UoM. Aplicabilidad/descriptivo: TargetValue"
              }
            ]
          },
          {
            "$id": "6696",
            "IsPublished": true,
            "MetaResourceKey": "1111865e-9a6b-4f9f-a45d-c119ac92c9b0",
            "DefaultValue": "Please provide Comments for rejecting the approval.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6697",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, fornece comentários para rejeitar a aprovação."
              },
              {
                "$id": "6698",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please provide Comments for rejecting the approval."
              },
              {
                "$id": "6699",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请提供意见，拒绝批准。"
              },
              {
                "$id": "6700",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Veuillez fournir des commentaires pour rejeter l’approbation."
              },
              {
                "$id": "6701",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Proporcione comentarios para rechazar la aprobación."
              },
              {
                "$id": "6702",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte geben Sie Kommentare für die Ablehnung der Genehmigung."
              }
            ]
          },
          {
            "$id": "6703",
            "IsPublished": true,
            "MetaResourceKey": "17abe142-70a9-46f7-b22d-adf479e02704",
            "DefaultValue": "All approvers must approve before the item can be released.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6704",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Todos os aprovadores devem aprovar antes que o item pode ser liberado."
              },
              {
                "$id": "6705",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "可以发布该项目之前，必须得到批准所有审批者。"
              },
              {
                "$id": "6706",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "All approvers must approve before the item can be released."
              },
              {
                "$id": "6707",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Todos los aprobadores deben aprobar antes de que el elemento puede ser liberado."
              },
              {
                "$id": "6708",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Alle genehmigenden Personen müssen genehmigt werden, bevor der Artikel freigegeben werden kann."
              },
              {
                "$id": "6709",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Tous les approbateurs doivent approuver avant que l’élément peut être libéré."
              }
            ]
          },
          {
            "$id": "6710",
            "IsPublished": true,
            "MetaResourceKey": "669b3cdc-c029-4da4-b759-9f0902dfd9ef",
            "DefaultValue": "Please provide the 'Attempt Closing Remarks' before cancelling the approval.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6711",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte geben Sie \"Versuch schließen Anmerkungen\" vor der Stornierung der Genehmigung."
              },
              {
                "$id": "6712",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请在取消批准之前提供尝试关闭备注。"
              },
              {
                "$id": "6713",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Forneça por favor a 'tentativa de fechamento observações' antes de cancelar a aprovação."
              },
              {
                "$id": "6714",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please provide the 'Attempt Closing Remarks' before cancelling the approval."
              },
              {
                "$id": "6715",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
