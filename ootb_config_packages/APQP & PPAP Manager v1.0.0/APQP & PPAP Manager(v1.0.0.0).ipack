          "Name": "HelpRevTypeObs",
          "Span": false,
          "SpellCheck": true,
          "Tooltip": null,
          "UseTypeViewSettings": false
        },
        "LocalizationData": {
          "$id": "8188",
          "Caption": {
            "$id": "8189",
            "fr": "D’assistance révision Type obsolète ou initier le changement",
            "de": "Helfer Überarbeitung veralteter oder initiieren Typänderung",
            "en-US": "Helper Revision Type Obsolete or Initiate Change",
            "zh": "帮助器版本类型过时或自行更改",
            "pt": "Auxiliar revisão tipo obsoleto ou iniciar mudança",
            "es": "Ayudante revisión tipo obsoleto o iniciar el cambio"
          },
          "Description": {
            "$id": "8190",
            "fr": "Champ de relation permet d’initier des changements ou obsolète un élément actif.\n(Nous utilisons deux champs pour type de révision donc nous pouvons masquer/afficher les options appropriées avec actions de vue fondées sur l’état actuel de la facturation).",
            "de": "Beziehung-Feld verwendet, um Veränderungen initiieren oder veraltet ein aktives Element.\n(Wir verwenden zwei Felder für Versionstyp, damit wir/die entsprechenden Optionen mit Anzeigen von Aktionen basierend auf dem aktuellen Elementstatus ausblenden kann.)",
            "en-US": "Relation field used to initiate change or obsolete an active item.\r\n(We use two fields for revision type so we can hide/show the appropriate options with view actions based on the current item status.)",
            "zh": "用于启动变革或过时的活动项目的关系字段。\n（我们使用两个字段为修订的类型所以我们可以隐藏/显示适当的选项与视图操作基于当前项的状态）。",
            "pt": "Campo de relação usado para iniciar a mudança ou obsoleto um item ativo.\n(Usamos dois campos para tipo de revisão para que nós pode mostrar/esconder as opções apropriadas com ações de exibição com base no status do produto atual).",
            "es": "Campo de relación utilizado para iniciar el cambio o el obsoleto un elemento activo.\n(Usamos dos campos de tipo de revisión por lo que podemos ocultar/mostrar las opciones adecuadas con acciones de vista basados en el estado actual del artículo.)"
          },
          "Hint": {
            "$id": "8191",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
          "Tooltip": {
            "$id": "8192",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          }
        },
