          "$id": "5564",
          "Id": "13b73117-8f6b-43f2-ad74-9c636bf49f86",
          "DetailDisplayFormat": null,
          "DetailEditMask": null,
          "FieldName": "DateClosed",
          "InventoryDisplayFormat": null,
          "InventoryEditMask": null,
          "IsLocalizable": false,
          "MaxLength": null,
