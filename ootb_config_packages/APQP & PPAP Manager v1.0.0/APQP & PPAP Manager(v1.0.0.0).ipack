          "Caption": "Good/Service Category List",
          "Category": null,
          "DefaultValue": "",
          "Description": "Good/Service category can have other good/service categories underneath it. For example, Baked Goods can have Breads and Cakes underneath it.",
          "DetailDisplayAs": null,
          "DetailEditAs": null,
          "DetailEmptyText": null,
          "Hint": null,
          "InventoryDisplayAs": null,
