            "MetaResourceKey": "71dcb826-f475-44e4-8b9e-71bc35431fb0",
            "DefaultValue": "Please fill out the 'Completion Notes'.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "3676",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte füllen Sie \"Fertigstellung Notes\"."
              },
              {
                "$id": "3677",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please fill out the 'Completion Notes'."
              },
              {
                "$id": "3678",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor llene las notas de la terminación."
              },
              {
                "$id": "3679",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Merci de remplir le « Notes d’achèvement »."
              },
              {
                "$id": "3680",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请填写 ' 完成笔记 '。"
              },
              {
                "$id": "3681",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, preencha as 'notas de conclusão'."
              }
            ]
          },
          {
            "$id": "3682",
            "IsPublished": true,
            "MetaResourceKey": "4881fd06-8e36-4038-9bc2-e20d14017a37",
            "DefaultValue": "Please answer all the checklist questions to complete the task.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "3683",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Veuillez répondre à toutes les questions de la liste de contrôle pour achever la tâche."
              },
              {
                "$id": "3684",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please answer all the checklist questions to complete the task."
              },
              {
                "$id": "3685",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor responda todas las preguntas de la lista de verificación para completar la tarea."
              },
              {
                "$id": "3686",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请回答所有清单问题，以完成任务。"
              },
              {
                "$id": "3687",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, responda todas as perguntas da lista de verificação para concluir a tarefa."
              },
              {
                "$id": "3688",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte beantworten Sie alle Fragen der Checkliste um die Aufgabe abzuschließen."
              }
            ]
          },
          {
            "$id": "3689",
            "IsPublished": true,
            "MetaResourceKey": "ace51aeb-30a6-4702-b579-cbf4e54821e6",
            "DefaultValue": "All Question Answers are required to complete task.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "3690",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Las respuestas de la pregunta deben completar la tarea."
              },
              {
                "$id": "3691",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "所有的问题答案是完成任务所需的。"
              },
              {
                "$id": "3692",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Alle Frage Antworten sind verpflichtet, die Aufgabe abzuschließen."
              },
              {
                "$id": "3693",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "All Question Answers are required to complete task."
              },
              {
                "$id": "3694",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Todas as respostas da pergunta são necessários para concluir a tarefa."
              },
              {
                "$id": "3695",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Toutes les réponses de la Question sont nécessaires pour terminer la tâche."
              }
            ]
          }
