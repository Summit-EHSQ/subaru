          "Caption": "Skip Product Development",
          "Category": null,
          "DefaultValue": "<?xml version=\"1.0\" encoding=\"utf-16\"?><ValueGenerator xmlns:i=\"http://www.w3.org/2001/XMLSchema-instance\" i:type=\"StaticValueGeneratorOfNullableOfboolean5F2dSckg\" xmlns=\"http://schemas.intelex.net\"><Value>false</Value></ValueGenerator>",
          "Description": "Option to skip the Product Design & Development gate where the customer does not do any design work.",
          "DetailDisplayAs": null,
          "DetailEditAs": null,
          "DetailEmptyText": null,
          "Hint": null,
          "InventoryDisplayAs": null,
