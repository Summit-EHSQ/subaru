        "GraphData": {
          "$id": "362",
          "Items": [
            {
              "$id": "363",
              "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
              "RecordId": "db4b930d-762c-4b9f-8149-6d4e9b4f4fde",
              "ObjectName": "DasDashboardEntity",
              "FieldData": {
                "$id": "364",
                "Id": "db4b930d-762c-4b9f-8149-6d4e9b4f4fde",
                "BiDashboardId": 28,
                "Caption": "[A&PM] APQP Status Dashboard",
                "Description": "This dashboard  helps a project owner quickly assess the status of APQPs. This includes progress of open APQPs and open tasks to be completed.",
                "Metadata": "{}"
              },
              "LocalizationData": {
                "$id": "365",
                "Caption": {
                  "$id": "366",
                  "fr": "[A & PM] APQP Status Dashboard",
                  "de": "[A & PM] APQP Status Dashboard",
                  "en-US": "[A&PM] APQP Status Dashboard",
                  "zh": "[A & PM]APQP 状态仪表板",
                  "pt": "[A & PM] Painel de Status do APQP",
                  "es": "[A Y PM] Tablero de estado APQP"
                },
                "Description": {
                  "$id": "367",
                  "fr": "Ce tableau de bord permet à un maître d’ouvrage d’évaluer rapidement l’état de APQPs. Cela inclut les progrès des APQPs ouverts et ouverts tâches restant à accomplir.",
                  "de": "Dieses Dashboard hilft einen Projektbesitzer schnell den Status des APQPs zu bewerten. Dabei stand der offenen APQPs und offene Aufgaben abgeschlossen werden.",
                  "en-US": "This dashboard  helps a project owner quickly assess the status of APQPs. This includes progress of open APQPs and open tasks to be completed.",
                  "zh": "此仪表板可以帮助快速评估现状，APQPs 项目业主。这包括开放 APQPs 和打开任务完成的进度。",
                  "pt": "Este painel de ajuda um dono do projeto avaliar rapidamente o status de APQPs. Isso inclui o progresso de tarefas abertas e APQPs abertos para ser concluída.",
                  "es": "Este panel ayuda a un propietario del proyecto a evaluar rápidamente el estado de APQPs. Esto incluye avances de APQPs abiertos y abiertas tareas a realizar."
                }
              },
              "Id": "8c06653e-5e0c-4146-abe1-e2eefd85d0e1",
              "Caption": "[A&PM] APQP Status Dashboard",
              "Type": "Dashboard",
              "Version": null,
