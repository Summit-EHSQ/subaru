          "ConfigurableViewActions": "[{\"__type\":\"AdvancedViewAction\",\"enabled\":true,\"name\":\"Show\\/Hide Project Role\",\"stageContainers\":[],\"content\":\"{\\u000a        onPageLoad: true,\\u000a        triggers: ['ProjectRole'],\\u000a        actions: [{\\u000a                __type: 'decision',\\u000a                condition: function () {\\u000a                        return Intelex.DetailPage.getField('ProjectRole').value.eq('');\\u000a                },\\u000a                trueDecision: [{\\u000a                        __type: 'hide',\\u000a                        elements: ['ProjectRole', 'PersResponsible']\\u000a                }, {\\u000a                        __type: 'show',\\u000a                        elements: ['PersonResp']\\u000a                }],\\u000a                falseDecision: [{\\u000a                        __type: 'show',\\u000a                        elements: ['ProjectRole', 'PersResponsible']\\u000a                }, {\\u000a                        __type: 'hide',\\u000a                        elements: ['PersonResp']\\u000a                }]\\u000a        }]\\u000a}\"}]",
          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:CancelActionLink Override=\"false\" DisplayMode=\"Create\"/><ix:CancelActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/><ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:SecurityActionLink Override=\"true\" Visible=\"false\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"True\" UseDefaultWhenCompleted=\"False\" UseDefaultWhenCancelled=\"False\" VisibleFor=\"Open\" ID=\"StageContainer_e9f79b\"><ix:DetailSection Title=\"Task Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"string\" For=\"Location\" ReadOnly=\"True\" DisplayMode=\"Edit,View\"/><ix:Field DisplayMode=\"edit,view\" For=\"ActionNo\"/><ix:Field For=\"Project\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Phase\" ReadOnly=\"True\"/><ix:Field For=\"Description\" IsMandatory=\"True\" ToolTipText=\"Provides detail on what is required of the person assigned.\" SpellCheck=\"false\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field For=\"PersonResp\" IsMandatory=\"true\" DisplayMode=\"Create,Edit\"/><ix:Field For=\"ProjectRole\" ReadOnly=\"True\"/><ix:Field For=\"Project.ProjectType.Name\" Visible=\"false\"/><ix:Field For=\"PersResponsible.Member\" Visible=\"false\"/><ix:Field For=\"Project:APQP_APQPObject.ProcessOwner\" Visible=\"false\"/><ix:Field For=\"Project:APQP_PPAPAbstractObject.ProjectOwner\" Visible=\"false\"/></ix:FieldArea><% if ((ViewData.Eval(\"ProjectRole\") != null )  && !(ViewData.Eval(\"ProjectRole\").ToString().Equals(\"\")) && (ViewData.Eval(\"PersResponsible\") != null ) && (ViewData.Eval(\"PersResponsible.Member\") == null )) { %>\n<%   if (ViewData.Eval(\"Project.ProjectType.Name\").ToString().Equals(\"APQP\")){ %><ix:FieldArea Span=\"true\"><ix:Field For=\"Project.ProcessOwner\" ID=\"ProcessOwnerView\" Caption=\"Person Responsible\" meta:resourcekey=\"Field4\" ResourceKey=\"Field4\"/></ix:FieldArea><%   } else {%><ix:FieldArea Span=\"true\"><ix:Field For=\"Project.ProjectOwner\" ID=\"ProjectOwnerView\" Caption=\"Person Responsible\" meta:resourcekey=\"Field6\" ResourceKey=\"Field6\"/></ix:FieldArea><%   } %>\n<% } else { %><ix:FieldArea Span=\"true\"><ix:Field For=\"PersonResp\" IsMandatory=\"true\" DisplayMode=\"View\"/><ix:Field For=\"PersResponsible\" IsMandatory=\"true\"/></ix:FieldArea><% } %>\n\n<% if((ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Open\"))) { %><ix:FieldArea Span=\"true\"><ix:Field For=\"DueDate\" IsMandatory=\"True\"/><ix:Field Span=\"true\"/><ix:Field DisplayMode=\"view,edit\" For=\"CompletionNotes\" SpellCheck=\"false\" ToolTipText=\"Details and/or additional information.\" meta:resourcekey=\"Field1\" ResourceKey=\"Field1\"/><ix:Field DisplayMode=\"view,edit\" For=\"CompletionDate\"/><ix:Field Visible=\"False\" For=\"Workflow.WorkflowStatus\"/></ix:FieldArea><% } else { %><ix:FieldArea Span=\"true\"><ix:Field For=\"DueDate\"/><ix:Field Span=\"true\"/></ix:FieldArea><% } %></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"False\" UseDefaultWhenCompleted=\"True\" UseDefaultWhenCancelled=\"True\" ID=\"StageContainer_a77c9b\"><ix:DetailSection Title=\"Task Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" meta:resourcekey=\"DetailSection1\" ResourceKey=\"DetailSection1\"><ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"string\" For=\"Location\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"edit,view\" For=\"ActionNo\"/><ix:Field For=\"Project\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Phase\" ReadOnly=\"True\"/><ix:Field For=\"Description\" IsMandatory=\"True\" ReadOnly=\"True\" EditReadOnly=\"True\" ToolTipText=\"Provides detail on what is required of the person assigned.\" SpellCheck=\"false\" meta:resourcekey=\"Field2\" ResourceKey=\"Field2\"/><ix:Field For=\"ProjectRole\" ReadOnly=\"True\"/><ix:Field For=\"CompletedBy\" IsMandatory=\"true\" ReadOnly=\"True\"/><ix:Field For=\"DueDate\" ReadOnly=\"True\"/><ix:Field Span=\"true\"/><ix:Field For=\"CompletionNotes\" DisplayMode=\"view,edit\" ToolTipText=\"Details and/or additional information.\" SpellCheck=\"false\" ReadOnly=\"True\" EditReadOnly=\"True\" IsMandatory=\"true\" meta:resourcekey=\"Field3\" ResourceKey=\"Field3\"/><ix:Field For=\"CompletionDate\" DisplayMode=\"view,edit\" ReadOnly=\"True\" EditReadOnly=\"True\" IsMandatory=\"true\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:AttachmentSection ID=\"AttachmentFragmentGridSection\" DisplayMode=\"View,Edit\" IsCollapsed=\"True\"/></ix:DetailPage>",
