        "LocalizationData": {
          "$id": "7862",
          "Caption": {
            "$id": "7863",
            "fr": "Exigences de certification",
            "de": "Anforderungen für die Zertifizierung",
            "en-US": "Certification Requirements",
            "zh": "认证要求",
            "pt": "Requisitos de certificação",
            "es": "Requisitos de certificación"
          },
          "Description": {
            "$id": "7864",
            "fr": "Les deux sociétés mères fournisseur et installations peuvent avoir des exigences de certification qui leur sont rattachés, d'où la relation est faite pour le fournisseur abstraite.",
            "de": "Sowohl Lieferanten Muttergesellschaften und Einrichtungen können Zertifizierungsanforderungen zu ihnen angebracht, damit die Beziehung erfolgt an den Lieferanten abstrakte.",
            "en-US": "Both supplier parent companies and facilities can have certification requirements attached to them, hence the relation is being made to the supplier abstract.",
            "zh": "两个供应商的母公司和设施可以有附加到他们的认证要求，因此关系正在向供应商抽象。",
            "pt": "Tanto fornecedor empresas-mãe e instalações podem ter requisitos de certificação que lhes são inerentes, portanto, a relação está sendo feita ao fornecedor abstrata.",
            "es": "Ambas empresas de padre proveedor y servicios pueden tener requisitos de certificación fijados a ellos, por lo tanto, la relación se está haciendo al proveedor Resumen."
          },
          "Hint": {
            "$id": "7865",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
          "Tooltip": {
            "$id": "7866",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          }
        },
        "Id": "9cc5cb81-a511-4f63-89f4-be5598c3b4f2",
        "Caption": "Certification Requirements",
        "Type": "Field",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 1,
        "IsHidden": false
      },
