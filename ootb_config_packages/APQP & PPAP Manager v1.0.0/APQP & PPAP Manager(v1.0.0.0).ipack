        "LocalizationData": {
          "$id": "5736",
          "Caption": {
            "$id": "5737",
            "fr": "Nom de la catégorie",
            "de": "Kategorienamen",
            "en-US": "Category Name",
            "zh": "类别名称",
            "pt": "Nome da categoria",
            "es": "Nombre de la categoría"
          },
          "Description": {
            "$id": "5738",
            "fr": "Nom d’une catégorie qui sera utilisée pour regrouper un ensemble logique de produits/services. Par exemple, produits de boulangerie ou marchandises surgelées.",
            "de": "Name einer Kategorie, die verwendet wird, um einen logischen Satz von Waren/Dienstleistungen zu gruppieren. Zum Beispiel Gebäck oder TK-Ware.",
            "en-US": "Name of a category that will be used to group a logical set of goods/services. For example, baked goods or frozen goods.",
            "zh": "将用于逻辑组的商品和服务类别的名称。例如，烘焙或冻的品。",
            "pt": "Nome de uma categoria que será usada para agrupar um conjunto lógico de produtos e serviços. Por exemplo, bens cozidos ou congelados.",
            "es": "Nombre de una categoría que se utiliza para agrupar un conjunto lógico de productos y servicios. Por ejemplo, los productos horneados o congelados."
          },
