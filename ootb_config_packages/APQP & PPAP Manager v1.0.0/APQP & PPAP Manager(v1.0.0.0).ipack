                        "es": "<p>This notification is to inform you that <span style=\"color:#222222;letter-spacing:0.35px;background-color:#ffffff;\">{#DisplayField}</span> has been rejected.</p><p>&nbsp;</p><span style=\"color:#222222;letter-spacing:0.35px;background-color:#ffffff;\">Product - {#Product.Name}</span><br style=\"color:#222222;font-family:'Open Sans', sans-serif;font-size:14px;letter-spacing:0.35px;background-color:#ffffff;\" /><br style=\"color:#222222;font-family:'Open Sans', sans-serif;font-size:14px;letter-spacing:0.35px;background-color:#ffffff;\" /><span style=\"color:#222222;letter-spacing:0.35px;background-color:#ffffff;\">Part Number - {#Product}</span><p>&nbsp;</p>____________________________________________<br /><br /><a href=\"{#System.Link}\">Click here for more details</a>"
                      },
