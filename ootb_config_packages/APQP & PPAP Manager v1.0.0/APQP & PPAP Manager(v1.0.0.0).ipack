        "FieldData": {
          "$id": "8187",
          "Id": "37ee4174-358f-465d-bcdd-28399969f8ee",
          "AllowPermissionOverride": false,
          "BypassSecurity": false,
          "FilterExpression": "{\"__type\":\"Expression\",\"Operator\":0,\"Predicates\":[{\"__type\":\"Common\",\"Type\":1,\"Operand\":{\"__type\":\"Value\",\"Parse\":false,\"Text\":\"Reactivate Item\",\"ID\":null},\"For\":\"Name\",\"Negate\":true}]}",
          "FilterType": 2,
          "IsStartOfRelation": true,
          "LockRelated": false,
          "OverrideOrder": 0,
          "Calculation": null,
          "Caption": "Helper Revision Type Obsolete or Initiate Change",
          "Category": null,
          "DefaultValue": "<?xml version=\"1.0\" encoding=\"utf-16\"?><ValueGenerator xmlns:i=\"http://www.w3.org/2001/XMLSchema-instance\" i:type=\"EntityValueGeneratorOfProductMgmt_RevisionTypeObjectjuNyfaHs\" xmlns=\"http://schemas.intelex.net\"><Id>fbdd55ce-7b79-4327-ba89-96b7cb65f093</Id></ValueGenerator>",
          "Description": "Relation field used to initiate change or obsolete an active item.\r\n(We use two fields for revision type so we can hide/show the appropriate options with view actions based on the current item status.)",
          "DetailDisplayAs": 1,
          "DetailEditAs": 13,
          "DetailEmptyText": null,
          "Hint": null,
          "InventoryDisplayAs": 1,
          "InventoryEditAs": null,
          "InventoryEmptyText": null,
          "IsAvailableForReporting": false,
