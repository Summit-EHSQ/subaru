        "FieldData": {
          "$id": "2065",
          "Walkthroughs": null,
          "Id": "e008a361-a8c3-4d36-8df6-3ff2434d6d75",
          "Caption": null,
          "ConfigurableViewActions": "[{\"__type\":\"ViewAction\",\"enabled\":true,\"name\":\"Show\\/Hide Corrective Actions Grid\",\"stageContainers\":[],\"actions\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"HiddenDetail\",\"elementType\":0}]},{\"__type\":\"DecisionAction\",\"condition\":{\"__type\":\"ExpressionPredicate\",\"expression\":null,\"predicates\":[{\"__type\":\"SimplePredicate\",\"drilldown\":false,\"leftOperand\":{\"__type\":\"PropertyOperand\",\"propertyName\":\"Settings.EnableCAR\",\"aggregateFunction\":0,\"dataSourceAlias\":null,\"propertyFunction\":null,\"resolveDisplayProperty\":false,\"uom\":null},\"operator\":{\"__type\":\"ViewActionOperator\",\"negate\":false,\"type\":1},\"rightOperand\":{\"__type\":\"ValueOperand\",\"value\":\"true\",\"entityType\":null,\"text\":null}}]},\"falseDecision\":[{\"__type\":\"HideAction\",\"elements\":[{\"elementId\":\"CARsGrid\",\"elementType\":0},{\"elementId\":\"CARsGridClosed\",\"elementType\":0}]}],\"trueDecision\":[{\"__type\":\"ShowAction\",\"elements\":[{\"elementId\":\"CARsGrid\",\"elementType\":0},{\"elementId\":\"CARsGridClosed\",\"elementType\":0}]}]}],\"onPageLoad\":true,\"triggers\":[{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"Settings.EnableCAR\"},{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"Settings.EnableMOC\"},{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"Settings.TaskGridonDraft\"},{\"__type\":\"FieldTrigger\",\"event\":0,\"fieldName\":\"MyCurrentStage\"}]}]",
          "Content": "<ix:DetailPage><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:SaveAddNewActionLink Override=\"true\" Visible=\"False\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/><ix:SaveActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:CancelActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"False\"/><ix:SaveActionLink Override=\"false\" DisplayMode=\"Create\" Caption=\"Continue\" meta:resourcekey=\"SaveActionLink0\" ResourceKey=\"SaveActionLink0\"/><ix:CloneActionLink Override=\"true\" Visible=\"False\"/><ix:CancelActionLink Override=\"false\" DisplayMode=\"Create\"/></ix:DetailPageMenuBar><div class=\"wfDiagram\"><div><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"0\")||( ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"Draft\")) ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"FirstGate\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Plan and Define%>\"/></div></div><div style=\"display:<%= ((ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && !ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"SecondGate\"))||(ViewData.Eval(\"Workflow.CurrentStage.SystemName\") == null) ) && ApplicationSettings.Get<bool>(\"APQP_SettingsObject\", \"SkipGate2\", false)  ? \"none\" : \"\" %>;\"><div style=\"min-height: 38px\" Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"SecondGate\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Product Design and Development%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"ThirdGate\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Process Design and Development%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"FourthGate\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Product and Process Validation%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"FifthGate\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Feedback Assessment and Corrective Action%>\"/></div></div><div style=\"display:<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\") ? \"\" : \"\" %>;\"><div style=\"display:block\" Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\") ? \"Green\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Approved%>\"/></div></div></div><ix:DetailSection Title=\"Default Section Title\" Id=\"HiddenDetail\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"True\"><ix:Field For=\"WorkFlow.WorkflowStatus\" Visible=\"False\"/><ix:Field For=\"WorkFlow.CurrentStage.SystemName\" Visible=\"False\"/><ix:Field For=\"Settings.EnableCAR\"/></ix:FieldArea></ix:DetailSection><ix:StageContainer UseDefaultDuringCreate=\"true\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"Draft\" ID=\"StageContainer_d2e419\"><ix:DetailSection Title=\"APQP Details\" Icon=\"Icons/new/48x48/magic-wand.gif\" ModernIcon=\"Raven/Icons/BrightBlue_48/squares36.png\" meta:resourcekey=\"DetailSection1\" ResourceKey=\"DetailSection1\"><ix:FieldArea><ix:Field DisplayAs=\"string\" DisplayMode=\"Create\" For=\"Location\"/><ix:Field DisplayAs=\"string\" DisplayMode=\"Edit,View\" For=\"Location\" ReadOnly=\"true\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Progress\"/><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\"/><ix:Field DisplayMode=\"Edit,View\" For=\"ProgProTasks\"/></ix:FieldArea><ix:FieldArea Span=\"True\"><ix:Field DisplayMode=\"Create\" For=\"ProjectTemplate\" IsMandatory=\"True\"/><ix:Field DisplayMode=\"Edit,View\" For=\"ProjectTemplate\" ReadOnly=\"true\"/><ix:Field For=\"Product\" IsMandatory=\"True\" Caption=\"Part Number\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field For=\"Customer\"/><ix:Field For=\"Supplier\"/><ix:Field For=\"ProcessOwner\"/><ix:Field For=\"PPAPDueDate\"/><ix:Field For=\"SignoffDate\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"FirstGate,SecondGate,ThirdGate,FourthGate,FifthGate\" ID=\"StageContainer_f905d5\"><ix:DetailSection Title=\"APQP Details\" Icon=\"Icons/new/48x48/magic-wand.gif\" ModernIcon=\"Raven/Icons/BrightBlue_48/squares36.png\" meta:resourcekey=\"DetailSection2\" ResourceKey=\"DetailSection2\"><ix:FieldArea><ix:Field DisplayAs=\"string\" DisplayMode=\"Create\" For=\"Location\"/><ix:Field DisplayAs=\"string\" DisplayMode=\"Edit,View\" For=\"Location\" ReadOnly=\"true\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Progress\"/><ix:Field DisplayMode=\"Edit,View\" For=\"RecordNo\"/><ix:Field DisplayMode=\"Edit,View\" For=\"ProgProTasks\"/></ix:FieldArea><ix:FieldArea Span=\"True\"><ix:Field DisplayMode=\"Create\" For=\"ProjectTemplate\"/><ix:Field DisplayMode=\"Edit,View\" 