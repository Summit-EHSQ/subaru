        "FieldData": {
          "$id": "1727",
          "Id": "a117cb9d-1437-44bb-a5dc-1bcaf6fb9993",
          "Description": "Streamlining your quality management system and processes can improve operational efficiency and profitability, prepare your organization to meet the latest regulatory and industry standards.",
          "Index": 9999,
          "IsSystem": null,
          "Name": "Quality"
        },
        "LocalizationData": {
          "$id": "1728",
          "Description": {
            "$id": "1729",
            "fr": "Rationaliser votre système de gestion de qualité et les processus peuvent améliorer la rentabilité et l’efficacité opérationnelle, préparer votre organisation pour répondre à la dernière réglementation et les normes de l’industrie.",
            "de": "Straffung, Ihr Qualitätsmanagement-System und Prozesse können betriebliche Effizienz und Rentabilität verbessern, bereiten Sie Ihre Organisation auf den neuesten regulatorischen Anforderungen erfüllen und Industriestandards.",
            "en-US": "Streamlining your quality management system and processes can improve operational efficiency and profitability, prepare your organization to meet the latest regulatory and industry standards.",
            "zh": "精简你的质量管理体系和流程可以提高运营效率和盈利能力，准备您的组织以满足最新法规和行业标准。",
            "pt": "Racionalização de seus processos e sistema de gestão da qualidade pode melhorar a rentabilidade e eficiência operacional, preparar sua organização para atender a mais recente regulamentação e padrões da indústria.",
            "es": "Racionalización de sus procesos y sistema de gestión de calidad puede mejorar la rentabilidad y eficiencia operacional, preparar su organización para cumplir con la última reglamentación y estándares de la industria."
          },
          "Name": {
            "$id": "1730",
            "fr": "Qualité",
            "de": "Qualität",
            "en-US": "Quality",
            "zh": "质量",
            "pt": "Qualidade",
            "es": "Calidad"
          }
        },
        "Id": "70b16aa2-9164-47b4-8fd9-261303ff1371",
        "Caption": "Quality",
        "Type": "Application Group",
        "Version": null,
        "IfExists": 0,
