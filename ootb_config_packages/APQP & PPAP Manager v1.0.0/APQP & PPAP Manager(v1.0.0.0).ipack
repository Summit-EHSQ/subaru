      {
        "$id": "983",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "1071cf74-b815-42bf-b7fe-d58f6ceb01e3",
        "ObjectName": "SysModuleEntity",
        "FieldData": {
          "$id": "984",
          "Id": "1071cf74-b815-42bf-b7fe-d58f6ceb01e3",
          "Caption": "APQP & PPAP Manager",
          "Description": "This application provides the ability to manage your new product process in Advanced Product Quality Planning (APQP) & Production Part Approval Process (PPAP) management system.",
          "Disabled": false,
          "Index": null,
          "IsAvailableForMobile": false,
          "IsAvailableOffline": false,
          "LegacyModuleId": null,
          "MobileCaption": null,
          "MobileIcon": null,
          "UrlCaption": "APQP",
          "UrlIcon": "Raven/Icons/BrightBlue_48/marketing8.png",
          "VersionNumber": "1.0.0",
          "VersionOrder": 1000000
        },
        "LocalizationData": {
          "$id": "985",
          "Caption": {
            "$id": "986",
            "fr": "APQP & PPAP Manager",
            "de": "APQP & PPAP-Manager",
            "en-US": "APQP & PPAP Manager",
            "zh": "APQP & ppap 文件管理器",
            "pt": "APQP e PPAP Manager",
            "es": "APQP y PPAP Manager"
          },
          "Description": {
            "$id": "987",
            "fr": "Cette application permet de gérer vos processus de nouveaux produits dans la planification avancée qualité produit (APQP) & système de gestion de Production partie agrément processus (PPAP).",
            "de": "Diese Anwendung bietet die Möglichkeit, Ihr neues Produkt Prozess in Advanced Produkt Qualität Planning (APQP) & Produktion Teil Genehmigung Process (PPAP)-Management-System verwalten.",
            "en-US": "This application provides the ability to manage your new product process in Advanced Product Quality Planning (APQP) & Production Part Approval Process (PPAP) management system.",
            "zh": "此应用程序提供管理你新产品过程中产品质量先期策划 (APQP) & 生产部分批准程序 (PPAP) 管理系统的能力。",
            "pt": "Esta aplicação fornece a capacidade para gerir o seu processo de produto novo em avançada qualidade planejamento do produto (APQP) e sistema de gerenciamento de processo de aprovação de parte de produção (PPAP).",
            "es": "Esta aplicación ofrece la posibilidad de gestionar su nuevo producto de avanzada calidad planificación de producto (APQP) y sistema de gestión de proceso de aprobación de parte de producción (PPAP)."
          },
          "MobileCaption": {
            "$id": "988",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          }
        },
        "Id": "eed93dd3-4b91-45f5-9de5-3d7799deb1f1",
        "Caption": "APQP & PPAP Manager",
        "Type": "Application",
        "Version": null,
        "IfExists": 0,
        "IfNotExists": 0,
        "IsHidden": false
      },
