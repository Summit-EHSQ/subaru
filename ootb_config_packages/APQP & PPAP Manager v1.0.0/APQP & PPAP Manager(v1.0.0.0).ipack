              {
                "$id": "6799",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, preencha a justificativa para o cancelamento... precisa ser atualizado por Marcos Vinicius"
              },
              {
                "$id": "6800",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请填写理由取消......需要由 Mastan 更新"
              }
            ]
          },
          {
            "$id": "6801",
            "IsPublished": true,
            "MetaResourceKey": "a57ab224-ddff-4883-93c2-cf72205d5069",
            "DefaultValue": "At least one approver must be selected to start the approval process.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6802",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "At least one approver must be selected to start the approval process."
              },
              {
                "$id": "6803",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Aprovador de pelo menos um deve ser selecionado para iniciar o processo de aprovação."
              },
              {
                "$id": "6804",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Au moins un approbateur doit être sélectionné pour lancer le processus d’approbation."
              },
              {
                "$id": "6805",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Um den Genehmigungsprozess starten muss mindestens eine genehmigende Person ausgewählt werden."
              },
              {
                "$id": "6806",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Debe seleccionarse al menos un aprobador para iniciar el proceso de aprobación."
              },
              {
                "$id": "6807",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "若要启动审批流程，必须选择至少一个审批者。"
              }
            ]
          },
          {
            "$id": "6808",
            "IsPublished": true,
            "MetaResourceKey": "ede32525-b4ae-46b3-b8dd-3c680bdb79cd",
            "DefaultValue": "All approval tasks must be 'Approved' before the item can be released.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6809",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Toutes les tâches d’approbation doivent être « approuvées » avant que l’élément peut être libéré."
              },
              {
                "$id": "6810",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "所有审批任务必须 '都批准' 之前可以发布该项目。"
              },
              {
                "$id": "6811",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "All approval tasks must be 'Approved' before the item can be released."
              },
              {
                "$id": "6812",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Todas as tarefas de aprovação devem ser 'aprovadas' antes que o item pode ser liberado."
              },
              {
                "$id": "6813",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Alle Genehmigungsaufgaben müssen \"genehmigt werden\", bevor der Artikel freigegeben werden kann."
              },
              {
                "$id": "6814",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Todas las tareas de aprobación deben ser 'aprobadas' antes de que el elemento puede ser liberado."
              }
            ]
          },
          {
            "$id": "6815",
            "IsPublished": true,
            "MetaResourceKey": "c05601f3-34cb-4580-9194-2261fbd84bcf",
            "DefaultValue": "Item need to be approved by all approvers.....need to be updated by Mastan.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6816",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Artikel müssen alle genehmigenden Personen... der Genehmigung von Mastan aktualisiert werden müssen."
              },
              {
                "$id": "6817",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Artigo precisa ser aprovada por todos os aprovadores... precisam ser atualizados por João Pedro."
              },
              {
                "$id": "6818",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Artículo a ser aprobado por todos los aprobadores... necesita ser actualizado por Mastan."
              },
              {
                "$id": "6819",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Point besoin d’être approuvée par tous les approbateurs... doivent être actualisés par Mastan."
              },
              {
                "$id": "6820",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "项目需要须经所有审批者......需要通过 Mastan 进行更新。"
              },
              {
                "$id": "6821",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Item need to be approved by all approvers.....need to be updated by Mastan."
              }
            ]
          },
          {
            "$id": "6822",
            "IsPublished": true,
            "MetaResourceKey": "76213b07-7d35-4fcf-bb0c-142ff857e08a",
            "DefaultValue": "Attemp passed y u want to reject this...need to be updated by mastan",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "6823",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Tentativa de passado y para rejeitar isto... precisa ser atualizado por Marcos Vinicius"
              },
              {
                "$id": "6824",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Intento pasado y desea rechazar esto... necesitan ser actualizados por mastan"
              },
              {
                "$id": "6825",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Attemp passé y vouloir rejeter cela... doivent être mis à jour par yaye fatou"
              },
              {
                "$id": "6826",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Attemp passed y u want to reject this...need to be updated by mastan"
              },
              {
                "$id": "6827",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "尝试通过的 y 您想要拒绝这...需要由 mastan 更新"
              },
              {
                "$id": "6828",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Übergeben Sie dies ablehnen möchten... y Attemp von Mastan aktualisiert werden müssen"
              }
            ]
          },
