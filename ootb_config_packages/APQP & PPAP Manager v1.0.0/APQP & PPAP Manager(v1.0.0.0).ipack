        "LocalizationData": {
          "$id": "3889",
          "Caption": {
            "$id": "3890",
            "fr": "Indicateur de mise en garde PPAP",
            "de": "PPAP-Vorsicht-Indikator",
            "en-US": "PPAP Caution Indicator",
            "zh": "PPAP 警告指示灯",
            "pt": "Indicador de advertência PPAP",
            "es": "Indicador de advertencia PPAP"
          },
          "Description": {
            "$id": "3891",
            "fr": "Indicateur de mise en garde s’applique à mettre en surbrillance jaune vers l’affichage de la grille.  Cela indique que la tâche ou le dossier est à venir être achevés.",
            "de": "Vorsicht-Indikator gilt gelbe Hervorhebung in der Grid-Ansicht.  Dies bedeutet, dass die Aufgabe oder den Datensatz Fertigstellung kommt.",
            "en-US": "Caution indicator applies yellow highlight to the grid view.  This indicates that the task or record is coming due for completion.",
            "zh": "警告指示灯适用于网格视图的黄色突出显示框。 这表明任务或记录即将到期完竣。",
            "pt": "Indicador de precaução aplica-se a destaque amarelo para o modo de exibição de grade.  Isso indica que a tarefa ou o registro está vindo devido para a conclusão.",
            "es": "Indicador de precaución aplica resaltado amarillo a la vista de cuadrícula.  Esto indica que la tarea o el registro está por venir debido para la terminación."
          },
          "Hint": {
            "$id": "3892",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
