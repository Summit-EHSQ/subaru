          "Description": "Calculate the number of Days the Nonconformance was open.",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"NumDaysOpen\",\"value\":\"DateClosed - DateCreate\"}],\"else\":[{\"__type\":\"setvalue\",\"field\":\"NumDaysOpen\",\"value\":\"TODAY - DateCreate\"}],\"condition\":\"DateClosed <>NULL\\n\"}]",
