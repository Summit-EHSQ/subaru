              "LocalizationData": {
                "$id": "1067",
                "Caption": {
                  "$id": "1068",
                  "fr": "Condition de départ",
                  "de": "Startbedingung",
                  "en-US": "Start Condition",
                  "zh": "启动条件",
                  "pt": "Condição de início",
                  "es": "Condición de inicio"
                },
                "Description": {
                  "$id": "1069",
                  "fr": "Il s’agit d’une condition de départ de flux de travail qui exige que la Date d’échéance être entré avant le flux de travail va commencer.",
                  "de": "Dies ist ein Workflow Startbedingung, wonach das Fälligkeitsdatum eingegeben werden, bevor der Workflow startet.",
                  "en-US": "This is a workflow start condition which requires the Due Date to be entered before workflow will begin.",
                  "zh": "这是一个工作流开始条件要求之前工作流将开始输入截止日期。",
                  "pt": "Esta é uma condição de início de fluxo de trabalho que exige que a data de vencimento a ser inserido antes de fluxo de trabalho vai começar.",
