        "LocalizationData": {
          "$id": "8563",
          "Caption": {
            "$id": "8564",
            "fr": "Évaluations de fournisseur",
            "de": "Lieferantenbewertungen",
            "en-US": "Supplier Evaluations",
            "zh": "供应商的评价",
            "pt": "Avaliações do fornecedor",
            "es": "Evaluaciones del proveedor"
          },
          "Description": {
            "$id": "8565",
            "fr": "Les sociétés mères et installations peuvent avoir 1 ou plusieurs évaluations de fournisseur habituellement sur une période de fréquence définie.",
            "de": "Mutter- und Einrichtungen können 1 oder mehrere Lieferantenbewertungen in der Regel über einen Zeitraum von eingestellten Frequenz haben.",
            "en-US": "Both parent companies and facilities can have 1 or more supplier evaluations usually on a set frequency period.",
            "zh": "母公司和设施可以有 1 或多个供应商的评价通常设置的频率段。",
            "pt": "Os meios e empresas-mãe podem ter 1 ou mais avaliações de fornecedor geralmente em um período de ajuste de frequência.",
            "es": "Empresas matrices y las instalaciones pueden tener 1 o más evaluaciones del proveedor generalmente en un período de frecuencia determinado."
          },
          "Hint": {
            "$id": "8566",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
