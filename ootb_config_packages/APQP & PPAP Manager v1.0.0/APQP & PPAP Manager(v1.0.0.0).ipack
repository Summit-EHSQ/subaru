              {
                "$id": "4576",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "当添加任务，不要忘记选择的门就应该完成的。"
              },
              {
                "$id": "4577",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "When adding tasks, don't forget to choose the gate it should be completed in."
              },
              {
                "$id": "4578",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Al agregar tareas, no olvides de elegir la puerta en que se debe terminar."
              },
              {
                "$id": "4579",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Ao adicionar tarefas, não se esqueça de escolher o portão, em que ele deve ser completado."
              },
              {
                "$id": "4580",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Lorsque vous ajoutez des tâches, n’oubliez pas de choisir la porte, en qu'elle devrait être terminée."
              },
              {
                "$id": "4581",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Wenn Sie Aufgaben hinzufügen, vergessen Sie nicht, das Tor zu wählen, die, dem es fertiggestellt werden soll."
