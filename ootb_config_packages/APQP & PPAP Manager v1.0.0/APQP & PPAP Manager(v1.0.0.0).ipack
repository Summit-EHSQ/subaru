        "LocalizationData": {
          "$id": "5746",
          "Caption": {
            "$id": "5747",
            "fr": "Recommandé pour les",
            "de": "Empfohlen für",
            "en-US": "Recommended For",
            "zh": "建议",
            "pt": "Recomendado para",
            "es": "Se recomienda para"
          },
          "Description": {
            "$id": "5748",
            "fr": "Permet d’afficher les tâches (par Type de projet) au cours de la création de modèles de projet.",
            "de": "Bietet eine Möglichkeit, Aufgaben (nach Projekttyp) während der Projekterstellung Vorlage anzeigen.",
            "en-US": "Provides a way to view tasks (by Project Type) during project template creation.",
            "zh": "提供在项目模板创建期间查看任务 （按项目类型） 的办法。",
            "pt": "Fornece uma maneira para exibir tarefas (por tipo de projeto) durante a criação do modelo de projeto.",
            "es": "Proporciona una manera de ver las tareas (por tipo de proyecto) durante la creación de plantillas de proyecto."
          },
          "Hint": {
            "$id": "5749",
            "fr": "",
