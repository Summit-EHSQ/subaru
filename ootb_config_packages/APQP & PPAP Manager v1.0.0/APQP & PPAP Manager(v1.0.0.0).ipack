        "FieldData": {
          "$id": "7718",
          "Id": "97d3ff99-a367-47fe-8f12-8fa8ea72d740",
          "Caption": "CAR List",
          "ConfigurableViewActions": "[]",
          "Content": "<ix:InventoryPage><% if(ApplicationSettings.Get<bool>(\"CAR_SettingsObject\", \"Enable8D\", true) == false) { %><ix:Inventory ID=\"ComplyFramework_CARAbstractObjectInventory\"><ix:InventoryView ID=\"ComplyFramework_CARAbstractObjectInventoryView\" Caption=\"CAR List\" meta:resourcekey=\"InventoryView0\" ResourceKey=\"InventoryView0\"><Entities><ix:ExcludeEntity name=\"CAR_EightDCARObject\"/></Entities><Sorting><ix:Sort runat=\"server\" By=\"RecordNo\" Direction=\"Descending\"/></Sorting><aliases><ix:Alias For=\"RPN\" Name=\"RPN\"/><ix:Alias For=\"Settings.RPNThreshold\"/><ix:Alias For=\"Settings.CriticThreshold\"/></aliases><Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\"/><ix:Column For=\"Location\" displayas=\"string\"/><ix:Column For=\"IssuDescription\" displayas=\"truncate\" width=\"100%\" wrap=\"true\"/><ix:Column Caption=\"CAR Type\" For=\"SystemType.Caption\" meta:resourcekey=\"Column0\" ResourceKey=\"Column0\"/><ix:Column For=\"RelatedEvents.Description\" caption=\"Related Events\" displayas=\"collection\" fetchas=\"collection\" wrap=\"true\"/><ix:Column For=\"BusinessImpact\" displayas=\"list\" fetchas=\"collection\" width=\"40%\"/><ix:TemplateColumn For=\"RPN\" Caption=\"RPN\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><template><div class=\"<%# Container.ViewData.Eval(\"Settings.RPNThreshold\").ToString()  ==  \"\" ? \"\" : Convert.ToInt32(Container.ViewData.Eval(\"RPN\")) >= Convert.ToInt32(Container.ViewData.Eval(\"Settings.RPNThreshold\")) ?  \"redDiv\" :\"\" %>\"><%#Container.ViewData.Eval(\"RPN\") %></div></template></ix:TemplateColumn><ix:TemplateColumn For=\"Criticality\" Caption=\"Criticality\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn1\" ResourceKey=\"TemplateColumn1\"><template><div class=\"<%# Container.ViewData.Eval(\"Settings.CriticThreshold\").ToString()  ==  \"\" ? \"\" : Convert.ToInt32(Container.ViewData.Eval(\"Criticality\")) >= Convert.ToInt32(Container.ViewData.Eval(\"Settings.CriticThreshold\")) ?  \"redDiv\" :\"\" %>\"><%#Container.ViewData.Eval(\"Criticality\") %></div></template></ix:TemplateColumn><ix:Column For=\"DateCreate\" format=\"d\"/><ix:Column For=\"Workflow.PersonResponsible\" displayas=\"string\"/><ix:Column For=\"Workflow.Status\"/><ix:Column EditMode=\"Inline\" For=\"DateClosed\"/></Columns></ix:InventoryView></ix:Inventory><% } %>\n                \n                \n                          <% else if(ApplicationSettings.Get<bool>(\"CAR_SettingsObject\", \"EnableCAR\", true) == false) { %><ix:Inventory ID=\"ComplyFramework_CARAbstractObjectInventory2\"><ix:InventoryView ID=\"ComplyFramework_CARAbstractObjectInventoryView2\" Caption=\"CAR List\" meta:resourcekey=\"InventoryView1\" ResourceKey=\"InventoryView1\"><Entities><ix:ExcludeEntity name=\"CAR_CARObject\"/></Entities><Sorting><ix:Sort runat=\"server\" By=\"RecordNo\" Direction=\"Descending\"/></Sorting><aliases><ix:Alias For=\"RPN\" Name=\"RPN\"/><ix:Alias For=\"Settings.RPNThreshold\"/><ix:Alias For=\"Settings.CriticThreshold\"/></aliases><Columns><ix:Column For=\"RecordNo\" LinkTo=\"default\"/><ix:Column For=\"Location\" displayas=\"string\"/><ix:Column For=\"IssuDescription\" displayas=\"truncate\" width=\"100%\" wrap=\"true\"/><ix:Column Caption=\"CAR Type\" For=\"SystemType.Caption\" meta:resourcekey=\"Column1\" ResourceKey=\"Column1\"/><ix:Column For=\"RelatedEvents.Description\" caption=\"Related Events\" displayas=\"collection\" fetchas=\"collection\" wrap=\"true\"/><ix:Column For=\"BusinessImpact\" displayas=\"list\" fetchas=\"collection\" width=\"40%\"/><ix:TemplateColumn For=\"RPN\" Caption=\"RPN\" HorizontalAlign=\"center\" meta:resourcekey=\"TemplateColumn2\" ResourceKey=\"TemplateColumn2\"><template><div class=\"<%# Container.ViewData.Eval(\"Settings.RPNThreshold\").ToString()  ==  \"\" ? \"\" : Convert.ToInt32(Container.ViewData.Eval(\"RPN\")) >= Convert.ToInt32(Container.ViewData.Eval(\"Settings.RPNThreshol