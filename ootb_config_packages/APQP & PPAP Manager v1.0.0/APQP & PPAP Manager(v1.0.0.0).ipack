cekey=\"MailMergeTemplates0\" ResourceKey=\"MailMergeTemplates0\"/></ix:Panel></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"false\" UseDefaultWhenCompleted=\"false\" UseDefaultWhenCancelled=\"false\" VisibleFor=\"*\" ID=\"StageContainer_8728f0\"><ix:GridSection DisplayEditColumn=\"false\" DisplayMode=\"edit,view\" For=\"ProjRoleTeamMem\" ID=\"TeamMemberGrid\" ModernIcon=\"Raven/Icons/BrightBlue_48/multiple25.png\" Title=\"Contributors\" meta:resourcekey=\"GridSection2\" ResourceKey=\"GridSection2\"><Menu><ix:GridCreateActionLink Override=\"true\" For=\"ProjectRole\" Caption=\"Attach New Role\" Openin=\"popup\" LinkTo=\"ProjectFwk_PFRole_Select/Index\" meta:resourcekey=\"GridCreateActionLink0\" ResourceKey=\"GridCreateActionLink0\"/><ix:GridDeleteActionLink Override=\"true\" visible=\"false\"/></Menu><Sorting><ix:Sort runat=\"server\" By=\"ProjectRole\" Direction=\"Ascending\"/></Sorting><Columns><ix:Column DisplayAs=\"string\" For=\"ProjectRole\"/><ix:TemplateColumn EditMode=\"inline\" For=\"Member\"><Template><div class=\"<%# Container.ViewData.Eval(\"Member\").ToString() != \"\" ? \"\" : \"inlineDiv\"%>\"><%# Container.ViewData.Eval(\"Member\").ToString() != \"\" ? Container.ViewData.Eval(\"Member\") : \"-- Assign Team Member --\"%></div></Template></ix:TemplateColumn></Columns></ix:GridSection><% if((Model.Workflow.CurrentStage != null) &&(Model.Workflow.CurrentStage.SystemName == \"Draft\") && !(ApplicationSettings.Get<bool>(\"APQP_SettingsObject\", \"PPAPHidTskDraft\", true))) { %> \r\n\r\n<% }else { %><ix:Panel Title=\"Project Task Information:\" IsCollapsed=\"true\" meta:resourcekey=\"Panel0\" ResourceKey=\"Panel0\"><p>&#9642;&nbsp;&nbsp; If a Team Member is assigned to a Role in the above Contributors grid, they will receive the Tasks for that Role in Project Tasks.</p><p>&#9642;&nbsp;&nbsp; If no one is assigned to the Role for a Task, the Project Task will be defaulted to the Person Responsible for the PPAP record.</p><p>&#9642;&nbsp;&nbsp; Changing a Team Member in a Role after Project Tasks have been assigned will update any Open tasks for that Role with the updated Team Member.</p><p>&#9642;&nbsp;&nbsp; Project Task workflow status will remain \"Delayed\" until the Due Date is populated. Once a Due Date has been assigned, the Person Responsible for the task will receive an email and the task will appear in their \"My Tasks\" list.</p><p>&#9642;&nbsp;&nbsp; To update Due Date for multiple tasks, check the box next to the Tasks and click on Actions, then Assign Due Dates.  Click on the checkmark beside Due Date, select the desired date, and click Save.</p></ix:Panel><ix:GridSection DisplayMode=\"edit,view\" For=\"ProjectTasks\" HideGroupAddButton=\"true\" ID=\"ProjectTasksGrid\" ModernIcon=\"Raven/Icons/BrightBlue_48/calendar66.png\" PageSize=\"100\"><Actions><ix:MassUpdateAction Caption=\"Assign Due Dates\" ViewName=\"ProjectFwk_ProjectTask_Detail_MassUpdate\" meta:resourcekey=\"MassUpdateAction0\" ResourceKey=\"MassUpdateAction0\"/></Actions><Menu><ix:GridCreateActionLink Override=\"true\" OpenIn=\"popup\" Caption=\"Add New Task\" meta:resourcekey=\"GridCreateActionLink1\" ResourceKey=\"GridCreateActionLink1\"/></Menu><Entities><ix:ExcludeEntity name=\"ProjectFwk_TaskObject\"/></Entities><Sorting><ix:Sort By=\"Phase.Order\" Direction=\"Ascending\"/><ix:Sort By=\"Order\" Direction=\"Ascending\"/></Sorting><grouping><ix:Group By=\"Phase\" HeaderCaption=\"Gate\"/></grouping><aliases><ix:Alias For=\":ProjectFwk_TaskObject.TypeOfRecord.Name\" Name=\"TaskName\"/><ix:Alias For=\":ProjectFwk_TaskObject.TypeOfRecord.ObjSystemName\" Name=\"ObjSystemName\"/><ix:Alias For=\":ProjectFwk_TaskObject.TypeOfRecord.RelatedPath\" Name=\"RelatedPath\"/><ix:Alias For=\":ProjectFwk_TaskObject.HelperTaskId\" Name=\"HelperTaskId\"/><ix:Alias For=\":ProjectFwk_TaskObject.HelpeTaskExists\" Name=\"HelpeTaskExists\"/><ix:Alias For=\"Id\"/><ix:Alias For=\"IsCompleted\"/><ix:Alias For=\":ProjectFwk_ChecklistObject.ChecklistAnswer.Progress\" Name=\"ChecklistProgress\"/><ix:Alias For=\"Project:APQP_PPAPAbstractObject.Settings.PPAPTaskCaution\" Name=\"PPAPTaskCaution\"/></aliases><Columns><ix:Column For=\"ActionNo\" LinkTo=\"default\" Width=\"25px\"/><ix:MergeColumn Caption=\"Type\" For=\"SystemType.Name\" meta:resourcekey=\"MergeColumn2\" ResourceKey=\"MergeColumn2\"><MappedColumns><ix:Column FilterAs=\"Dropdown\" For=\"SystemType.Caption\" MapValue=\"ProjectFwk_TaskObject\"/></MappedColumns><MappedColumns><ix:Column FilterAs=\"Dropdown\" For=\"SystemType.Caption\" MapValue=\"ProjectFwk_AdHocTaskObject\"/></MappedColumns><MappedColumns><ix:TemplateColumn FilterAs=\"Dropdown\" MapValue=\"ProjectFwk_ChecklistObject\" For=\"SystemType.Caption\"><Template><div><%# Container.ViewData.Eval(\"SystemType.Caption\") + \" - \"+String.Format(\"{0:P0}\", Container.ViewData.Eval(\"ChecklistProgress\")) %></div></Template></ix:TemplateColumn></MappedColumns></ix:MergeColumn><ix:Column For=\"Description\"/><ix:Column For=\"ProjectRole\" displayas=\"string\"/><ix:Column DisplayAs=\"string\" For=\"Workflow.PersonResponsible\"/><ix:MergeColumn Caption=\"Due Date\" For=\"IsCompleted\" HorizontalAlign=\"center\" meta:resourcekey=\"MergeColumn3\" ResourceKey=\"MergeColumn3\"><MappedColumns><ix:TemplateColumn MapValue=\"False\" For=\"DueDate\" Format=\"d\" Caption=\"Due Date\" EditMode=\"inline\" RefreshScope=\"row\" EmptyText=\"-- Assign Due Date --\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><template><div class=\"<%# Container.ViewData.Eval(\"DueDate\").ToString() != \"\" ? \n(DateTime) Container.ViewData.Eval(\"DueDate\") < DateTime.Today ? \"redDiv\" : \n(DateTime) Container.ViewData.Eval(\"DueDate\") <= DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"PPAPTaskCaution\"))) ? \"yellowDiv\" :\n(DateTime) Container.ViewData.Eval(\"DueDate\") > DateTime.Today.AddDays(Convert.ToInt32(Container.ViewData.Eval(\"PPAPTaskCaution\"))) ?\"greenDiv\" : \"\" : \"inlineDiv\" %>\"><%# Container.ViewData.Eval(\"DueDate\").ToString() != \"\" ? String.Format(\"{0:MM/dd/yyyy}\", Container.ViewData.Eval(\"DueDate\")) : \"-- Assign Due Date --\"%></div></template></ix:TemplateColumn><ix:Column Caption=\"Due Date\" For=\"DueDate\" Format=\"d\" MapValue=\"True\" meta:resourcekey=\"Column2\" ResourceKey=\"Column2\"/></MappedColumns></ix:MergeColumn><ix:Column For=\"Workflow.WorkflowStatus\"/><ix:MergeColumn Caption=\"Integrated Task\" For=\"HelpeTaskExists\" meta:resourcekey=\"MergeColumn0\" ResourceKey=\"MergeColumn0\"><MappedColumns><ix:TemplateColumn MapValue=\"False\" For=\"Id\"><Template><a title=\"Add Integrated <%# Container.ViewData.Eval(\"TaskName\") %> Record\" class=\"openInPopup\" href=\"<%# HttpEnvironment.SystemApplicationPath %>/DefaultView/<%# Container.ViewData.Eval(\"ObjSystemName\") %>/Create?ProjectType=<%# Container.ViewData.Eval(\"ObjSystemName\").ToString().Equals(\"APQP_PPAPAbstractObject\") ? \"a6aa71e1-4202-4d7f-b583-caddd4c87188\" : \"\" %>&amp;RelatedId=<%# Container.ViewData.Eval(\"Id\") %>&amp;RelatedPath=<%# Container.ViewData.Eval(\"RelatedPath\") %>\"><img src=\"<%= ImageHelper.GetVersionedPath(\"Grid/add.png\") %>\"/></a></Template></ix:TemplateColumn><ix:TemplateColumn MapValue=\"True\" For=\"Task\"><Template><a title=\"View Integrated <%# Container.ViewData.Eval(\"TaskName\")%> Record\" class=\"openInPopup\" href=\"<%# HttpEnvironment.SystemApplicationPath %>/DefaultView/<%# Container.ViewData.Eval(\"ObjSystemName\") %>/View/<%# Container.ViewData.Eval(\"HelperTaskId\") %>\">View <%# Container.ViewData.Eval(\"TaskName\") %></a></Template></ix:TemplateColumn></MappedColumns></ix:MergeColumn><ix:MergeColumn Caption=\"Documents\" For=\"SystemType.Name\" meta:resourcekey=\"MergeColumn1\" ResourceKey=\"MergeColumn1\"><MappedColumns><ix:TemplateColumn MapValue=\"ProjectFwk_TaskObject\" For=\"Id\"><Template><a title=\"Attach File\" class=\"openInPopup\" href=\"<%# HttpEnvironment.SystemApplicationPath %>/Forms/ProjectF