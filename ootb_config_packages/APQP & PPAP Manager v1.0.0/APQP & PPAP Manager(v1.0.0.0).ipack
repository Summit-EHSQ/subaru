          "UseTypeViewSettings": true
        },
        "LocalizationData": {
          "$id": "5565",
          "Caption": {
            "$id": "5566",
            "fr": "Date de fermeture",
            "de": "Datum geschlossen",
            "en-US": "Date Closed",
            "zh": "关闭日期",
            "pt": "Data fechada",
            "es": "Fecha de cierre"
          },
          "Description": {
            "$id": "5567",
            "fr": "Il s’agit d’un champ d’assistance. Il est utilisé pour triger un gestionnaire d’actions pour dégager des flux de travail date d’échéance lorsque le flux de travail est annulé.",
            "de": "Dies ist ein Helfer-Feld. Es wird verwendet, um Triger eine Action-Handler Workflow löschen Fälligkeitsdatum als Workflow wird abgebrochen.",
            "en-US": "This is a helper field. It is used to triger an action handler to clear workflow due date when workflow is cancelled.",
            "zh": "这是一个帮助器字段。它是用来建立操作处理程序以清除工作流到期日期时取消工作流。",
            "pt": "Este é um campo auxiliar. Ele é usado para triger uma manipulador de ação para limpar o fluxo de trabalho data de vencimento quando o fluxo de trabalho é cancelado.",
            "es": "Este es un campo auxiliar. Se utiliza para desencadenar un controlador de acción para eliminar el flujo de trabajo fecha de vencimiento cuando se anula el flujo de trabajo."
          },
          "Hint": {
            "$id": "5568",
