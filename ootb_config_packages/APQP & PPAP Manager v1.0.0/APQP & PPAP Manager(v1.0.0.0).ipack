          "Name": "SkipGate2",
          "Span": false,
          "SpellCheck": true,
          "Tooltip": "This option skips the Product Design & Development gate.",
          "UseTypeViewSettings": true
        },
        "LocalizationData": {
          "$id": "4165",
          "Caption": {
            "$id": "4166",
            "fr": "Développement de produits Skip",
            "de": "Skip-Produktentwicklung",
            "en-US": "Skip Product Development",
            "zh": "跳过产品开发",
            "pt": "Desenvolvimento de produtos Skip",
            "es": "Desarrollo de productos de salto"
          },
          "Description": {
            "$id": "4167",
            "fr": "Option pour ignorer le portail de développement de produits Design & où le client ne fait pas n’importe quel travail de conception.",
            "de": "Möglichkeit, das Design & Produktentwicklung Tor zu überspringen, wo der Kunde keine Designarbeit tun.",
            "en-US": "Option to skip the Product Design & Development gate where the customer does not do any design work.",
            "zh": "选择跳过产品设计与开发门在哪里客户不做任何设计工作。",
            "pt": "Opção para saltar o portão de Design e desenvolvimento de produtos onde o cliente não pode fazer qualquer trabalho de design.",
            "es": "Opción para saltar la puerta de diseño y desarrollo de producto donde el cliente no hace ningún trabajo de diseño."
          },
          "Hint": {
            "$id": "4168",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
          "Tooltip": {
            "$id": "4169",
            "fr": "Passe porte 2 (stade de développement de produits Design &) et accumuler le poids de la porte 2",
            "de": "Gate 2 (Produkt Design & Entwicklungsphase) überspringt und reichern sich das Gewicht des Tor 2",
            "en-US": "This option skips the Product Design & Development gate.",
            "zh": "将跳过大门 2 （产品设计与开发阶段），积累的门 2 重量",
            "pt": "Vai pular portão 2 (fase de concepção e desenvolvimento de produto) e acumular o peso do portão 2",
            "es": "Saltará la puerta 2 (etapa de diseño y desarrollo de productos) y acumular el peso de la puerta 2"
          }
        },
        "Id": "1d62980b-03f8-4f9c-996c-e023fd4ca822",
        "Caption": "Skip Product Development",
        "Type": "Field",
