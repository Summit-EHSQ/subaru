            {
              "$id": "1134",
              "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
              "RecordId": "4ed20735-6d62-41a7-9b9b-2cd26bb2a9bf",
              "ObjectName": "SysModuleEntity",
              "FieldData": {
                "$id": "1135",
                "Id": "4ed20735-6d62-41a7-9b9b-2cd26bb2a9bf",
                "Caption": "Action Plans",
                "Description": "The purpose of this application is to create action items. \r\nThe actions can be standalone, can be related to a list of sequential activities, can be assigned from the global level \r\nto the local level or can be generated from a defined template.",
                "Disabled": false,
                "Index": null,
                "IsAvailableForMobile": true,
                "IsAvailableOffline": false,
                "LegacyModuleId": null,
                "MobileCaption": "Action Plans",
                "MobileIcon": "hospital-leaflet",
                "UrlCaption": "ActionPlans",
                "UrlIcon": null,
                "VersionNumber": "1.2.1",
                "VersionOrder": 1002001
              },
              "LocalizationData": {
                "$id": "1136",
                "Caption": {
                  "$id": "1137",
                  "fr": "Plans d’action",
                  "de": "Aktionspläne",
                  "en-US": "Action Plans",
                  "zh": "行动计划",
                  "pt": "Planos de acção",
                  "es": "Planes de acción"
                },
                "Description": {
                  "$id": "1138",
                  "fr": "Cette application vise à créer des éléments de l’action. \nLes actions peuvent être de façon autonome, peuvent être liées à une liste d’activités séquentielles, peuvent être assignées à partir du niveau global au niveau local ou peuvent être générées à partir d’un modèle défini.",
                  "de": "Das Ziel dieses Programms ist die Schaffung Aktionspunkte. \nDie Aktionen können eigenständig werden, können eine Liste von sequenziellen Aktivitäten bezogen werden, können von der globalen Ebene auf die lokale Ebene zugewiesen werden oder aus einer definierten Vorlage generiert werden.",
                  "en-US": "The purpose of this application is to create action items. \r\nThe actions can be standalone, can be related to a list of sequential activities, can be assigned from the global level \r\nto the local level or can be generated from a defined template.",
                  "zh": "此应用程序的目的是创建行动项目。\n操作可以是独立，可以与有关的连续的活动列表，可以从全球一级到地方一级分配或可以从定义的模板生成。",
                  "pt": "O objectivo desta aplicação é criar itens de ação. \nAs ações podem ser autônomos, podem estar relacionadas a uma lista de atividades sequenciais, podem ser atribuídas ao nível global ao nível local ou podem ser geradas a partir de um modelo definido.",
                  "es": "El propósito de esta aplicación es crear elementos de acción. \nLas acciones pueden ser independientes, pueden estar relacionada con una serie de actividades secuenciales, pueden asignarse desde el nivel global a nivel local o pueden generarse a partir de una plantilla definida."
                },
                "MobileCaption": {
                  "$id": "1139",
                  "fr": "Plans d’action",
                  "de": "Aktionspläne",
                  "en-US": "Action Plans",
                  "zh": "行动计划",
                  "pt": "Planos de acção",
                  "es": "Planes de acción"
                }
              },
