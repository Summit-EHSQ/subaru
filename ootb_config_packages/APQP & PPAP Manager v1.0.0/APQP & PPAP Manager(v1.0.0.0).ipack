        "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
        "RecordId": "2d24088a-7d4c-4be0-a57d-b49b01f335b2",
        "ObjectName": "SysModuleEntity",
        "FieldData": {
          "$id": "2751",
          "Id": "2d24088a-7d4c-4be0-a57d-b49b01f335b2",
          "Caption": "Supplier Management Framework",
          "Description": "Allow managing supplier relationships between a parent company and its facilities.\r\nCreate supplier certification and documentation requirements.\r\nRecord corrective and preventative actions for suppliers.",
          "Disabled": false,
          "Index": null,
          "IsAvailableForMobile": false,
          "IsAvailableOffline": false,
          "LegacyModuleId": null,
          "MobileCaption": null,
          "MobileIcon": null,
          "UrlCaption": "SupplierMgmt",
          "UrlIcon": null,
          "VersionNumber": "1.0.0",
          "VersionOrder": 1000000
        },
        "LocalizationData": {
          "$id": "2752",
          "Caption": {
            "$id": "2753",
            "fr": "Cadre de gestion fournisseur",
            "de": "Lieferanten-Management-Framework",
            "en-US": "Supplier Management Framework",
            "zh": "供应商管理框架",
            "pt": "Quadro de gestão do fornecedor",
            "es": "Marco de gestión del proveedor"
          },
          "Description": {
            "$id": "2754",
            "fr": "Permettent de gérer les relations avec les fournisseurs entre une société mère et de ses installations.\nCréer des exigences de certification et de la documentation fournisseur.\nActions correctives et préventives Records pour les fournisseurs.",
            "de": "Verwaltung von Lieferanten-Beziehungen zwischen einer Muttergesellschaft und seine Einrichtungen zu ermöglichen.\nErstellen Sie Lieferant Zertifizierung und Dokumentationsanforderungen.\nRekord korrektive und präventive Maßnahmen für Lieferanten.",
            "en-US": "Allow managing supplier relationships between a parent company and its facilities.\r\nCreate supplier certification and documentation requirements.\r\nRecord corrective and preventative actions for suppliers.",
            "zh": "允许管理供应商的母公司和其设施之间的关系。\n创建供应商认证和文件的要求。\n记录供应商的纠正和预防措施。",
            "pt": "Permita a gestão de relacionamento com os fornecedores entre uma empresa-mãe e as suas instalações.\nCrie fornecedor requisitos de certificação e documentação.\nRegistros ações corretivas e preventivas para fornecedores.",
            "es": "Permite gestionar las relaciones entre una sociedad matriz y sus instalaciones.\nCrear proveedor de certificación y documentación.\nRegistro acciones correctivas y preventivas para los proveedores."
          },
          "MobileCaption": {
            "$id": "2755",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          }
        },
        "Id": "ee40d90e-c564-45a6-b346-39f3a9a8d2d2",
        "Caption": "Supplier Management Framework",
        "Type": "Application",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 2,
        "IsHidden": false
      },
