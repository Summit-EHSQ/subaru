            "LocalizedValues": [
              {
                "$id": "4519",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Alle Aufgaben müssen ausgeführt werden, bevor Sie schließen diesen APQP-Datensatz."
              },
              {
                "$id": "4520",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "关闭此 APQP 记录之前，必须完成所有任务。"
              },
              {
                "$id": "4521",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "All Tasks must be completed before closing this APQP record."
              },
              {
                "$id": "4522",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Todas las tareas deben completarse antes de cerrar este expediente APQP."
              },
              {
                "$id": "4523",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Toutes les tâches doivent être remplis avant de clore cet enregistrement APQP."
              },
              {
                "$id": "4524",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Todas as tarefas devem ser concluídas antes de fechar este registro APQP."
              }
            ]
          },
          {
            "$id": "4525",
