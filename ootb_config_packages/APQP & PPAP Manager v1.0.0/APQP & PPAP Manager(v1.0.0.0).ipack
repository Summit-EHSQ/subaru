        "GraphData": {
          "$id": "2429",
          "Items": [
            {
              "$id": "2430",
              "$type": "Intelex.Business.PackageManagement.Export.DataItems.BusinessObjectPackageItemData, Intelex.Business.PackageManagement",
              "RecordId": "4fc51e86-175b-4784-a566-9ddfe679a214",
              "ObjectName": "DasDashboardEntity",
              "FieldData": {
                "$id": "2431",
                "Id": "4fc51e86-175b-4784-a566-9ddfe679a214",
                "BiDashboardId": 30,
                "Caption": "[A&PM] PPAP Status Dashboard",
                "Description": "This dashboard  helps a project owner quickly assess the status of PPAPs. This includes progress of open PPAPs and open tasks to be completed.",
                "Metadata": "{}"
              },
              "LocalizationData": {
                "$id": "2432",
                "Caption": {
                  "$id": "2433",
                  "fr": "[A & PM] PPAP Status Dashboard",
                  "de": "[A & PM] PPAP-Status-Dashboard",
                  "en-US": "[A&PM] PPAP Status Dashboard",
                  "zh": "[A & PM]PPAP 状态仪表板",
                  "pt": "[A & PM] Painel de Status PPAP",
                  "es": "[A Y PM] Tablero de estado PPAP"
                },
                "Description": {
                  "$id": "2434",
                  "fr": "Ce tableau de bord permet à un maître d’ouvrage d’évaluer rapidement l’état de PPAPs. Cela inclut les progrès des PPAPs ouverts et ouverts tâches restant à accomplir.",
                  "de": "Dieses Dashboard hilft einen Projektbesitzer schnell den Status des PPAPs zu bewerten. Dabei stand der offenen PPAPs und offene Aufgaben abgeschlossen werden.",
                  "en-US": "This dashboard  helps a project owner quickly assess the status of PPAPs. This includes progress of open PPAPs and open tasks to be completed.",
                  "zh": "此仪表板可以帮助快速评估现状，必须在量产前的项目业主。这包括开放必须在量产前和打开任务完成的进度。",
                  "pt": "Este painel de ajuda um dono do projeto avaliar rapidamente o status de PPAPs. Isso inclui o progresso de tarefas abertas e PPAPs abertos para ser concluída.",
                  "es": "Este panel ayuda a un propietario del proyecto a evaluar rápidamente el estado de PPAPs. Esto incluye avances de PPAPs abiertos y abiertas tareas a realizar."
                }
              },
              "Id": "da4244e1-9a82-4921-8bea-2e31c346db34",
              "Caption": "[A&PM] PPAP Status Dashboard",
              "Type": "Dashboard",
              "Version": null,
              "IfExists": 0,
              "IfNotExists": 0,
              "IsHidden": false
            },
