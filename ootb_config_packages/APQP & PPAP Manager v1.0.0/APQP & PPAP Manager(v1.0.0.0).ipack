          {
            "$id": "4511",
            "IsPublished": true,
            "MetaResourceKey": "37fbed24-9800-4d07-b2d2-347080b559cf",
            "DefaultValue": "At least one Lesson Learned must be added before moving to the next gate.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "4512",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "至少一个教训之前，必须添加将移动到下一个关口。"
              },
              {
                "$id": "4513",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Debe agregar al menos una lección aprendida antes de pasar a la siguiente puerta."
              },
              {
                "$id": "4514",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "At least one Lesson Learned must be added before moving to the next gate."
              },
              {
                "$id": "4515",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Au moins une leçon apprise doit être ajoutée avant de passer à la prochaine porte."
              },
              {
                "$id": "4516",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Pelo menos uma lição aprendida deve ser adicionada antes de passar para a próxima porta."
              },
              {
                "$id": "4517",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Mindestens eine Lektion gelernt muss hinzugefügt werden, bevor mit dem nächsten Tor."
              }
            ]
          },
          {
            "$id": "4518",
            "IsPublished": true,
            "MetaResourceKey": "113a3a20-90b8-42e8-a416-9828679379cb",
            "DefaultValue": "All Tasks must be completed before closing this APQP record.",
