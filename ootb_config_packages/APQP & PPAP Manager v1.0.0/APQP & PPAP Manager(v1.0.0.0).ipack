        "FieldData": {
          "$id": "870",
          "Id": "0723078d-3b68-4cf7-b41d-cf21c61690a2",
          "ActionType": 1,
          "Description": "When creating a new revision, if user initially selects \"Initiate Change\" and edits Item Properties fields, then changes their mind and chooses \"Obsolete Item\", whatever changes they have made will be reverted.",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"Name\",\"value\":\"Item.CurrentRevision.Name\"},{\"__type\":\"setvalue\",\"field\":\"Type.Name\",\"value\":\"Item.CurrentRevision.Type.Name\"},{\"__type\":\"setvalue\",\"field\":\"Description\",\"value\":\"Item.CurrentRevision.Description\"},{\"__type\":\"setvalue\",\"field\":\"MeasurementType\",\"value\":\"Item.CurrentRevision.MeasurementType\"},{\"__type\":\"setvalue\",\"field\":\"UnitofMeasure\",\"value\":\"Item.CurrentRevision.UnitofMeasure\"},{\"__type\":\"setvalue\",\"field\":\"Owner\",\"value\":\"Item.CurrentRevision.Owner\"},{\"__type\":\"setvalue\",\"field\":\"ItemSource\",\"value\":\"Item.CurrentRevision.ItemSource\"},{\"__type\":\"setvalue\",\"field\":\"SamplingScheme\",\"value\":\"Item.CurrentRevision.SamplingScheme\"},{\"__type\":\"setvalue\",\"field\":\"Item.Category\",\"value\":\"Item.CurrentRevision.Item.Category\"}],\"else\":[],\"condition\":\"RevisionType.Name=\\\"Obsolete Item\\\"\"}]",
          "Name": "Reset values if Revision Type is Obsolete"
        },
        "LocalizationData": null,
        "Id": "b473294a-dbb6-425d-82c2-12b5525faa70",
        "Caption": "Reset values if Revision Type is Obsolete",
        "Type": "Object Action Handler",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 1,
        "IsHidden": false
      },
