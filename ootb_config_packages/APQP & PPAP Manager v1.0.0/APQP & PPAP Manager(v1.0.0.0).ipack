        "FieldData": {
          "$id": "2067",
          "SuperType": null,
          "Id": "0259a1d3-455a-4ba5-8c4b-dbd3f0be9ea7",
          "CheckChanges": false,
          "ConcurrencyType": null,
          "HasWorkflow": false,
          "IsAbstract": false,
          "IsAttachmentEnabled": false,
          "IsAuditEnabled": false,
          "IsCreationFromMyTaskEnabled": false,
          "IsDataImportEnabled": false,
          "IsDocumentEnabled": false,
          "IsLocalizable": true,
          "IsLocationBound": false,
          "IsMailMergeEnabled": false,
          "IsMapEnabled": false,
          "IsMessageEnabled": false,
          "IsSecurityEnabled": true,
          "LocationFilter": null,
          "MergeType": null,
          "MobileFilter": null,
          "MobileTabOrder": null,
          "ShortName": "ChecklistType",
          "TableName": "cusCLF_ChecklistType",
          "Timeout": null,
          "TimeoutType": null,
          "UseSoftDelete": false,
          "Caption": "Checklist Type",
          "DefaultValue": null,
          "Description": "Checklist Type is meant to group all Questions of a same theme together.\nChecklist are also attached to one Checklist Type.\nBy default, in a Checklist, it is only possible to select Question attached to the same Checklist Type than the Checklist.\nThis filter can be changed without any risks",
          "DetailDisplayAs": null,
          "DetailEditAs": null,
          "DetailEmptyText": null,
          "Icon": "Icons/new/48x48/clipboard_empty.gif",
          "InventoryDisplayAs": null,
          "InventoryEditAs": null,
          "InventoryEmptyText": null,
          "IsStatic": false,
          "IsSystem": false,
          "Name": "CLF_ChecklistTypeObject",
          "NetType": null,
          "UseSystemViewSettings": true
        },
        "LocalizationData": {
          "$id": "2068",
          "Caption": {
            "$id": "2069",
            "fr": "Type de liste de contrôle",
            "de": "Checkliste-Typ",
            "en-US": "Checklist Type",
            "zh": "核对表类型",
            "pt": "Tipo de lista de verificação",
            "es": "Tipo de lista de verificación"
          },
          "Description": {
            "$id": "2070",
            "fr": "Type de liste de contrôle est destinée à regrouper toutes les Questions d’un même thème.\nListe de vérification sont également attachés à un Type de liste de contrôle.\nPar défaut, dans une liste, c’est seulement possible de sélectionner la Question attachée au même Type de liste de contrôle que la liste de contrôle.\nCe filtre peut être modifié sans risque",
            "de": "Checkliste-Typ soll alle Fragen des gleichen Themas zu gruppieren.\nCheckliste sind auch eine Art Checkliste beigefügt.\nStandardmäßig in einer Checkliste kann nur Frage angehängt an denselben Checkliste als die Checkliste auszuwählen.\nDieser Filter kann geändert werden, ohne Risiko",
            "en-US": "Checklist Type is meant to group all Questions of a same theme together.\nChecklist are also attached to one Checklist Type.\nBy default, in a Checklist, it is only possible to select Question attached to the same Checklist Type than the Checklist.\nThis filter can be changed without any risks",
            "zh": "核对表类型是为了组合在一起的相同主题的所有问题。\n检查表也被附加到一个清单类型。\n默认情况下，在一份清单，它是只可以选择附加到同一清单类型比清单的问题。\n此筛选器可以更改没有任何风险",
            "pt": "Tipo de lista de verificação destina-se a agrupar todas as perguntas de um mesmo tema.\nLista de verificação também estão ligados a um tipo de lista de verificação.\nPor padrão, uma lista de verificação, somente é possível selecionar pergunta anexada ao mesmo tipo de lista de verificação do que a lista de verificação.\nEste filtro pode ser alterado sem qualquer risco",
            "es": "Tipo de lista de verificación pretende agrupar a todas las preguntas sobre un mismo tema.\nLista de verificación también se unen a un tipo de lista.\nPor defecto, en una lista, sólo es posible seleccionar pregunta al mismo tipo de lista de verificación de la lista de verificación.\nEste filtro puede cambiarse sin riesgos"
          }
        },
        "Id": "ddad7342-435c-46b4-8e77-2914c1575cf4",
        "Caption": "Checklist Type",
        "Type": "Object",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 2,
        "IsHidden": false
      },
