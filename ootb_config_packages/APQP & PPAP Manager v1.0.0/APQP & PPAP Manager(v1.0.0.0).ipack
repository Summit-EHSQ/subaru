          {
            "$id": "6378",
            "MetaResourceKey": "Field0",
            "DefaultValue": "ONLY required when the task should be integrated with another application. (e.g. PPAP)",
            "VirtualPath": "Hint",
            "LocalizedValues": [
              {
                "$id": "6379",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "只需要时应与其他应用程序集成的任务。(eg。PPAP)"
              },
              {
                "$id": "6380",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Necessário apenas quando a tarefa deve ser integrada com outro aplicativo. (por exemplo. PPAP)"
              },
              {
                "$id": "6381",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "ONLY required when the task should be integrated with another application. (e.g. PPAP)"
              },
              {
                "$id": "6382",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "SÓLO se requiere cuando la tarea debe ser integrada con otra aplicación. (por ejemplo. PPAP)"
              },
              {
                "$id": "6383",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "NUR erforderlich, wenn die Aufgabe mit einer anderen Anwendung integriert werden sollte. (zB. PPAP)"
              },
              {
                "$id": "6384",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "SEULEMENT nécessaire lorsque la fonction devrait être intégrée avec une autre application. (par exemple. PPAP)"
              }
            ]
          },
          {
            "$id": "6385",
            "MetaResourceKey": "Field0",
            "DefaultValue": "Integrate this task with an application defined under System Setup.",
