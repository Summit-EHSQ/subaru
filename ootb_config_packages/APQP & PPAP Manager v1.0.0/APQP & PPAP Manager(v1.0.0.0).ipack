          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:CancelActionLink Override=\"false\" DisplayMode=\"Create\"/><ix:CancelActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/><ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:SecurityActionLink Override=\"true\" Visible=\"false\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"True\" UseDefaultWhenCompleted=\"False\" UseDefaultWhenCancelled=\"False\" VisibleFor=\"Open\" ID=\"StageContainer_d5d8f3\"><ix:DetailSection Title=\"Checklist Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"true\"><ix:Field DisplayAs=\"string\" DisplayMode=\"View, Edit\" For=\"Location\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"View, Edit\" For=\"ActionNo\"/><ix:Field DisplayAs=\"Link\" For=\"Project\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"Create\" For=\"Def\" IsMandatory=\"true\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Phase\" ReadOnly=\"True\"/><ix:Field For=\"Description\" IsMandatory=\"True\" SpellCheck=\"false\" ToolTipText=\"Provides detail on what is required of the person assigned.\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field For=\"PersonResp\" IsMandatory=\"true\" DisplayMode=\"Create,Edit\"/><ix:Field For=\"ProjectRole\" ReadOnly=\"True\"/><ix:Field For=\"Project.ProjectType.Name\" Visible=\"false\"/><ix:Field For=\"PersResponsible.Member\" Visible=\"false\"/><ix:Field For=\"Project:APQP_APQPObject.ProcessOwner\" Visible=\"false\"/><ix:Field For=\"Project:APQP_PPAPAbstractObject.ProjectOwner\" Visible=\"false\"/></ix:FieldArea><% if ((ViewData.Eval(\"ProjectRole\") != n