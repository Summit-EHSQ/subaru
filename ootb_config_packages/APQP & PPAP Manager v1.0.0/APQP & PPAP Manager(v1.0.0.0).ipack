          "ActionType": 2,
          "Description": "Sync Related PPAP Person Responsible (Project Owner) and Due Date when Task Person Responsible and Due Date is Updated",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"RelatedPPAP.SubmissionDate\",\"value\":\"DueDate\"}],\"else\":[],\"condition\":\"AND(ISCHANGED(DueDate), Workflow.WorkflowStatus=\\\"Open\\\")\"},{\"__type\":\"if\",\"then\":[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"RelatedPPAP.ProjectOwnerId\",\"value\":\"PersResponsible.MemberId\\n\"}],\"else\":[],\"condition\":\"AND(PersResponsible<>NULL,PersResponsible.MemberId<>NULL,OR(ISCHANGED(PersResponsible),ISCHANGED(PersResponsible.Member)), Workflow.WorkflowStatus=\\\"Open\\\")\"}],\"else\":[],\"condition\":\"PersResponsible<>NULL\"},{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"RelatedPPAP.ProjectOwnerId\",\"value\":\"PersonRespId\"}],\"else\":[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"RelatedPPAP.ProjectOwnerId\",\"value\":\"Project.Workflow.PersonResponsibleId\"}],\"else\":[],\"condition\":\"AND(PersResponsible<>NULL,PersResponsible.MemberId=NULL,Workflow.WorkflowStatus=\\\"Open\\\")\"}],\"condition\":\"AND(PersResponsible=NULL,PersonResp<>NULL ,ISCHANGED(PersonResp), Workflow.WorkflowStatus=\\\"Open\\\")\"}],\"else\":[],\"condition\":\"RelatedPPAP <> NULL\"}]",
          "Name": "Update Related PPAP Project Owner and Due Date"
        },
        "LocalizationData": null,
