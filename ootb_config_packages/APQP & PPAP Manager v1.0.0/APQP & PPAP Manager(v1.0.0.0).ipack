          "UseTypeViewSettings": true
        },
        "LocalizationData": {
          "$id": "8571",
          "Caption": {
            "$id": "8572",
            "fr": "Liste des catégories de biens/services",
            "de": "Gut/Service-Kategorie-Liste",
            "en-US": "Good/Service Category List",
            "zh": "产品/服务的类别列表",
            "pt": "Lista de categorias de bem/serviço",
            "es": "Lista de categorías de bien o servicio"
          },
          "Description": {
            "$id": "8573",
            "fr": "Catégorie de produit/Service peut avoir des autres catégories de biens/services sous elle. Par exemple, Baked Goods peut avoir de pains et gâteaux sous elle.",
            "de": "Gut/Leistungsart kann andere gut/Service-Kategorien darunter haben. Zum Beispiel können Baked Goods Broten und Kuchen darunter haben.",
            "en-US": "Good/Service category can have other good/service categories underneath it. For example, Baked Goods can have Breads and Cakes underneath it.",
            "zh": "产品/服务的类别可以有其他产品/服务的类别，它的下面。例如，烤的货物可以在它下面有面包和蛋糕。",
            "pt": "Categoria do bem/serviço pode ter outras categorias de bem/serviço por baixo. Por exemplo, bens cozidos pode ter pães e bolos debaixo dela.",
            "es": "Categoría del bien o servicio puede tener otras categorías de bien o servicio por debajo de ella. Por ejemplo, cocido al horno mercancías puede tener panes y pasteles por debajo de ella."
          },
          "Hint": {
