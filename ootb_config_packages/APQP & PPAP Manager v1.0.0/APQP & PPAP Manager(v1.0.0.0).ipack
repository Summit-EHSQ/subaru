        "RecordId": "07193f54-6259-4dd1-a808-4c2dfbf29132",
        "ObjectName": "SysConfigurableViewEntity",
        "FieldData": {
          "$id": "4603",
          "Walkthroughs": null,
          "Id": "07193f54-6259-4dd1-a808-4c2dfbf29132",
          "Caption": null,
          "ConfigurableViewActions": "[]",
          "Content": "<ix:DetailPage><ix:Notice Title=\"Note\" Message=\"When adding tasks, don't forget to choose the gate it should be completed in.\" CanClose=\"true\" DisplayMode=\"edit,view\" meta:resourcekey=\"Notice0\" ResourceKey=\"Notice0\"/><ix:DetailSection Title=\"Project Template Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/article2.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea><ix:Field DisplayMode=\"edit,view\" For=\"RecordNo\"/><ix:Field For=\"Active\" DisplayMode=\"edit,view\" DisplayAs=\"TrueFalseIcon\"/><ix:Field For=\"ProjectType\" Span=\"true\"/><ix:Field For=\"ProjectTempName\" Span=\"true\"/><ix:Field For=\"Description\" Span=\"true\"/></ix:FieldArea></ix:DetailSection><ix:Panel Title=\"Project Task Instructions:\" IsCollapsed=\"true\" DisplayMode=\"edit,view\" meta:resourcekey=\"Panel0\" ResourceKey=\"Panel0\"><p>1. Click \"Select Tasks\" -> Choose the tasks that are applicable to your template -> Click \"Select\".</p><p>2. Assign the tasks you have selected to the \"Gate\" in which they are to be completed in.</p><p>3. Assign \"Task Order\" if you would like the task to appear in a particular order.</p><p>4. Make the Template active and available for use by clicking \"Toggle Active\".</p></ix:Panel><ix:GridSection AllowSorting=\"false\" DisplayMode=\"edit,view\" For=\"ProjectTasks\" HideGroupAddButton=\"true\" DisplayEditColumn=\"false\" ID=\"ProjectTasksGridSection\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" PageSize=\"200\" Title=\"Project Tasks\" meta:resourcekey=\"GridSection0\" ResourceKey=\"GridSection0\"><Actions><ix:MassUpdateAction Caption=\"Assign Gates\" ViewName=\"ProjectFwk_PFWKProjectTask_Detail_MassUpdate\" meta:resourcekey=\"MassUpdateAction0\" ResourceKey=\"MassUpdateAction0\"/></Actions><Menu><ix:GridCreateActionLink Override=\"true\" For=\"ProjTaskDefObj\" Caption=\"Select Tasks\" meta:resourcekey=\"GridCreateActionLink0\" ResourceKey=\"GridCreateActionLink0\"/></Menu><aliases><ix:alias For=\"ProjectTasks.Phase\" Name=\"Phases\"/></aliases><Sorting><ix:Sort By=\"Phase.Order\" Direction=\"Ascending\"/><ix:Sort By=\"Order\" Direction=\"Ascending\"/></Sorting><grouping><ix:Group By=\"Phase\" HeaderCaption=\"Gate\"/></grouping><Columns><ix:TemplateColumn EditMode=\"inline\" For=\"Order\"><Template><div class=\"<%# Container.ViewData.Eval(\"Order\").ToString() != \"\" ? \"\" : \"inlineDiv\"%>\"><%# Container.ViewData.Eval(\"Order\").ToString() != \"\" ? Container.ViewData.Eval(\"Order\") : \"-- Assign Order --\"%></div></Template></ix:TemplateColumn><ix:Column FilterAs=\"Dropdown\" For=\"ProjTaskDefObj.TaskType\"/><ix:Column DisplayAs=\"Truncate\" For=\"ProjTaskDefObj.Description\"/><ix:TemplateColumn EditMode=\"inline\" For=\"Phase\" Caption=\"Gate\" meta:resourcekey=\"TemplateColumn0\" ResourceKey=\"TemplateColumn0\"><Template><div class=\"<%# Container.ViewData.Eval(\"Phase\").ToString() != \"\" ? \"\" : \"inlineDiv\"%>\"><%# Container.ViewData.Eval(\"Phase\").ToString() != \"\" ? Container.ViewData.Eval(\"Phase\") : \"-- Assign Gate --\"%></div></Template></ix:TemplateColumn><ix:Column DisplayAs=\"string\" FilterAs=\"Dropdown\" For=\"ProjTaskDefObj.ProjectRole\"/></Columns></ix:GridSection><style><%= ApplicationSettings.Get(\"APQP_SettingsObject\",\"CustomCSS\",\"\")  %></style></ix:DetailPage>",
          "IsParsedForMobile": false,
          "IsPublic": false,
          "MasterPage": null,
