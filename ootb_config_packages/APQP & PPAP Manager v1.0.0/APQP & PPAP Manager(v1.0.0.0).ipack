          "Id": "d5da1088-aa43-4014-857e-8c50a19e6857",
          "ActionType": 3,
          "Description": "Order must not be changed.",
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"PhaseId\",\"value\":\"FETCHVALUE(\\\"ProjectFwk_PhaseObject\\\", \\\"Id\\\", \\\"Order Ascending\\\", \\\"ProjectTypeId\\\", \\\"=\\\", ProjectTypeId)\"}],\"else\":[],\"condition\":\"AND(Phase=NULL, OR(Workflow=NULL, Workflow.WorkflowStatus=\\\"Open\\\"))\"},{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"Phase\",\"value\":\"GETRELATED(\\\"ProjectFwk_PhaseObject\\\", \\\"ProjectTypeId\\\", ProjectTypeId, \\\"WFStageName\\\", Workflow.CurrentStage.SystemName)\"}],\"else\":[],\"condition\":\"AND(MyCurrentStage<>NULL, ISCHANGED(MyCurrentStage))\"},{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"ProjectTemplate.ProjectTasks.HelpProjUpId\",\"value\":\"Id\"}],\"else\":[],\"condition\":\"AND(Phase<>NULL, ISCHANGED(Phase))\"}]",
          "Name": "Set Phase Field & Task Creation"
        },
        "LocalizationData": null,
