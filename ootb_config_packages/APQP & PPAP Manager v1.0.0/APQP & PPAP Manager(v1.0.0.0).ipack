          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:CancelActionLink Override=\"false\" DisplayMode=\"Create\"/><ix:CancelActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SaveAddNewActionLink Override=\"true\" Visible=\"false\"/><ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"false\"/><ix:CloneActionLink Override=\"true\" Visible=\"false\"/><ix:SecurityActionLink Override=\"true\" Visible=\"false\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/></ix:DetailPageMenuBar><ix:StageContainer UseDefaultDuringCreate=\"True\" UseDefaultWhenCompleted=\"False\" UseDefaultWhenCancelled=\"False\" VisibleFor=\"Open\" ID=\"StageContainer_674624\"><ix:DetailSection Title=\"Task Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"True\"><ix:Field DisplayAs=\"string\" For=\"Location\" ReadOnly=\"True\" DisplayMode=\"View,Edit\"/><ix:Field DisplayMode=\"edit,view\" For=\"ActionNo\" SpellCheck=\"false\"/><ix:Field For=\"Project\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field For=\"TypeOfRecord\" DisplayMode=\"Create\"/><ix:Field DisplayMode=\"View,Edit\" For=\"TypeOfRecord\" Caption=\"Launch Task\" ReadOnly=\"True\" meta:resourcekey=\"Field2\" ResourceKey=\"Field2\"><DisplayTemplate><a class=\"openInPopup\" target=\"_blank\" style=\"font-weight: bold;\" href=\"<%# HttpEnvironment.SystemApplicationPath %>/DefaultView/<%# Container.ViewData.Eval(\"TypeOfRecord.ObjSystemName\") %>/Create?ProjectType=<%# Container.ViewData.Eval(\"TypeOfRecord.ObjSystemName\").ToString().Equals(\"APQP_PPAPAbstractObject\") ? \"a6aa71e1-4202-4d7f-b583-caddd4c87188\" : \"\" %>&amp;RelatedId=<%# Container.ViewData.Eval(\"Id\") %>&amp;RelatedPath=<%# Container.ViewData.Eval(\"TypeOfRecord.RelatedPath\") %>\"><img src=\"<%= ImageHelper.GetVersionedPath(\"Grid/add.png\") %>\"/>Add <%# Container.ViewData.Eval(\"TypeOfRecord.Name\") %></a></DisplayTemplate></ix:Field><ix:Field For=\"RelatedPPAP\" DisplayMode=\"View,Edit\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Phase\" ReadOnly=\"True\"/><ix:Field For=\"Description\" IsMandatory=\"True\" ToolTipText=\"Provides detail on what is required of the person assigned.\" SpellCheck=\"false\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field For=\"PersonResp\" IsMandatory=\"true\" DisplayMode=\"Create,Edit\"/><ix:Field For=\"ProjectRole\" ReadOnly=\"True\"/><ix:Field For=\"Project.ProjectType.Name\" Visible=\"false\"/><ix:Field For=\"PersResponsible.Member\" Visible=\"false\"/><ix:Field For=\"Project:APQP_APQPObject.ProcessOwner\" Visible=\"false\"/><ix:Field For=\"Project:APQP_PPAPAbstractObject.ProjectOwner\" Visible=\"false\"/></ix:FieldArea><% if ((ViewData.Eval(\"ProjectRole\") != null )  && !(ViewData.Eval(\"ProjectRole\").ToString().Equals(\"\")) && (ViewData.Eval(\"PersResponsible\") != null ) && (ViewData.Eval(\"PersResponsible.Member\") == null )) { %>\n<%   if (ViewData.Eval(\"Project.ProjectType.Name\").ToString().Equals(\"APQP\")){ %><ix:FieldArea Span=\"true\"><ix:Field For=\"Project.ProcessOwner\" ID=\"ProcessOwnerView\" Caption=\"Person Responsible\" meta:resourcekey=\"Field4\" ResourceKey=\"Field4\"/></ix:FieldArea><%   } else {%><ix:FieldArea Span=\"true\"><ix:Field For=\"Project.ProjectOwner\" ID=\"ProjectOwnerView\" Caption=\"Person Responsible\" meta:resourcekey=\"Field6\" ResourceKey=\"Field6\"/></ix:FieldArea><%   } %>\n<% } else { %><ix:FieldArea Span=\"true\"><ix:Field For=\"PersonResp\" IsMandatory=\"true\" DisplayMode=\"View\"/><ix:Field For=\"PersResponsible\" IsMandatory=\"true\"/></ix:FieldArea><% } %>\n\n<% if((ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Open\"))) { %><ix:FieldArea Span=\"true\"><ix:Field For=\"DueDate\" SpellCheck=\"false\" IsMandatory=\"True\"/><ix:Field/><ix:Field Visible=\"False\" For=\"Workflow.WorkflowStatus\"/><ix:Field For=\"HelpeTaskExists\"/></ix:FieldArea><% } else { %><ix:FieldArea Span=\"true\"><ix:Field For=\"DueDate\"/><ix:Field Span=\"true\"/></ix:FieldArea><% } %></ix:DetailSection></ix:StageContainer><ix:StageContainer UseDefaultDuringCreate=\"False\" UseDefaultWhenCompleted=\"True\" UseDefaultWhenCancelled=\"True\" ID=\"StageContainer_e5a53b\"><ix:DetailSection Title=\"Task Details\" ModernIcon=\"Raven/Icons/BrightBlue_48/note32.png\" meta:resourcekey=\"DetailSection1\" ResourceKey=\"DetailSection1\"><ix:FieldArea Span=\"True\"><ix:Field DisplayAs=\"string\" For=\"Location\" ReadOnly=\"True\" DisplayMode=\"View,Edit\"/><ix:Field DisplayMode=\"edit,view\" For=\"ActionNo\" SpellCheck=\"false\"/><ix:Field For=\"Project\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"View,Edit\" For=\"TypeOfRecord\" Caption=\"Launch Task\" ReadOnly=\"True\" meta:resourcekey=\"Field3\" ResourceKey=\"Field3\"><DisplayTemplate><a class=\"openInPopup\" target=\"_blank\" style=\"font-weight: bold;\" href=\"<%# HttpEnvironment.SystemApplicationPath %>/DefaultView/<%# Container.ViewData.Eval(\"TypeOfRecord.ObjSystemName\") %>/Create?RelatedId=<%# Container.ViewData.Eval(\"Id\") %>&amp;RelatedPath=<%# Container.ViewData.Eval(\"TypeOfRecord.RelatedPath\") %>\"><img src=\"<%= ImageHelper.GetVersionedPath(\"Grid/add.png\") %>\"/>Add <%# Container.ViewData.Eval(\"TypeOfRecord.Name\") %></a></DisplayTemplate></ix:Field><ix:Field For=\"RelatedPPAP\" DisplayMode=\"View,Edit\" DisplayAs=\"Link\" ReadOnly=\"True\"/><ix:Field DisplayMode=\"Edit,View\" For=\"Phase\" ReadOnly=\"True\"/><ix:Field For=\"Description\" ReadOnly=\"True\" EditReadOnly=\"True\" IsMandatory=\"True\" ToolTipText=\"Provides detail on what is required of the person assigned.\" SpellCheck=\"false\" meta:resourcekey=\"Field0\" ResourceKey=\"Field0\"/><ix:Field For=\"ProjectRole\" ReadOnly=\"True\"/><ix:Field For=\"CompletedBy\" ReadOnly=\"True\"/><ix:Field For=\"RelatedPPAP.Workflow.WorkflowStatus\" SpellCheck=\"false\" Visible=\"false\"/></ix:FieldArea><% if(ViewData.Eval(\"RelatedPPAP\")!=null && (ViewData.Eval(\"RelatedPPAP.Workflow.WorkflowStatus\").ToString().Equals(\"Completed\"))) { %><ix:FieldArea Span=\"true\"><ix:Field For=\"RelatedPPAP.PPAPCompDate\" SpellCheck=\"false\" ReadOnly=\"True\" Caption=\"Completion Date\" meta:resourcekey=\"Field1\" ResourceKey=\"Field1\"/></ix:FieldArea><% } else if(ViewData.Eval(\"RelatedPPAP\")!=null && (ViewData.Eval(\"RelatedPPAP.Workflow.WorkflowStatus\").ToString().Equals(\"Cancelled\"))){ %><ix:FieldArea Span=\"true\"><ix:Field For=\"RelatedPPAP.PPAPRejeDate\" SpellCheck=\"false\" ReadOnly=\"True\" Caption=\"Rejection Date\" meta:resourcekey=\"Field5\" ResourceKey=\"Field5\"/></ix:FieldArea><% } else{ %><ix:FieldArea Span=\"true\"><ix:Field For=\"DueDate\" SpellCheck=\"false\" ReadOnly=\"True\"/></ix:FieldArea><% } %><ix:FieldArea Span=\"true\"><ix:Field/><ix:Field For=\"HelpeTaskExists\"/></ix:FieldArea></ix:DetailSection></ix:StageContainer><style>.redDiv {\nbackground-color: #FA5555;\ncolor: white;\npadding: 5px 2px;\nborder-radius: 2px;\nborder: 1px solid #C84444;\n}\n.orangeDiv {\nbackground-color: orange;\ncolor: #3A3B3C;\npadding: 5px 2px;\nborder-radius: 2px;\nborder: 1px solid #CC8400;\n}\n.greenDiv {\nbackground-color: #9FE1CA;\ncolor: #3A3B3C;\npadding: 5px 2px;\nborder-radius: 2px;\nborder: 1px solid #7FB4A2;\n}\n.yellowDiv {\nbackground-color: #FCFA86;\ncolor: #3A3B3C;\npadding: 5px 2px;\nborder-radius: 2px;\nborder: 1px solid #CAC86B;\n}</style><ix:AttachmentSection ID=\"AttachmentFragmentGridSection\"/></ix:DetailPage>",
