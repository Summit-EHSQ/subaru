          "Description": null,
          "Flow": "[{\"__type\":\"if\",\"then\":[{\"__type\":\"error\",\"message\":\"You cannot change Weighting Assigned or gate activity for a skipped workflow stage.  To make these modifications you must disable 'Skip Product Design Gate'.\"}],\"else\":[],\"condition\":\"AND(OR(ISCHANGED(WeightAssigned),ISCHANGED(Active)), DevelopmeHelper = TRUE, WFStageName=\\\"SecondGate\\\")\"},{\"__type\":\"if\",\"then\":[{\"__type\":\"setvalue\",\"field\":\"WeightAssigned\",\"value\":\"NULL\"},{\"__type\":\"setvalue\",\"field\":\"Active\",\"value\":\"FALSE\"}],\"else\":[],\"condition\":\"AND(ISCHANGED(DevelopmeHelper), DevelopmeHelper = TRUE, WFStageName=\\\"SecondGate\\\")\"}]",
