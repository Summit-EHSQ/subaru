          {
            "$id": "2405",
            "IsPublished": true,
            "MetaResourceKey": "b1fe591c-0085-477a-a3f5-2cd681a3b0e6",
            "DefaultValue": "Please create the Integrated Task.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "2406",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please create the Integrated Task."
              },
              {
                "$id": "2407",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor, crear la tarea integrada."
              },
              {
                "$id": "2408",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "S’il vous plaît, créez la tâche intégrée."
              },
              {
                "$id": "2409",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte erstellen Sie den integrierten Task."
              },
              {
                "$id": "2410",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, crie a tarefa integrada."
              },
              {
                "$id": "2411",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请创建综合任务。"
              }
            ]
          },
          {
            "$id": "2412",
            "IsPublished": true,
            "MetaResourceKey": "4ec95223-65b1-4bac-9cc4-63449b94ca7a",
            "DefaultValue": "Please fill out the 'Completion Notes'.",
            "VirtualPath": "Message",
            "LocalizedValues": [
              {
                "$id": "2413",
                "CultureId": "eb325e45-ebd1-45f3-aa6a-0e0d26e26124",
                "Value": "Please fill out the 'Completion Notes'."
              },
              {
                "$id": "2414",
                "CultureId": "88f1320b-3b63-4600-94c1-1567da534d19",
                "Value": "Por favor llene las notas de la terminación."
              },
              {
                "$id": "2415",
                "CultureId": "0f2a0e1a-d65e-407c-8a48-22179945537a",
                "Value": "Merci de remplir le « Notes d’achèvement »."
              },
              {
                "$id": "2416",
                "CultureId": "75c6b1b7-bead-4854-9602-9c0b1f4b4e27",
                "Value": "Bitte füllen Sie \"Fertigstellung Notes\"."
              },
              {
                "$id": "2417",
                "CultureId": "e8165dbc-d706-46e4-ab73-be71ef90a5c3",
                "Value": "Por favor, preencha as 'notas de conclusão'."
              },
              {
                "$id": "2418",
                "CultureId": "58f936c5-3667-48cf-891b-c216ca2388c5",
                "Value": "请填写 ' 完成笔记 '。"
              }
            ]
          }
        ],
