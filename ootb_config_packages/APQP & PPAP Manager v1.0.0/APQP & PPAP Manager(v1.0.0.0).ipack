      {
        "$id": "6465",
        "$type": "Intelex.Business.PackageManagement.Export.DataItems.MetReferencePropertyPackageItemData, Intelex.Business.PackageManagement",
        "ReverseProperty": {
          "$id": "6466",
          "Id": "064dcf9c-0a3a-47ff-996e-8058f85f8c96",
          "Name": "ItemCategories",
          "Caption": "Goods/Service Categories",
          "Description": "Many goods/services can be linked to a documentation.",
          "IsSystem": false,
          "IsRequired": false,
          "IsAvailableForReporting": true,
          "Span": false,
          "LockRelated": false,
          "AllowPermissionOverride": false,
          "OverrideOrder": 0
        },
        "RelationData": {
          "$id": "6467",
          "Name": "ItemCategory - DocLibrary (m:n) (via cusSupplierMgmt_ItemCategoryDocumentsToSupplierMgmt_DocLibraryMap)",
          "Type": 3,
          "IsMaster": false,
          "IsStatic": false,
          "Description": "",
          "HardDeleteRule": 0,
          "SoftDeleteRule": 0,
          "BaseFieldName": ""
        },
        "CalculationDependencies": null,
        "RequiresUomSystemProperties": false,
        "RecordId": "7da06fbd-6350-48ff-9c78-b303996bcd17",
        "ObjectName": "MetReferencePropertyEntity",
        "FieldData": {
          "$id": "6468",
          "Id": "7da06fbd-6350-48ff-9c78-b303996bcd17",
          "AllowPermissionOverride": false,
          "BypassSecurity": false,
          "FilterExpression": null,
          "FilterType": 0,
          "IsStartOfRelation": true,
          "LockRelated": false,
          "OverrideOrder": 0,
          "Calculation": null,
          "Caption": "Documents",
          "Category": null,
          "DefaultValue": "",
          "Description": "A relation can be made to documentations to indicate which documentations are a requirement for goods/services belonging to this category. For example, documents such as product guarantee need to be linked to particular types of goods/services.",
          "DetailDisplayAs": null,
          "DetailEditAs": null,
          "DetailEmptyText": null,
          "Hint": null,
          "InventoryDisplayAs": null,
          "InventoryEditAs": null,
          "InventoryEmptyText": null,
          "IsAvailableForReporting": true,
          "IsPrimaryKey": false,
          "IsProtected": false,
          "IsReadOnly": false,
          "IsRequired": false,
          "IsStatic": false,
          "IsSystem": false,
          "Name": "Documents",
          "Span": false,
          "SpellCheck": true,
          "Tooltip": null,
          "UseTypeViewSettings": true
        },
        "LocalizationData": {
          "$id": "6469",
          "Caption": {
            "$id": "6470",
            "fr": "Documents",
            "de": "Dokumente",
            "en-US": "Documents",
            "zh": "文件",
            "pt": "Documentos",
            "es": "Documentos"
          },
          "Description": {
            "$id": "6471",
            "fr": "Une relation est possible aux documentations pour indiquer quelles documentations sont une exigence pour les marchandises et services appartenant à cette catégorie. Par exemple, documents comme la garantie du produit doivent être liés à des types particuliers de marchandises/services.",
            "de": "Eine Beziehung kann zu Dokumentationen erfolgen, um anzugeben, welche Dokumentationen sind eine Voraussetzung für Waren/Dienstleistungen, die zu dieser Kategorie gehören. Beispielsweise müssen Unterlagen wie Produktgarantie für bestimmte Arten von Waren/Dienstleistungen verknüpft werden.",
            "en-US": "A relation can be made to documentations to indicate which documentations are a requirement for goods/services belonging to this category. For example, documents such as product guarantee need to be linked to particular types of goods/services.",
            "zh": "关系可以向文件，以指示哪些文件是属于这一类的物品或服务的必要条件。例如，如产品保证文件需要链接到特定类型的货物或服务。",
            "pt": "Uma relação pode ser feita a documentações para indicar quais documentações são um requisito para produtos e serviços que pertencem a esta categoria. Por exemplo, documentos, como garantia de produto precisam estar vinculado a tipos especiais de produtos e serviços.",
            "es": "Una relación se puede hacer en documentaciones para indicar que documentación es un requisito para pertenecer a esta categoría de bienes y servicios. Por ejemplo, documentos como garantía del producto deban vincularse a determinados tipos de bienes y servicios."
          },
          "Hint": {
            "$id": "6472",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          },
          "Tooltip": {
            "$id": "6473",
            "fr": "",
            "de": "",
            "en-US": "",
            "zh": "",
            "pt": "",
            "es": ""
          }
        },
        "Id": "651c70d7-4cdc-437e-842e-8f969eb04c29",
        "Caption": "Documents",
        "Type": "Field",
        "Version": null,
        "IfExists": 1,
        "IfNotExists": 1,
        "IsHidden": false
      },
