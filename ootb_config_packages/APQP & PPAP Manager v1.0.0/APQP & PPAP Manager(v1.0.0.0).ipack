          "Description": "Reports included are:\n- PPAP Progress by Part Number\n- PPAP Status by Task\n- PPAP Progress by Customer\n- PPAP by Gate\n- PPAP by Customer",
          "IsSourceReport": false,
          "UnderlyingDataIsActive": false
        },
        "LocalizationData": {
          "$id": "258",
          "Caption": {
            "$id": "259",
            "fr": "[A & PM] Rapports PPAP",
            "de": "[A & PM] PPAP Berichte",
            "en-US": "[A&PM] PPAP Reports",
            "zh": "[A & PM]PPAP 报告",
            "pt": "[A & PM] Relatórios PPAP",
            "es": "[A Y PM] Informes PPAP"
          },
          "Description": {
            "$id": "260",
            "fr": "Les rapports inclus sont : PPAP - PPAP Progress par numéro de pièce - PPAP statut de tâche - PPAP progrès par client - PPAP par porte - par le client",
            "de": "Berichte enthalten sind: - PPAP Fortschritt durch Teilenummer - PPAP Status von Task - PPAP Fortschritt durch Kunden - PPAP durch Tor - PPAP durch Kunden",
            "en-US": "Reports included are:\n- PPAP Progress by Part Number\n- PPAP Status by Task\n- PPAP Progress by Customer\n- PPAP by Gate\n- PPAP by Customer",
            "zh": "报告包括:-PPAP 客户-PPAP 由门部件号-PPAP 状态由任务-PPAP 方面取得的进展方面取得进展-PPAP 的客户",
            "pt": "Relatórios incluídos são: - PPAP progresso pelo progresso de PPAP Part Number - PPAP Status de tarefa - pelo cliente - PPAP pelo portão - PPAP pelo cliente",
            "es": "Informes incluidos son: - progreso de PPAP por número de parte - estatus del PPAP por tarea - PPAP progreso por cliente - PPAP por puerta - PPAP por cliente"
          }
        },
        "Id": "cf1ad344-b1d1-406f-8d2b-e5395f63d651",
