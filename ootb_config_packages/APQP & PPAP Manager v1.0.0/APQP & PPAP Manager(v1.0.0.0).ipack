chmentName\" Type=\"EndsWith\"><ix:Value>.gif</ix:Value></ix:LikePredicate></ix:Filter></Filters><aliases><ix:Alias For=\"Id\"/><ix:Alias For=\"AttachmentName\"/></aliases><columns><ix:TemplateColumn><template><div class=\"imagepreview\" title=\"<%# Container.ViewData.Eval(\"AttachmentName\") %>\" style=\"background-image:url('<%= HttpEnvironment.SystemApplicationPath %>/intelexforms/attachmentsection/downloadfile?recordid=<%# Container.ViewData.Eval(\"Id\") %>')\"/></template></ix:TemplateColumn></columns></ix:GridPanel></ix:Tab></ix:TabsSection></ix:DetailPage><style>.HideBorders > .header {\n    display: none;\n}\n\n.HideBorders > .footer {\n    display: none;\n}\n\n.HideBorders > .content {\n    border: medium none;\n    padding: 0;\n}\n\n.imagepreview {\nbackground-repeat:no-repeat;\nmax-width:500px;\nmin-height:300px;\nbackground-size:contain;\n}</style>",
