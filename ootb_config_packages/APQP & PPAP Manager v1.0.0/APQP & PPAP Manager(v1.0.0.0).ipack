          "Content": "<ix:DetailPage ShowEditReadOnlyLink=\"True\"><ix:DetailPageMenuBar ID=\"DetailPageMenuBar\"><ix:SaveAddNewActionLink Override=\"true\" Visible=\"False\"/><ix:AddEntryActionLink Override=\"true\" Visible=\"false\"/><ix:SaveActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SaveExitActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:CancelActionLink Override=\"true\" DisplayMode=\"Edit\"/><ix:SpellCheckActionLink Override=\"true\" Visible=\"False\"/><ix:SaveActionLink Override=\"false\" DisplayMode=\"Create\" Caption=\"Continue\" meta:resourcekey=\"SaveActionLink0\" ResourceKey=\"SaveActionLink0\"/><ix:CloneActionLink Override=\"true\" Visible=\"False\"/><ix:CancelActionLink Override=\"false\" DisplayMode=\"Create\"/></ix:DetailPageMenuBar><div class=\"wfDiagram\"><div><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"0\")||( ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"Draft\")) ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Draft%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"InProgress\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, In Progress%>\"/></div></div><div><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"InReview\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, In Review%>\"/></div></div><div style=\"display:<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"InterimApproval\") ? \"\" : \"\" %>;\"><div Selected=\"<%= ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"InterimApproval\") ? \"blue\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Interim Approval%>\"/></div></div><div style=\"display:<%= (ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"0\")||( ViewData.Eval(\"Workflow.CurrentStage.SystemName\") != null && ViewData.Eval(\"Workflow.CurrentStage.SystemName\").ToString().Equals(\"Draft\")))|| (ViewData.Eval(\"Workflow.WorkflowStatus\") != null &&( ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\" ) || ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Open\") ))? \"\" : \"none\" %>;\"><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Completed\") ? \"Green\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Approved%>\"/></div></div><div style=\"display:<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Cancelled\") ? \"\" : \"none\" %>;\"><div Selected=\"<%= ViewData.Eval(\"Workflow.WorkflowStatus\") != null && ViewData.Eval(\"Workflow.WorkflowStatus\").ToString().Equals(\"Cancelled\") ? \"Red\" : \"\" %>\"><asp:literal runat=\"server\" text=\"<%$Resources:Javascript, Rejected%>\"/></div></div></div><ix:DetailSection Title=\"PPAP Details\" Id=\"HiddenDetail\" meta:resourcekey=\"DetailSection0\" ResourceKey=\"DetailSection0\"><ix:FieldArea Span=\"True\"><ix:Field For=\"WorkFlow.WorkflowStatus\" Visible=\"False\"/><ix:Field For=\"WorkFlow.CurrentStage.SystemName\" Visible=\"False\"/><ix:Field For=\"Settings.EnableCARPPAP\"/><ix:Field For=\"DimensionHelper\"/><ix:Field For=\"MaterialHelper\"/><ix:Field For=\"AppearanHelper\"/><ix:Field For=\"StatisHelper\"/><ix:Field For=\"PPAPRejeDate\"/></ix:FieldArea></ix:DetailSection><ix:DetailSection Title=\"PPAP Details\" Icon=\"Icons/new/48x48/magic-